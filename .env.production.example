# Production settings for the VPS deployment.
#
# Copy to `.env.production` ON THE SERVER and fill in. That file is gitignored
# and must never be committed — it holds every secret in the system.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# ★ `docker-compose.prod.yml` reads this file twice, for two different purposes,
# and the difference matters:
#
#   1. Compose itself interpolates `${WEB_DOMAIN}`, `${POSTGRES_PASSWORD}` and
#      the rest while building the config — those must be here.
#   2. The `api` service gets the whole file as `env_file`, so everything below
#      also reaches the application.
#
# A few values are set in the compose file instead and deliberately absent here
# — `DATABASE_URL`, `REDIS_URL`, `STORAGE_ENDPOINT`. They are derived from the
# service names on the compose network, and a copied-in localhost URL that
# survived into production is a class of outage worth designing out.

# ─── Domains ────────────────────────────────────────────────────────────────
#
# ★★ All three MUST be subdomains of one registrable domain. `docs/SECURITY.md`
# §3 depends on the web app and the API being same-site: it is what makes
# `SameSite=Lax` work and what lets the browser's own CSRF defence apply.
# Splitting them across two domains forces `SameSite=None` and weakens every
# session in the product.
#
# Point all three at the VPS with A records before the first deploy — Caddy
# cannot obtain a certificate for a name that does not resolve to it.
WEB_DOMAIN=nomadkids.mn
API_DOMAIN=api.nomadkids.mn
MEDIA_DOMAIN=media.nomadkids.mn

# Where Let's Encrypt sends expiry warnings. Set it to a mailbox somebody reads:
# it is the only place a failing renewal announces itself before the site goes
# down.
ACME_EMAIL=

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# Exactly the web origin, nothing else. `loadEnv()` refuses a localhost or
# plaintext origin in production.
CORS_ORIGINS=https://nomadkids.mn

# ★ Empty on purpose. The cookie is issued by the API host and only needs to
# return there; a host-only cookie does that because the two are same-site.
# Setting `Domain=.nomadkids.mn` would hand the session to every present and
# future subdomain for no benefit — docs/SECURITY.md §3.1.
COOKIE_DOMAIN=

# ★★ Two DIFFERENT secrets. `loadEnv()` refuses to boot if they match, because
# a refresh token that verifies as an access token defeats the whole point of
# having two.
#
#   openssl rand -base64 48
JWT_SECRET=
REFRESH_SECRET=

# ─── Database ───────────────────────────────────────────────────────────────
#
# The compose file builds DATABASE_URL from these. Postgres is not published to
# the host, so this password guards the compose network rather than the
# internet — which is not a reason to make it weak.
#
#   openssl rand -base64 32
POSTGRES_USER=kinder
POSTGRES_PASSWORD=
POSTGRES_DB=kinder

# ─── Object storage — MinIO on this server ──────────────────────────────────
#
# ★ These are MinIO's root credentials. They are the S3 access key the API
# signs with AND the console login, so treat them as a root password.
#
#   openssl rand -base64 32
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=kinder-media
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true

# Seconds a presigned download link stays valid. Five minutes is long enough to
# open a PDF and short enough that a leaked URL is not a standing grant.
STORAGE_PRESIGN_TTL=300

# ─── Reports ────────────────────────────────────────────────────────────────
#
# The API runs the report worker in-process. On a single VPS that is right: a
# separate worker container would double the Chromium memory floor for a
# kindergarten that renders a handful of PDFs a day.
REPORTS_WORKER_ENABLED=true

# ─── Mail ───────────────────────────────────────────────────────────────────
#
# Optional as a set. Without it, invitations and password resets still issue —
# an administrator hands the link over instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ─── QPay ───────────────────────────────────────────────────────────────────
#
# All five or none: `loadEnv()` refuses a half-configured set in production,
# because half-configured looks configured and then fails when a parent tries
# to pay.
#
# ★ QPAY_CALLBACK_URL must match API_DOMAIN above, and QPay must be told this
# address — they will not call a hostname they do not have.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=https://api.nomadkids.mn/v1/payments/qpay/callback
QPAY_TIMEOUT_MS=15000

# ─── ESIS ───────────────────────────────────────────────────────────────────
#
# Empty until БМТТ issues a token (журам А/465 §3.7 — after the data-exchange
# contract). Every feature works without it; only the integration boundary
# reports itself unconfigured. See docs/ESIS_REQUEST.md.
ESIS_BASE_URL=
ESIS_TOKEN=
ESIS_INSTITUTION_ID=
ESIS_TIMEOUT_MS=15000

# ─── Backups ────────────────────────────────────────────────────────────────
#
# ★★★ Where `scripts/backup.sh` ships a copy OFF this machine.
#
# Leave it empty and the backup still runs — but it lands on the same disk as
# the data it is protecting, which survives an accidental DELETE and nothing
# else. A dead disk, a lost datacentre or an unpaid invoice takes both.
#
# Any rclone remote: S3, Backblaze B2, Google Drive, another server.
#   rclone config          # once, interactively
#   BACKUP_REMOTE=b2:nomadkids-backups
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
