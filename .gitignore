node_modules/
.env
.env.local
.DS_Store

# Claude Code's own local session/tool state — permission allowlists and a
# scheduled-tasks lock file, both machine-specific, neither application code.
.claude/

# Next.js / Nest build output (once the apps exist)
.next/
dist/
build/
*.tsbuildinfo

# Regenerated by Next on every dev/build, and its contents differ between the
# two (`.next/types` vs `.next/dev/types`). Tracking it means a spurious diff
# after any local run.
next-env.d.ts

# Spike artefacts — scripts and inputs are tracked, generated PDFs are not.
# The fonts ARE tracked: the Dockerfile copies them in, so a fresh clone must be
# able to build the image. They are SIL OFL and redistributable — see
# docs/spikes/pdf/fonts/README.md.
docs/spikes/pdf/out/

# Generated by `prisma generate` — regenerated from prisma/schema.prisma,
# never edited by hand, never committed.
apps/api/src/generated/
.vercel
.env*

# ★ The examples ARE tracked. `.env.example` predates the `.env*` rule above and
# survives only because git keeps tracking what it already knows — a new example
# file would be silently ignored, which is how a template for production
# secrets ends up existing on one laptop and nowhere else.
!.env.example
!.env.production.example

# Local object storage, for a machine running MinIO without Docker.
# See scripts/storage-dev.sh — the bytes are uploads, not source.
.minio-data/
