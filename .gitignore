.env
.env.local
.DS_Store

# Next.js / Nest build output (once the apps exist)
.next/
dist/
build/
*.tsbuildinfo

# Regenerated by Next on every dev/build, and its contents differ between the
# two (`.next/types` vs `.next/dev/types`). Tracking it means a spurious diff
# after any local run.
next-env.d.ts

# Spike artefacts — scripts and inputs are tracked, generated PDFs are not.
# The fonts ARE tracked: the Dockerfile copies them in, so a fresh clone must be
# able to build the image. They are SIL OFL and redistributable — see
# docs/spikes/pdf/fonts/README.md.
docs/spikes/pdf/out/

# Generated by `prisma generate` — regenerated from prisma/schema.prisma,
# never edited by hand, never committed.
apps/api/src/generated/
