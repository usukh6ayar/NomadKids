# Copy to .env and fill in. .env is gitignored — CLAUDE.md §1.5.
# Every new setting added to the code gets a line here, or the next person
# cannot start the project.

NODE_ENV=development

# --- API ---------------------------------------------------------------
PORT=3001
# Comma-separated exact origins. Never "*", never a wildcard pattern.
# Production: https://nomadkids.mn
CORS_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql://kinder:kinder@localhost:5434/kinder

# ⚠ The integration suite TRUNCATEs every table between test cases. Point it at
# its own database or `pnpm test` empties the one above — including whatever
# `seed:demo` just put there, silently, every single run.
#
# Create it once:
#   pnpm --filter @kinder/api test:db:setup
#
# Optional. CI leaves it unset because its DATABASE_URL is already a throwaway
# service container; `test/setup.ts` warns when that is the case.
TEST_DATABASE_URL=postgresql://kinder:kinder@localhost:5434/kinder_test

# Only needed to GENERATE a migration (`prisma migrate diff`), never to apply
# one. ⚠ Prisma drops and recreates this database on every use — never point it
# at anything you care about.
SHADOW_DATABASE_URL=postgresql://kinder:kinder@localhost:5434/kinder_shadow

# --- Redis (BullMQ) ----------------------------------------------------
REDIS_URL=redis://localhost:6380

# Whether THIS instance consumes the report queue and renders PDFs. Leave true
# for a single-container deployment; set false on API instances once report
# generation moves to its own worker. docs/PDF_SPIKE.md §3.
REPORTS_WORKER_ENABLED=true

# --- Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-48-byte-random-value
REFRESH_SECRET=replace-me-with-a-different-48-byte-random-value
# Leave EMPTY — including in production. nomadkids.mn and api.nomadkids.mn
# share a registrable domain, so a host-only cookie is already sent on the web
# app's credentialed requests. Setting a Domain would only widen the cookie to
# every subdomain. docs/SECURITY.md §3.1.
COOKIE_DOMAIN=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Object storage (S3-compatible: MinIO locally, R2 in production) ----
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_REGION=auto
STORAGE_BUCKET=kinder-media
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# Presigned URL lifetime in seconds. Short by design — docs/SECURITY.md §7.
STORAGE_PRESIGN_TTL=300

# --- Web ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# The object-storage origin, for the Content-Security-Policy only.
#
# `GET /v1/media/:id` redirects to a presigned URL on this host, and CSP is
# enforced against the URL the browser finally fetches — so without it every
# photo in the product is blocked by `img-src`. Same value as STORAGE_ENDPOINT
# locally; in production, the R2 S3 endpoint the presigned URLs are issued on.
NEXT_PUBLIC_MEDIA_URL=http://localhost:9002

# --- Web app origin ---------------------------------------------------
# Used to build the password-reset link. One origin, not a list: a link has to
# name exactly one, and picking the first of CORS_ORIGINS would be a guess.
WEB_ORIGIN=http://localhost:3000

# --- Email (password reset only) --------------------------------------
# Optional as a SET. Leave all of it empty and the API still issues valid reset
# tokens — it simply cannot deliver them, and /health/readiness reports that
# honestly. Half-configured (host without from-address, or vice versa) is
# refused at boot in production, because it looks configured and fails only
# when a parent needs it.
#
# Port 465 = implicit TLS. Port 587 = STARTTLS. Getting this backwards produces
# a connection that hangs rather than an error.
# Fill all of these together, or none. Example MAIL_FROM:
#   MAIL_FROM=NomadKids <noreply@nomadkids.mn>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- ESIS (ministry education information system) ----------------------
# Optional as a SET, like SMTP above. Leave all of it empty and every existing
# feature works unchanged; only the ESIS boundary reports itself unconfigured.
# Half-configured is refused at boot in production, because it looks configured
# and then fails as an authentication error from the ministry rather than as
# our own missing setting.
#
# ★ ESIS_TOKEN is a credential. It is read only by the API, never sent to the
# browser, never logged, and deliberately NOT prefixed NEXT_PUBLIC_. The base
# URL must be https in production — the token crosses it on every request.
#
# No real endpoint is called yet: the integration boundary exists, but nothing
# in the app consumes it. See apps/api/src/integrations/esis/.
ESIS_BASE_URL=
ESIS_TOKEN=
ESIS_INSTITUTION_ID=
# Milliseconds. A ministry endpoint that stops answering must not hold our
# requests open until the platform proxy gives up.
ESIS_TIMEOUT_MS=15000

# --- QPay (parent payments) --------------------------------------------
# Optional as a SET, exactly like ESIS and SMTP above: leave it all empty and
# invoicing still works — an accountant records cash and bank transfers by
# hand. Only the online-payment path reports itself unconfigured.
#
# ★ QPAY_PASSWORD is a credential and QPAY_USERNAME is close to one. Both are
# read only by the API, never logged, never sent to the browser, and
# deliberately NOT prefixed NEXT_PUBLIC_. The client secret QPay issued for
# this merchant belongs in the deployment's own environment and nowhere in
# this repository.
#
# Credentials arrive by email from QPay after the merchant contract; the auth
# endpoint below returns a short-lived token that must be re-fetched rather
# than cached past its expiry.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
# The invoice code QPay assigns to the merchant. Not a secret, but it differs
# per environment, so it is configuration rather than a constant in source.
QPAY_INVOICE_CODE=
# Where QPay calls back after a successful payment. Must be publicly reachable
# and https — the callback carries a payment id we then verify against QPay's
# own API before crediting anything (нэмэлт.md §8).
QPAY_CALLBACK_URL=
# Milliseconds. A payment provider that stops answering must not hold our
# requests open until the platform proxy gives up.
QPAY_TIMEOUT_MS=15000
