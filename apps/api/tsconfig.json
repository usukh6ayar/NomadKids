{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS runs CommonJS and its dependency injection reads types emitted by
    // emitDecoratorMetadata. Both are required; neither is negotiable.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "types": ["node"],

    // Nest's DI containers and Express handlers are typed loosely enough that
    // this rule fires constantly without catching real defects here.
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
