// Бяцхан Нүүдэлчид — MVP data model.
//
// Designed in docs/DATABASE.md; that document explains the reasoning and this
// file is its implementation. Where they disagree, the document is the intent
// and this file is the bug.
//
// Three conventions run through everything and matter more than they look:
//
//   1. `kindergartenId` is denormalised onto every tenant-scoped table even
//      where a relation could reach it. One WHERE clause then enforces tenant
//      isolation instead of a three-join traversal somebody eventually forgets.
//
//   2. `deletedAt` is a soft delete. Prisma has no equivalent of Django's
//      model manager, so EVERY query must filter it explicitly. That is why
//      `PrismaClient` is importable only from *.repository.ts — CLAUDE.md §2.2.
//
//   3. Authorization NEVER reads `Child.kindergartenId`. It resolves the
//      kindergarten set from Enrollment history, with exactly one documented
//      exception for a child that has no enrollments at all.
//      docs/SECURITY.md §5.2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — system-level values only.
//
// Anything an administrator can edit is a TABLE, not an enum: development
// domains, assessment levels and observation types are configuration and live
// in DevelopmentDomain / AssessmentLevel / ObservationType. Adding a value to
// one of the enums below is a code change by design.
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  PARENT
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  INVITATION
}

enum AgeBand {
  NURSERY // Бага бүлэг
  JUNIOR // Дунд бүлэг
  MIDDLE // Ахлах бүлэг
  SENIOR // Бэлтгэл бүлэг
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum TeacherRole {
  LEAD
  ASSISTANT
}

enum Sex {
  MALE
  FEMALE
}

enum ChildStatus {
  ACTIVE
  ARCHIVED
}

enum GuardianRelation {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
  TRANSFERRED
  /** A distinct outcome from ENDED/TRANSFERRED — the child completed the
   * programme rather than leaving mid-way or moving elsewhere. Added so a
   * parent-facing "Цэцэрлэгээс төгссөн" date can be real data instead of a
   * misleading reuse of the generic "this enrollment period ended". */
  GRADUATED
}

enum ObservationSource {
  TEACHER
  PARENT
}

/// §5.4 — the teacher reviews what a parent submits.
///
/// A teacher's own observation is APPROVED on save: there is nobody above them
/// to approve it. There is deliberately no "not required" state — the parent
/// read filter is `visibleToParents AND APPROVED`, so a teacher observation in
/// any other state would be invisible to the family it was written for.
enum ReviewStatus {
  PENDING // parent-submitted, awaiting a teacher
  APPROVED
  RETURNED // teacher returned it with a note
}

enum MediaPurpose {
  CHILD_PHOTO
  OBSERVATION
  /// A photo on a class-board announcement. Not about one child, so the row
  /// carries no `childId` — the kindergarten scope is what protects it.
  NOTIFICATION
  REPORT_OUTPUT
  /// ★ Tenant-scoped images: a kindergarten's logo, a teacher's portrait, a
  /// group's class photo. Like NOTIFICATION they carry no `childId`, so the
  /// kindergarten scope is the only thing protecting them — and unlike the
  /// others they are not child data at all, which is why `MediaService`
  /// authorises them by membership rather than through `canAccessChild`.
  KINDERGARTEN_LOGO
  USER_PHOTO
  GROUP_PHOTO
  /// A PDF in the document library, and its cover image — RFP §9. Tenant
  /// material, not child data, so membership authorises them.
  DOCUMENT
  DOCUMENT_COVER
  /// A photograph on a safety incident — RFP Module 2.1. Child data carrying
  /// `childId`, so `canAccessChild` governs it like an album photo.
  INCIDENT
  /// A photograph of a remembered first — RFP §4.5. Child data, so it is
  /// authorised through `canAccessChild` exactly like an album photo, and it
  /// deliberately does NOT join the tenant-image set above.
  MILESTONE
}

/// Who a photograph came from — RFP §4.4, "багшийн, эцэг эхийн эсвэл хамтын".
///
/// Distinct from `uploadedById`, which records *which account* sent the bytes.
/// A teacher may upload a photograph a family brought in on a memory stick; the
/// attribution is PARENT and the uploader is the teacher.
enum MediaAttribution {
  TEACHER
  PARENT
  JOINT
}

enum MediaStatus {
  READY
  ARCHIVED
}

enum NotificationStatus {
  DRAFT
  PUBLISHED
}

enum TermReportStatus {
  DRAFT
  FINAL
}

enum ReportType {
  CHILD_PORTFOLIO
  TERM_REPORT
  /// RFP §6.5 — the year's four terms compared, with per-domain progress and
  /// the teacher's closing judgement. §10.2 names seven report types; this is
  /// the third, and the one RFP §21.7 makes an acceptance criterion
  /// ("Улирлын болон нэгдсэн PDF тайлан зөв үүсдэг байх").
  ANNUAL_REPORT
}

enum ReportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  VIEW
  CREATE
  UPDATE
  DELETE
  RESTORE
  DOWNLOAD
  PERMISSION_CHANGE
  PASSWORD_RESET
  INVITE
  ACTIVATE
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity and access
// ─────────────────────────────────────────────────────────────────────────────

/// One login. Deliberately carries NO role column — the same person can be a
/// teacher in one kindergarten and a parent in another, so all authority comes
/// from Membership.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  email        String? @unique
  phone        String? @unique
  passwordHash String

  lastName  String
  firstName String

  /// Teacher-facing profile fields. Flattened from the reference system's
  /// near-empty TeacherProfile/GuardianProfile side tables.
  specialization String?
  education      String?
  bio            String?

  /// RFP §3.3 — профайл зураг. A MediaFile reference for the same reason as
  /// `Kindergarten.logoMediaFileId`.
  photoMediaFileId String? @unique @db.Uuid

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Platform-level operator: registers kindergartens.
  ///
  /// ★ Deliberately NOT a Membership role. Every authorization primitive in
  /// this system is tenant-derived, and a system-wide membership row has no
  /// kindergarten to point at — the reference implementation made
  /// `kindergarten` nullable to model it, which would put a null case into
  /// every `kindergartenId: { in: [...] }` filter we have. CLAUDE.md §3.1.
  ///
  /// Grants platform routes and nothing else. It is not consulted by
  /// TenantAccessService or ChildAccessService, and test/platform.test.ts
  /// asserts that a superadmin still gets 404 on child data.
  isSuperAdmin Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photo                 MediaFile?                @relation("UserPhoto", fields: [photoMediaFileId], references: [id], onDelete: SetNull)
  uploadedMedia         MediaFile[]               @relation("MediaUploader")
  memberships           Membership[]
  guardianships         Guardianship[]
  authTokens            AuthToken[]
  sessions              Session[]
  auditLogs             AuditLog[]
  observations          Observation[]             @relation("ObservationAuthor")
  reviewed              Observation[]             @relation("ObservationReviewer")
  assessments           Assessment[]              @relation("AssessmentAuthor")
  termReports           TermReport[]              @relation("TermReportAuthor")
  notifications         Notification[]            @relation("NotificationAuthor")
  reads                 NotificationRead[]
  reactions             NotificationReaction[]
  reportJobs            ReportJob[]
  attendanceRecorded    Attendance[]              @relation("AttendanceRecordedBy")
  attendanceRequested   AttendanceRequest[]       @relation("AttendanceRequestedBy")
  attendanceReviewed    AttendanceRequest[]       @relation("AttendanceReviewedBy")
  menuDaysCreated       MenuDay[]                 @relation("MenuDayCreatedBy")
  surveysCreated        Survey[]                  @relation("SurveyCreatedBy")
  surveyResponses       SurveyResponse[]          @relation("SurveyRespondent")
  growthRecorded        GrowthMeasurement[]       @relation("GrowthRecordedBy")
  milestonesRecorded    Milestone[]               @relation("MilestoneRecordedBy")
  allergiesRecorded     AllergyRecord[]           @relation("AllergyRecordedBy")
  medicationsAuthorised MedicationAuthorisation[] @relation("MedicationAuthorisedBy")
  vaccinationsRecorded  VaccinationRecord[]       @relation("VaccinationRecordedBy")
  incidentsRecorded     SafetyIncident[]          @relation("IncidentRecordedBy")
  artworkComparisons    ArtworkComparison[]       @relation("ComparisonAuthor")
  documentsPublished    Document[]                @relation("DocumentPublishedBy")
  documentBookmarks     DocumentBookmark[]        @relation("DocumentBookmarkUser")
  consentsDecided       ConsentRecord[]           @relation("ConsentDecidedBy")
  mealsRecorded         MealRecord[]              @relation("MealRecordedBy")

  @@index([deletedAt])
  @@map("users")
}

/// ★ The only source of authority in the system.
///
/// A user's role is not global; it is held per kindergarten. Every
/// authorization decision starts here.
model Membership {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  kindergartenId String  @db.Uuid
  role           Role
  /// Revocation without deletion — the record of the relationship survives.
  isActive       Boolean @default(true)

  startedOn DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  assignments  GroupTeacher[]

  @@unique([userId, kindergartenId, role])
  @@index([userId, isActive])
  @@index([kindergartenId, role, isActive])
  @@map("memberships")
}

/// Opaque refresh-token family. One row per active browser session.
///
/// The token itself is never stored — only its SHA-256. `familyId` groups the
/// rotations of one login so that presenting an already-rotated token (the
/// signature of a stolen cookie) can revoke the whole family at once.
model Session {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  familyId  String @db.Uuid
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens for password reset and invitation. Merged from two
/// reference tables that had identical mechanics (D6).
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  /// SHA-256 of the token. The token itself exists only in the email.
  tokenHash String           @unique

  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Brute-force lockout counter: 5 failures per identifier in 15 minutes.
///
/// `identifier` is free text, not a foreign key — failures against a
/// non-existent username must count too, or the lockout becomes a user
/// enumeration oracle.
///
/// ★ Rows must be written OUTSIDE any interactive transaction. A failed login
/// often runs inside a request that then errors; rolled back with it, the
/// counter silently resets and the lockout never fires. docs/SECURITY.md §2.
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  ipAddress  String?
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, succeeded, createdAt])
  @@index([ipAddress, succeeded, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

model Kindergarten {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  address     String?
  phone       String?
  email       String?
  description String?
  isActive    Boolean @default(true)

  /// ★ RFP §3.2 (лого) and §10.3, which requires the logo on every generated
  /// PDF.
  ///
  /// A MediaFile reference, NOT a URL column. CLAUDE.md §1.4: files are never
  /// directly reachable, so there is no address a `logo String` could hold that
  /// this system is allowed to hand out. The column mirrors
  /// `Child.photoMediaFileId` exactly — one image pattern, not two.
  logoMediaFileId String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  logo                  MediaFile?                @relation("KindergartenLogo", fields: [logoMediaFileId], references: [id], onDelete: SetNull)
  memberships           Membership[]
  schoolYears           SchoolYear[]
  groups                Group[]
  groupTeachers         GroupTeacher[]
  children              Child[]
  guardianships         Guardianship[]
  enrollments           Enrollment[]
  childProfiles         ChildProfile[]
  childAgeProfiles      ChildAgeProfile[]
  birthdayNotes         BirthdayNote[]
  developmentDomains    DevelopmentDomain[]
  assessmentLevels      AssessmentLevel[]
  observationTypes      ObservationType[]
  terms                 Term[]
  observations          Observation[]
  observationDomains    ObservationDomain[]
  assessments           Assessment[]
  termReports           TermReport[]
  mediaFiles            MediaFile[]
  notifications         Notification[]
  notificationTargets   NotificationTarget[]
  notificationReactions NotificationReaction[]
  reportJobs            ReportJob[]
  auditLogs             AuditLog[]
  attendanceRecords     Attendance[]
  attendanceRequests    AttendanceRequest[]
  menuDays              MenuDay[]
  surveys               Survey[]
  surveyQuestions       SurveyQuestion[]
  surveyResponses       SurveyResponse[]
  surveyAnswers         SurveyAnswer[]
  growthMeasurements    GrowthMeasurement[]
  milestones            Milestone[]
  allergies             AllergyRecord[]
  medications           MedicationAuthorisation[]
  vaccinations          VaccinationRecord[]
  safetyIncidents       SafetyIncident[]
  artworkComparisons    ArtworkComparison[]
  documents             Document[]
  documentBookmarks     DocumentBookmark[]
  consents              ConsentRecord[]
  mealRecords           MealRecord[]
  fundingRules          FundingRule[]
  fundingCalculations   FundingCalculation[]

  @@index([deletedAt])
  @@map("kindergartens")
}

model SchoolYear {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  /// e.g. "2025-2026"
  name           String
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  isCurrent      Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten     Kindergarten      @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  groups           Group[]
  enrollments      Enrollment[]
  terms            Term[]
  childAgeProfiles ChildAgeProfile[]

  @@unique([kindergartenId, name])
  @@index([kindergartenId, isCurrent])
  @@map("school_years")
}

model Group {
  id             String      @id @default(uuid()) @db.Uuid
  kindergartenId String      @db.Uuid
  schoolYearId   String      @db.Uuid
  name           String
  ageBand        AgeBand
  status         GroupStatus @default(ACTIVE)

  /// RFP §3.2 — ангийн зураг, хичээлийн хуваарь, бүлгийн дүрэм.
  ///
  /// The schedule and the rules are free text rather than structured columns.
  /// The RFP asks that they be *recorded and shown*, not queried or enforced,
  /// and a timetable modelled as rows would be a feature nobody specified.
  photoMediaFileId String? @unique @db.Uuid
  schedule         String?
  rules            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photo               MediaFile?           @relation("GroupPhoto", fields: [photoMediaFileId], references: [id], onDelete: SetNull)
  kindergarten        Kindergarten         @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  schoolYear          SchoolYear           @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  teachers            GroupTeacher[]
  enrollments         Enrollment[]
  notificationTargets NotificationTarget[]

  @@unique([schoolYearId, name])
  @@index([kindergartenId, status])
  @@map("groups")
}

/// ★ The teacher half of the authorization graph.
///
/// Points at Membership, not User, so it is structurally impossible to assign a
/// teacher to a group in a kindergarten where they hold no membership.
///
/// Access is revoked by setting `endedOn`, never by deleting the row — the
/// record of who taught whom has to survive.
model GroupTeacher {
  id             String      @id @default(uuid()) @db.Uuid
  kindergartenId String      @db.Uuid
  groupId        String      @db.Uuid
  membershipId   String      @db.Uuid
  role           TeacherRole @default(LEAD)

  startedOn DateTime? @db.Date
  endedOn   DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([groupId, membershipId])
  @@index([membershipId, endedOn])
  @@map("group_teachers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Children
// ─────────────────────────────────────────────────────────────────────────────

model Child {
  id String @id @default(uuid()) @db.Uuid

  /// ★ "Currently attending" — for listing and filtering ONLY.
  ///
  /// This is NOT an authorization input. Reading it to decide access would
  /// mean a teacher loses the observations they wrote themselves the moment a
  /// child transfers. Authorization resolves the kindergarten set from
  /// Enrollment history. docs/SECURITY.md §5.2.
  kindergartenId String @db.Uuid

  lastName    String
  firstName   String
  nationalId  String?
  sex         Sex
  dateOfBirth DateTime    @db.Date
  status      ChildStatus @default(ACTIVE)

  healthNotes String?

  photoMediaFileId String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten        Kindergarten              @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  photo               MediaFile?                @relation("ChildPhoto", fields: [photoMediaFileId], references: [id], onDelete: SetNull)
  guardianships       Guardianship[]
  enrollments         Enrollment[]
  profile             ChildProfile?
  ageProfiles         ChildAgeProfile[]
  birthdayNotes       BirthdayNote[]
  observations        Observation[]
  assessments         Assessment[]
  termReports         TermReport[]
  mediaFiles          MediaFile[]               @relation("ChildMedia")
  notificationTargets NotificationTarget[]
  reportJobs          ReportJob[]
  auditLogs           AuditLog[]
  attendanceRecords   Attendance[]
  attendanceRequests  AttendanceRequest[]
  surveyResponses     SurveyResponse[]
  growthMeasurements  GrowthMeasurement[]
  milestones          Milestone[]
  allergies           AllergyRecord[]
  medications         MedicationAuthorisation[]
  vaccinations        VaccinationRecord[]
  safetyIncidents     SafetyIncident[]
  artworkComparisons  ArtworkComparison[]
  consents            ConsentRecord[]
  mealRecords         MealRecord[]
  fundingCalculations FundingCalculation[]

  @@unique([kindergartenId, nationalId])
  @@index([kindergartenId, status])
  @@index([kindergartenId, lastName, firstName])
  @@index([kindergartenId, dateOfBirth])
  @@map("children")
}

/// ★ The parent half of the authorization graph.
///
/// `canView = false` revokes a parent's access while preserving the record of
/// the relationship — needed for custody changes. Never delete a guardianship
/// to revoke access.
model Guardianship {
  id             String           @id @default(uuid()) @db.Uuid
  kindergartenId String           @db.Uuid
  childId        String           @db.Uuid
  guardianUserId String           @db.Uuid
  relation       GuardianRelation
  isPrimary      Boolean          @default(false)
  canView        Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian     User         @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@unique([childId, guardianUserId])
  @@index([guardianUserId, canView])
  @@index([childId])
  @@map("guardianships")
}

/// ★ The child's history, and the authoritative answer to "which kindergartens
/// may see this child".
///
/// Rows are ended, never deleted.
model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  kindergartenId String           @db.Uuid
  childId        String           @db.Uuid
  groupId        String           @db.Uuid
  schoolYearId   String           @db.Uuid
  startedOn      DateTime         @db.Date
  endedOn        DateTime?        @db.Date
  status         EnrollmentStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten       Kindergarten        @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child              Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  group              Group               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  schoolYear         SchoolYear          @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  observations       Observation[]
  assessments        Assessment[]
  termReports        TermReport[]
  attendanceRecords  Attendance[]
  attendanceRequests AttendanceRequest[]
  mealRecords        MealRecord[]

  @@index([groupId, status])
  @@index([schoolYearId, status])
  @@index([childId, schoolYearId])
  @@index([childId, status])
  @@map("enrollments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Portfolio
// ─────────────────────────────────────────────────────────────────────────────

/// "Миний тухай" — one per child.
model ChildProfile {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @unique @db.Uuid

  introduction         String?
  nameMeaning          String?
  memorableSayings     String?
  dream                String?
  distinguishingTraits String?

  heightCm   Decimal?  @db.Decimal(5, 1)
  weightKg   Decimal?  @db.Decimal(5, 2)
  recordedOn DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("child_profiles")
}

/// One row per child per age, 2 to 5. `age` is validated in the service layer;
/// Postgres has no cheap way to express "2..5" that Prisma can model portably.
model ChildAgeProfile {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  childId        String  @db.Uuid
  age            Int     @db.SmallInt
  schoolYearId   String? @db.Uuid

  favoriteColor    String?
  favoriteFood     String?
  favoriteToy      String?
  favoriteBook     String?
  favoriteSong     String?
  favoriteStory    String?
  favoriteActivity String?

  personality      String?
  emotionalTraits  String?
  familyMembers    String?
  learningInterest String?
  newSkills        String?

  parentNote  String?
  teacherNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear?  @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@unique([childId, age])
  @@index([childId, age])
  @@map("child_age_profiles")
}

model BirthdayNote {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  childId        String  @db.Uuid
  age            Int     @db.SmallInt
  note           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, age])
  @@map("birthday_notes")
}

/// A remembered first — RFP §4.5, "Онцгой үйл явдал".
///
/// ★ `kind` is a free string with a suggested vocabulary, not an enum and not a
/// configuration table.
///
/// The RFP names seven (анхны алхам, анхны үг, анх цэцэрлэгт орсон өдөр …) and
/// then explicitly asks for "хэрэглэгчийн өөрөө үүсгэсэн үйл явдал" — a family
/// inventing their own. An enum cannot hold the eighth without a migration; a
/// configuration table would make an administrator curate a list that belongs
/// to one family's memory. CLAUDE.md §2.3 binds on what an *administrator*
/// edits, and this is not that. The suggestions live in `packages/contracts` so
/// the form and the API label them identically, and a custom value stores the
/// family's own words.
///
/// ★★ Deliberately NOT an `Observation` with a special type.
///
/// An observation is a teacher's professional record: it carries a development
/// domain, an assessment level, a review status and a next-steps plan, and it
/// stays invisible to a family until approved. A milestone is a memory, usually
/// written by that family, which needs none of that and must never wait for
/// review to appear in the child's own portfolio.
model Milestone {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  childId        String   @db.Uuid
  /// One of `MILESTONE_KINDS`, or `CUSTOM` when the family named their own.
  kind           String
  /// The family's own words. Required for CUSTOM; elsewhere it overrides the
  /// suggested label.
  title          String?
  occurredOn     DateTime @db.Date
  description    String?

  /// Who recorded it — usually a guardian. `User.id`, matching
  /// `Observation.authorId`, so it reads correctly across a role change.
  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("MilestoneRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  media        MediaFile[]  @relation("MilestoneMedia")

  /// ★ No unique constraint on (childId, kind), deliberately: a child has one
  /// first step, but "анх тайзан дээр гарсан" happens again every year and a
  /// family may want both. The timeline is the ordering that matters.
  @@index([childId, occurredOn(sort: Desc)])
  @@index([kindergartenId, occurredOn(sort: Desc)])
  @@map("milestones")
}

// ─────────────────────────────────────────────────────────────────────────────
// Health — RFP Module 2: allergies, medication, vaccination
//
// ★ Three tables, not one "health record" with a `type` column.
//
// They answer different questions, are written by different people, and have
// different lifetimes. An allergy is standing information a teacher must see
// before every meal; a medication authorisation is a dated instruction that
// expires; a vaccination is a historical fact that never changes. A single
// table with a discriminator would give all three the union of their columns
// and none of their constraints — `dosage` meaningless on a vaccination,
// `severity` meaningless on a dose of antibiotics.
//
// ★★ `Child.healthNotes` stays. It is RFP §3.4's free-text "анхаарах
// шаардлагатай товч мэдээлэл" and remains the right home for anything that is
// not one of these three. What it cannot do is be *queried* — which is what
// the menu cross-check needs, and why AllergyRecord exists.
// ─────────────────────────────────────────────────────────────────────────────

/// How badly a child reacts — RFP Module 2 asks for a "Red Flag / Badge".
///
/// A system-level enum rather than a configuration table: this drives an alert
/// a teacher must read the same way in every kindergarten, and a director
/// renaming SEVERE to something reassuring is not a customisation anybody
/// should be offered. CLAUDE.md §2.3's carve-out for "record states".
enum AllergySeverity {
  MILD
  MODERATE
  /// Anaphylaxis risk. The badge is red and the menu check refuses to be quiet.
  SEVERE
}

enum AllergyKind {
  FOOD
  MEDICATION
  ENVIRONMENTAL
  OTHER
}

/// One allergy — RFP Module 2, "Харшил ба Хоолны онцлог".
model AllergyRecord {
  id             String          @id @default(uuid()) @db.Uuid
  kindergartenId String          @db.Uuid
  childId        String          @db.Uuid
  kind           AllergyKind
  severity       AllergySeverity

  /// What the child reacts to, as staff would say it: "самар", "сүү", "өндөг".
  ///
  /// ★ Free text, and matched case-insensitively against a menu dish's
  /// `allergenTags`. Not a lookup table: the RFP gives no vocabulary, kitchens
  /// name ingredients in their own words, and a closed list would make a
  /// teacher unable to record the one allergy their child actually has.
  allergen String

  /// What happens, and what to do about it. Both free text — this is clinical
  /// information transcribed from a family, not something to model.
  reaction  String?
  treatment String?

  /// Ended rather than deleted: a child who outgrows a milk allergy still has
  /// the record of having had one, and a teacher reading the history needs it.
  notedOn DateTime  @db.Date
  endedOn DateTime? @db.Date

  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("AllergyRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// The badge query: every live allergy for one child.
  @@index([childId, endedOn])
  /// The menu cross-check: every live allergy in one kindergarten, at once.
  @@index([kindergartenId, endedOn])
  @@map("allergy_records")
}

/// A guardian's instruction to give medicine — RFP Module 2, "Эм хэрэглээний
/// зөвшөөрөл".
///
/// ★ An authorisation, not an administration log.
///
/// The RFP asks that a parent leaves a form "цаг, тунг тэмдэглэж
/// баталгаажуулан" and that the teacher is reminded at the time. That is a
/// standing instruction with a date range, which is what this models. Recording
/// each individual dose as it is given is a separate feature the RFP does not
/// ask for, and inventing it would put a nurse's medication chart inside a
/// portfolio system.
model MedicationAuthorisation {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid

  medicineName String
  /// "1 шахмал", "5 мл" — the family's own words, transcribed.
  dosage       String
  /// Times of day as `HH:MM` strings, e.g. `["12:00", "16:30"]`.
  ///
  /// ★ Json rather than a `MedicationTime` child table. The RFP wants a
  /// reminder at each time; nothing queries "every child due at 12:00 across
  /// the kindergarten", and a table for an array of two strings is a join for
  /// no reader.
  timesOfDay   Json
  instructions String?

  startsOn DateTime @db.Date
  /// ★ Required, unlike an allergy's `endedOn`.
  ///
  /// An open-ended authorisation to medicate a child is not something a system
  /// should be able to express. A family renews it; it does not run for ever
  /// because somebody forgot to close it.
  endsOn   DateTime @db.Date

  /// The guardian who left the instruction — this is the consent record.
  authorisedById String @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  authorisedBy User         @relation("MedicationAuthorisedBy", fields: [authorisedById], references: [id], onDelete: Restrict)

  /// "What is due today" — a range scan over the active window.
  @@index([kindergartenId, startsOn, endsOn])
  @@index([childId, endsOn(sort: Desc)])
  @@map("medication_authorisations")
}

/// A vaccination or vitamin — RFP Module 2, "Вакцинжуулалт болон Амин дэмийн
/// бүртгэл".
model VaccinationRecord {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  childId        String   @db.Uuid
  /// Free text: the national schedule changes, and a kindergarten also records
  /// vitamins the RFP names in the same breath.
  vaccineName    String
  administeredOn DateTime @db.Date
  /// "2-р тун" — optional, because a single-dose vitamin has none.
  doseLabel      String?
  /// Where it was given: a clinic name, or the kindergarten itself.
  provider       String?
  note           String?

  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("VaccinationRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([childId, administeredOn(sort: Desc)])
  @@map("vaccination_records")
}

/// What happened — RFP Module 2.1's "Тохиолдлын төрөл".
///
/// An enum rather than a configuration table: this is a fixed clinical
/// vocabulary a kindergarten reports against, not a preference. `OTHER` carries
/// what the list does not, with the description doing the work — the same
/// escape hatch `AttendanceStatus` keeps.
enum IncidentKind {
  INJURY // Гэмтэл
  FALL // Уналт
  BRUISE // Хөхрөлт
  SCRATCH // Маажилт
  BITE // Хазуулсан
  ALLERGIC_REACTION // Харшлын шинж
  FEVER // Халууралт
  ILLNESS // Толгой/хэвлий өвдөх
  OTHER
}

/// A safety or health incident — RFP Module 2.1, "Аюулгүй байдлын тэмдэглэл".
///
/// ★ Not an `Observation`, and not a `Notification`.
///
/// An observation is a developmental note a teacher writes to build a picture
/// over a term; this is an event with a time, a body part and a first-aid
/// response, which a family must be told about today. A notification is the
/// delivery mechanism, and one is created *from* an incident when it is
/// reported — but a notification has no `bodyPart`, no follow-up and no
/// priority, and folding the record into the message would lose the record the
/// moment the message was read.
model SafetyIncident {
  id             String       @id @default(uuid()) @db.Uuid
  kindergartenId String       @db.Uuid
  childId        String       @db.Uuid
  kind           IncidentKind

  /// ★ A timestamp, not a date. Module 2.1 asks for "Огноо, цаг" together, and
  /// "which of the two falls this afternoon" is a question a parent asks.
  occurredAt DateTime

  /// Where in the kindergarten — "тоглоомын талбай", "хоолны өрөө".
  location    String?
  /// Which part of the body. Free text: a closed list of anatomy is a medical
  /// system, and staff write what they saw.
  bodyPart    String?
  description String
  /// "Авсан анхан шатны арга хэмжээ" — what was done at the time.
  firstAid    String?
  /// "Дараагийн хяналт" — what still needs watching.
  followUp    String?

  /// ★★ High priority is a flag, not a severity scale.
  ///
  /// Module 2.1 asks for one thing: mark the serious ones **High Priority** and
  /// alert management and the family immediately. A three-level scale would
  /// invite a middle value meaning "somewhat urgent", which nobody acts on.
  isHighPriority Boolean @default(false)

  /// The staff member who recorded it. Nullable so the row survives the account
  /// being deleted, which is the same trade `Observation.authorId` makes.
  recordedById String? @db.Uuid

  /// Set when the family has been told, and by which notice. Null means
  /// recorded and **not yet reported** — the state the review screen exists to
  /// surface.
  reportedAt     DateTime?
  notificationId String?   @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten  @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?         @relation("IncidentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  notification Notification? @relation("IncidentNotification", fields: [notificationId], references: [id], onDelete: SetNull)
  media        MediaFile[]   @relation("IncidentMedia")

  @@index([childId, occurredAt(sort: Desc)])
  /// The kindergarten's incident log.
  @@index([kindergartenId, occurredAt(sort: Desc)])
  /// The unreported queue: high-priority first, still awaiting a family.
  @@index([kindergartenId, isHighPriority, reportedAt])
  @@map("safety_incidents")
}

/// Two works, side by side, with what changed between them — RFP §5.3.
///
/// ★ Only the *conclusion* is new. Everything else §5.3 asks for already
/// exists: several artwork photographs per observation (`MediaFile.
/// observationId`, capped at twelve), a date on each (`takenAt`), a caption on
/// each, and the whole set orderable in time. What the schema could not hold
/// was the sentence a teacher writes about the change — "долоо хоногийн дараа
/// хүн зурахдаа гар, хөлийг тусад нь зурсан" — and that sentence is the
/// feature. So this table is a pair of pointers and a paragraph, not a copy of
/// the images.
///
/// ★★ Two works, not N.
///
/// §5.3 says "өмнөх болон дараагийн бүтээлийг зэрэгцүүлэн харах" — the previous
/// and the next, side by side. A set of arbitrary size would need an ordering
/// table and an answer to "what does a conclusion about five drawings mean",
/// and neither is asked for. A teacher comparing three works makes two
/// comparisons, which is also how they would say it out loud.
model ArtworkComparison {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid

  /// ★★★ Ordered by the service, not by the caller.
  ///
  /// A teacher who picks the two works in the wrong order would otherwise get a
  /// comparison that reads as development running backwards. The service sorts
  /// them by when the work was made before storing, so `earlier` is always
  /// earlier — see `ArtworkService.compare`.
  earlierMediaId String @db.Uuid
  laterMediaId   String @db.Uuid

  /// "Хөгжлийн өөрчлөлтийн дүгнэлт" — the reason the row exists.
  conclusion String

  /// The teacher whose judgement this is. A comparison is a professional
  /// reading of a child's development, so it carries an author the way an
  /// observation does.
  authorId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  earlierMedia MediaFile    @relation("ComparisonEarlier", fields: [earlierMediaId], references: [id], onDelete: Cascade)
  laterMedia   MediaFile    @relation("ComparisonLater", fields: [laterMediaId], references: [id], onDelete: Cascade)
  author       User?        @relation("ComparisonAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt(sort: Desc)])
  @@map("artwork_comparisons")
}

// ─────────────────────────────────────────────────────────────────────────────
// Document library — RFP §9
// ─────────────────────────────────────────────────────────────────────────────

/// A PDF in the kindergarten's library — RFP §9.
///
/// ★ Kindergarten-scoped, not child data. It is staff reference material —
/// curricula, methodology, regulations — so `MediaService` authorises the file
/// by membership, exactly as it does a logo, and `canAccessChild` never runs.
///
/// ★★ `version` replaces rather than accumulates.
///
/// §9 asks for "Баримт шинэ хувилбараар солих" — replace with a new version —
/// and a `version` string on one row is what that means. A separate
/// `DocumentVersion` table would be the right model for "show me last year's
/// curriculum", which §9 does not ask for and which nobody has requested.
model Document {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  title          String
  /// Free text — §9 says "Ангилал" and gives no vocabulary, and a kindergarten
  /// files by its own headings. Filtered on exactly, not fuzzily.
  category       String?
  description    String?
  /// "Хувилбар" — e.g. "2026.1". A label, not an ordering key.
  version        String?

  /// The PDF itself. Required: a library entry with no document is a title.
  fileMediaFileId  String  @unique @db.Uuid
  /// "Нүүр зураг" — optional cover image.
  coverMediaFileId String? @unique @db.Uuid

  publishedAt   DateTime @default(now())
  publishedById String?  @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten       @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  file         MediaFile          @relation("DocumentFile", fields: [fileMediaFileId], references: [id], onDelete: Restrict)
  cover        MediaFile?         @relation("DocumentCover", fields: [coverMediaFileId], references: [id], onDelete: SetNull)
  publishedBy  User?              @relation("DocumentPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  bookmarks    DocumentBookmark[]

  @@index([kindergartenId, category])
  @@index([kindergartenId, publishedAt(sort: Desc)])
  @@map("documents")
}

/// One person's bookmark — RFP §9's "Bookmark хийсэн эсэх".
///
/// ★ A join table rather than a boolean on `Document`, because the flag is
/// per-*reader*: a column would make one teacher's bookmark appear on every
/// colleague's list, which is the opposite of what a bookmark is.
model DocumentBookmark {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  documentId     String @db.Uuid
  userId         String @db.Uuid

  createdAt DateTime @default(now())

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user         User         @relation("DocumentBookmarkUser", fields: [userId], references: [id], onDelete: Cascade)

  /// One bookmark per person per document. No soft delete: un-bookmarking is
  /// not a fact anybody needs to recover.
  @@unique([documentId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("document_bookmarks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Consent — RFP §16
// ─────────────────────────────────────────────────────────────────────────────

/// What a family is being asked to agree to — RFP §16.
///
/// ★ Two kinds, because §16 asks for two separate things: "Эцэг эхээс мэдээлэл
/// ашиглах зөвшөөрөл авах" and, in its own sentence, "Зураг нийтлэх зөвшөөрлийг
/// тусад нь бүртгэх" — photo publishing recorded *separately*. A single
/// "consented: true" would make refusing photographs mean refusing the system.
enum ConsentKind {
  /// Using the child's information in the system at all.
  DATA_PROCESSING
  /// Publishing the child's photographs beyond the family — RFP §16.
  PHOTO_PUBLISHING
}

/// One guardian's decision, with the date it was made.
///
/// ★ Rows are never updated to reverse a decision — a new row supersedes.
///
/// Consent is a legal record: "we had permission on the day we published" is
/// the question it exists to answer, and an `UPDATE` that flipped a boolean
/// would destroy exactly that. `decidedAt` orders them and the latest wins.
model ConsentRecord {
  id             String      @id @default(uuid()) @db.Uuid
  kindergartenId String      @db.Uuid
  childId        String      @db.Uuid
  kind           ConsentKind
  granted        Boolean

  /// The guardian who decided. Not nullable: an unattributed consent record is
  /// not evidence of anything.
  decidedById String   @db.Uuid
  decidedAt   DateTime @default(now())
  /// What they were shown, so a later dispute can establish what was agreed.
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  decidedBy    User         @relation("ConsentDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  /// The current answer: latest row per child per kind.
  @@index([childId, kind, decidedAt(sort: Desc)])
  @@index([kindergartenId, kind])
  @@map("consent_records")
}

/// Which sitting — `нэмэлт.md` §2.
enum MealKind {
  BREAKFAST // Өглөөний цай
  LUNCH // Үдийн хоол
  AFTERNOON_SNACK // Үдээс хойших цай
  EXTRA // Нэмэлт хоол
}

/// Whether the child ate — `нэмэлт.md` §2.
enum MealStatus {
  TAKEN // Авсан
  NOT_TAKEN // Аваагүй
  PARTIAL // Хэсэгчлэн
  SPECIAL // Тусгай хоол
}

/// One child, one day, one sitting — `нэмэлт.md` §2.
///
/// ★ Separate from `Attendance`, and that separation is the point.
///
/// §17 states the governing principle: a fact is recorded once and reused. It
/// would be tempting to infer "ate lunch" from "was present", and §3 shows why
/// that fails — the food cost is computed from **hooллосон өдөр**, days the
/// child actually ate, which is not the same as days they attended. A child
/// present on a half day, or collected before lunch, attended and did not eat.
/// Deriving one from the other would make the cost calculation silently wrong.
///
/// ★★ Anchored to `Enrollment` like `Attendance`, for the same reason: a meal
/// served in January belongs to whichever kindergarten served it, and a
/// transfer must not rewrite that.
model MealRecord {
  id             String     @id @default(uuid()) @db.Uuid
  kindergartenId String     @db.Uuid
  childId        String     @db.Uuid
  enrollmentId   String     @db.Uuid
  date           DateTime   @db.Date
  kind           MealKind
  status         MealStatus
  note           String?

  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("MealRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// One row per enrollment per day per sitting. Replaced by a **partial**
  /// unique index in the migration — same reasoning as `Attendance`: Postgres
  /// treats NULLs as distinct, so the plain form would let a soft-deleted row
  /// block its own sitting for ever.
  @@unique([enrollmentId, date, kind])
  /// The group's day sheet: every child, one date.
  @@index([kindergartenId, date])
  /// A child's month, and the "days eaten" count a cost calculation needs.
  @@index([childId, date])
  @@map("meal_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Funding and food cost — нэмэлт.md §3, §4, §5
// ─────────────────────────────────────────────────────────────────────────────

/// Where the money comes from — нэмэлт.md §3's "эх үүсвэрээр салгаж харуулна".
enum FundingSource {
  STATE // Улсын санхүүжилт
  PARENT // Эцэг эхийн төлбөр
  KINDERGARTEN // Цэцэрлэгийн санхүүжилт
  OTHER // Бусад эх үүсвэр
}

/// A tariff and the conditions it applies under — нэмэлт.md §5.
///
/// ★ §4 is explicit: "Санхүүжилтийн тариф болон дүрмийг source code-д тогтмол
/// бичихгүй. Администратор тохиргоогоор өөрчлөх боломжтой байна." So this is a
/// table, like `DevelopmentDomain` and `AssessmentLevel`, and for a sharper
/// reason than either: a rate hard-coded in TypeScript would need a deployment
/// to follow a government circular, and the wrong rate applied for a month is a
/// reconciliation nobody can undo cleanly.
///
/// ★★ Rules are **superseded, never edited**, once they have been used.
///
/// A month's calculation is evidence — "this is the rate we billed under" — and
/// editing the rate that produced it rewrites the past. `effectiveFrom` and
/// `effectiveTo` bound each one; a new rate is a new row starting the day the
/// old one ends. That is why the calculation stores its own `dailyRate` too.
model FundingRule {
  id             String        @id @default(uuid()) @db.Uuid
  kindergartenId String        @db.Uuid
  name           String
  source         FundingSource

  effectiveFrom DateTime  @db.Date
  /// Null means "still in force". A rule is closed by setting this, not deleted.
  effectiveTo   DateTime? @db.Date

  /// Which children it applies to. Null means every age.
  ageBand AgeBand?

  /// The money, in **tögrög**, as `Decimal` — never a float.
  ///
  /// A binary float cannot hold 0.1 exactly, and a month's funding is a sum of
  /// thousands of these; the error is small per row and visible in a total that
  /// has to reconcile against a bank statement.
  dailyRate   Decimal? @db.Decimal(12, 2)
  monthlyRate Decimal? @db.Decimal(12, 2)

  /// §5's "Ирцээс хамаарах эсэх" and "Хоолны хэрэглээнээс хамаарах эсэх".
  ///
  /// These decide which counter the daily rate multiplies: days attended, days
  /// fed, or neither (a flat monthly charge). Both false with a `monthlyRate`
  /// is the flat case.
  dependsOnAttendance Boolean @default(true)
  dependsOnMeals      Boolean @default(false)

  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten        Kindergarten         @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  fundingCalculations FundingCalculation[]

  /// "Which rules were in force in March" — the calculation's own lookup.
  @@index([kindergartenId, source, effectiveFrom])
  @@map("funding_rules")
}

/// What a child's funding worked out to for one month — нэмэлт.md §6.
///
/// ★ The inputs are stored alongside the result, not just referenced.
///
/// `daysAttended`, `daysFed` and `dailyRate` are copied onto the row at
/// calculation time. Recomputing them later from the live tables would answer a
/// different question the moment an attendance correction lands — and §6's
/// state machine (Draft → Submitted → Approved → Paid → Reconciled) exists
/// precisely because an approved figure must stay the figure that was approved.
model FundingCalculation {
  id             String        @id @default(uuid()) @db.Uuid
  kindergartenId String        @db.Uuid
  childId        String        @db.Uuid
  source         FundingSource
  /// The month this covers, as its first day.
  month          DateTime      @db.Date

  daysAttended  Int
  daysFed       Int
  /// The rate actually applied — see the note above.
  dailyRate     Decimal? @db.Decimal(12, 2)
  /// The rule that produced it, for tracing. Nullable so a deleted rule does
  /// not take the calculation with it.
  fundingRuleId String?  @db.Uuid

  /// Тооцсон дүн — what the rule computes.
  calculatedAmount Decimal  @db.Decimal(12, 2)
  /// Баталгаажсан дүн — what was approved, once it is.
  approvedAmount   Decimal? @db.Decimal(12, 2)
  /// Хүлээн авсан дүн — what actually arrived.
  receivedAmount   Decimal? @db.Decimal(12, 2)

  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  fundingRule  FundingRule? @relation(fields: [fundingRuleId], references: [id], onDelete: SetNull)

  /// One calculation per child per month per source, among live rows.
  @@unique([childId, month, source])
  @@index([kindergartenId, month])
  @@map("funding_calculations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Growth — RFP §7
// ─────────────────────────────────────────────────────────────────────────────

/// One height/weight measurement — RFP §7.1.
///
/// ★ A time series, and `ChildProfile.heightCm` stays where it is.
///
/// Those two columns answer RFP §4.1: the height and weight printed in "Миний
/// тухай", one pair, edited in place, part of a portfolio page. This table
/// answers §7.2, which asks for a chart over time and a comparison with the
/// previous measurement — questions a single overwritten pair cannot answer at
/// all. Folding §4.1 into this table would delete the portfolio's own field;
/// folding this into §4.1 would delete every measurement but the last.
///
/// ★★ Anchored to `Child`, not to `Enrollment`.
///
/// Attendance hangs off an enrollment because a day of attendance belongs to
/// whichever kindergarten the child attended that day. A child's height belongs
/// to the child: it is the same body before and after a transfer, and a growth
/// chart that reset on moving kindergarten would be worse than useless. The
/// kindergarten column is the denormalised tenant scope every table carries
/// (CLAUDE.md §3.1), recording who took the measurement, not who owns the fact.
model GrowthMeasurement {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  childId        String   @db.Uuid
  measuredOn     DateTime @db.Date

  /// 30..200 cm, validated in the service. `Decimal(5,1)` matches
  /// `ChildProfile.heightCm` — one shape for one quantity.
  heightCm Decimal? @db.Decimal(5, 1)
  /// 2..100 kg, matching `ChildProfile.weightKg`.
  weightKg Decimal? @db.Decimal(5, 2)

  /// RFP §7.1 — "толгойн тойрог шаардлагатай бол". Optional in the RFP's own
  /// words, and rarely taken after infancy.
  headCircumferenceCm Decimal? @db.Decimal(4, 1)

  note String?

  /// Who took it. `User.id` rather than `Membership.id`, matching
  /// `Observation.authorId` — it reads correctly across a role change.
  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("GrowthRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// ★ One measurement per child per day, enforced by a **partial** unique
  /// index in the migration — the same treatment `Attendance` gets, for the
  /// same reason: Postgres treats NULLs as distinct, so a plain constraint
  /// would let a soft-deleted row block its own date for ever.
  ///
  /// One a day is the right grain: a nurse re-measuring after a bad reading is
  /// correcting the same measurement, not adding a second one, and a chart with
  /// two points on one date has no defined order.
  @@unique([childId, measuredOn])
  /// The chart: always a range scan over one child, newest first.
  @@index([childId, measuredOn(sort: Desc)])
  @@index([kindergartenId, measuredOn(sort: Desc)])
  @@map("growth_measurements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuration — administrator-editable, therefore tables and not enums
//
// `kindergartenId = NULL` means a system default shared by every kindergarten.
// A kindergarten admin may create and edit their own rows; they may NOT edit a
// system row — they create an override instead.
// ─────────────────────────────────────────────────────────────────────────────

model DevelopmentDomain {
  id             String  @id @default(uuid()) @db.Uuid
  /// NULL = system default, visible to all kindergartens.
  kindergartenId String? @db.Uuid
  name           String
  code           String
  order          Int     @default(0)
  color          String  @default("#94a3b8")
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten       Kindergarten?       @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  observationDomains ObservationDomain[]
  assessments        Assessment[]

  @@unique([kindergartenId, code])
  @@index([kindergartenId, isActive, order])
  @@map("development_domains")
}

model AssessmentLevel {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String? @db.Uuid
  /// 1..4 — "Дэмжлэгтэй" … "Давсан"
  value          Int     @db.SmallInt
  label          String
  color          String  @default("#94a3b8")
  description    String?
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten       Kindergarten?       @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  observationDomains ObservationDomain[]
  assessments        Assessment[]

  @@unique([kindergartenId, value])
  @@index([kindergartenId, isActive, order])
  @@map("assessment_levels")
}

model ObservationType {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String? @db.Uuid
  name           String
  code           String
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@unique([kindergartenId, code])
  @@index([kindergartenId, isActive, order])
  @@map("observation_types")
}

// ─────────────────────────────────────────────────────────────────────────────
// Observation and assessment
// ─────────────────────────────────────────────────────────────────────────────

model Observation {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  /// Pins the observation to the group and school year it was written in, so a
  /// later transfer does not rewrite history.
  enrollmentId   String @db.Uuid
  typeId         String @db.Uuid

  source     ObservationSource @default(TEACHER)
  observedOn DateTime          @db.Date

  activityName   String?
  situation      String?
  childDid       String?
  childSaid      String?
  teacherComment String?
  nextSteps      String?

  /// ★ Defaults to FALSE. A teacher's working note is private until deliberately
  /// shared. Filtering on this is enforced server-side, never in the client.
  visibleToParents Boolean @default(false)
  includeInReport  Boolean @default(true)

  /// Domain authorship, not audit data. Needed at query time: a guardian may
  /// edit their own submission before it is approved, and always sees their own
  /// pending note — otherwise they cannot tell whether it saved.
  authorId String? @db.Uuid

  reviewStatus ReviewStatus @default(APPROVED)
  reviewedById String?      @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten        @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  type         ObservationType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  author       User?               @relation("ObservationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy   User?               @relation("ObservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  domains      ObservationDomain[]
  media        MediaFile[]         @relation("ObservationMedia")

  @@index([childId, observedOn(sort: Desc)])
  @@index([kindergartenId, observedOn(sort: Desc)])
  @@index([enrollmentId, observedOn(sort: Desc)])
  @@index([source, reviewStatus])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([childId, visibleToParents, observedOn(sort: Desc)])
  @@map("observations")
}

model ObservationDomain {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  observationId  String  @db.Uuid
  domainId       String  @db.Uuid
  levelId        String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten      @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  observation  Observation       @relation(fields: [observationId], references: [id], onDelete: Cascade)
  domain       DevelopmentDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  level        AssessmentLevel?  @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@unique([observationId, domainId])
  @@index([domainId])
  @@map("observation_domains")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────────────────────

/// Ирсэн/Хагас өдөр/Чөлөөтэй are confirmed against the reference system;
/// SICK and ABSENT are this project's own addition to round out an ordinary
/// attendance set and are not yet confirmed against the client's full list —
/// see docs/reference for the open question.
enum AttendanceStatus {
  PRESENT // Ирсэн
  HALF_DAY // Хагас өдөр
  EXCUSED // Чөлөөтэй
  SICK // Өвчтэй
  ABSENT // Тасалсан
  /// ★ Restored 2026-08-25. `нэмэлт.md` §1 lists six statuses and this is the
  /// sixth; it existed in the first attendance migration and was dropped when
  /// that migration was rewritten, which nothing recorded as a decision.
  ///
  /// It is the escape hatch every enum in this schema keeps: a day that is none
  /// of the five is otherwise recorded as the nearest wrong one, and an
  /// attendance figure that feeds a funding calculation cannot afford that.
  OTHER // Бусад
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Who physically handed the child over — at drop-off (`arrivedWith`) and,
/// separately, at pickup (`pickedUpWith`). A category, not a link to a
/// specific `Guardianship` row: staff record "mom" or "dad" at a glance, not
/// which named guardian. `OTHER` is anyone not on the guardian list — a
/// driver, a relative. No `ALONE`: dropped 2026-08-25, client request — a
/// kindergarten this young never receives a child unaccompanied, so the
/// option had no real case to cover.
enum AttendanceCompanion {
  MOTHER // Ээж
  FATHER // Аав
  OTHER // Бусад
}

/// One row per enrollment per day — never per bare `childId`, so a transfer
/// mid-year does not rewrite which kindergarten a day of attendance belongs
/// to (this feeds funding claims later, RFP appendix).
///
/// ★ `@@unique([enrollmentId, date])` below is emitted by Prisma as a plain
/// index; the migration `20260825120000_partial_unique_attendance_day`
/// replaces it with a **partial** one over `deletedAt IS NULL`. Postgres
/// treats NULLs as distinct, so the plain form counts a soft-deleted row as
/// still occupying the day — a day deleted once could never be recorded
/// again, surfacing as a unique violation on a row nobody can see. Prisma has
/// no partial-unique syntax, so this cannot be expressed here; see the
/// migration's SQL and `test/schema.test.ts`'s
/// "allows the day to be recorded again after the first row is soft-deleted".
model Attendance {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  enrollmentId   String @db.Uuid

  date   DateTime         @db.Date
  status AttendanceStatus
  /// Medication instructions when SICK — RFP: "эмийн зааварчилгаа, тун
  /// болон цагийн санамж".
  note   String?

  /// Drop-off. Both null until staff actually record who brought the child
  /// and when — never defaulted, so an unrecorded arrival stays visibly
  /// unrecorded rather than reading as "someone, at midnight".
  arrivedWith     AttendanceCompanion?
  /// Who, when `arrivedWith` is OTHER — a name a category alone cannot
  /// carry ("Бусад" says "not a parent", not who). Null for MOTHER/FATHER:
  /// the category already names them.
  arrivedWithName String?
  arrivedAt       DateTime?

  /// Pickup — recorded later the same day, independently of drop-off, so it
  /// cannot require re-sending `status`/`arrivedWith` to write. Custody
  /// accountability: a kindergarten needs to know *someone* collected the
  /// child, which this pair is the record of.
  pickedUpWith     AttendanceCompanion?
  /// Same reasoning as `arrivedWithName`, for the OTHER case at pickup.
  pickedUpWithName String?
  pickedUpAt       DateTime?

  /// The staff member who recorded it. Matches `Observation.authorId` —
  /// `User.id`, not `Membership.id`, so it reads across a role change.
  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, date])
  @@index([childId, date(sort: Desc)])
  @@index([kindergartenId, date(sort: Desc)])
  @@map("attendance_records")
}

/// A guardian's advance notice ("my child will be excused tomorrow"), not
/// itself an attendance record. Approving one writes the actual `Attendance`
/// rows for the covered range — staff stays the sole author of `Attendance`,
/// matching the decision that parents may request but not record directly.
model AttendanceRequest {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  enrollmentId   String @db.Uuid

  /// User.id of the guardian who asked — a guardian has no Membership.
  requestedById   String                  @db.Uuid
  dateFrom        DateTime                @db.Date
  dateTo          DateTime                @db.Date
  requestedStatus AttendanceStatus
  reason          String?
  reviewStatus    AttendanceRequestStatus @default(PENDING)

  /// Set only when `requestedStatus` is PRESENT — a guardian reporting the
  /// morning's drop-off ("Ирц мэдэгдэх"), not a leave notice. Copied onto the
  /// `Attendance` row `reviewRequest` writes only on APPROVED, same as every
  /// other field here: a rejected or still-pending claim leaves no trace on
  /// the actual record.
  arrivedWith     AttendanceCompanion?
  /// Who, when `arrivedWith` is OTHER — see `Attendance.arrivedWithName`.
  arrivedWithName String?
  arrivedAt       DateTime?

  /// The same guardian's *second* request the same day — "Гарсныг мэдэгдэх"
  /// at pickup, once the child is already checked in. A separate row rather
  /// than fields added to the arrival request: the guardian does not know
  /// who is collecting the child at drop-off time, so the two are always
  /// two submissions, hours apart, each reviewed on its own.
  pickedUpWith     AttendanceCompanion?
  pickedUpWithName String?
  pickedUpAt       DateTime?
  /// The staff member who reviewed it — `User.id`, matching `recordedById`.
  reviewedById    String?                 @db.Uuid
  reviewedAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("AttendanceRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("AttendanceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([childId, dateFrom(sort: Desc)])
  @@index([kindergartenId, reviewStatus])
  @@map("attendance_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Meals — the weekly menu, RFP §989. Kindergarten-wide, not per-child: a
// per-child "did they eat" record is not in the RFP and is not built here.
// ─────────────────────────────────────────────────────────────────────────────

/// One row per kindergarten per day. "Weekly" is a query range over these,
/// not its own entity — there is nothing a week needs beyond seven days.
///
/// `dishes` is `Json`, an array of `{ name: string, allergenTags: string[] }`.
/// Allergen tags are admin-typed free strings, not a lookup table: the
/// cross-check against a child's freeform `healthNotes` is a best-effort
/// substring match done in the UI, not a structured allergy system (that is
/// its own, separately excluded MVP feature — CLAUDE.md §7).
model MenuDay {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  date           DateTime @db.Date
  dishes         Json
  /// Кcal for the whole day, typed in by staff — not summed from `dishes`,
  /// which carries no per-dish figure of its own. Optional: most days will
  /// never get one, and a blank value must read as "not entered" rather than
  /// "zero calories".
  totalCalories  Int?

  createdById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("MenuDayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([kindergartenId, date])
  @@index([kindergartenId, date(sort: Desc)])
  @@map("menu_days")
}

// ─────────────────────────────────────────────────────────────────────────────
// Surveys — RFP "Модуль 1: Судалгаа, Асуулга". This ships the RFP's core
// mechanism only: create, publish, respond, see aggregate results. The
// September-vs-May term comparison, the 5-sheet Excel export, and folding
// survey data into the development radar are each their own future pass —
// deliberately not built here, not silently dropped.
// ─────────────────────────────────────────────────────────────────────────────

enum SurveyScope {
  /// Answered by a guardian, about their own child.
  CHILD
  /// Answered once by any member of the kindergarten — no child attached.
  KINDERGARTEN
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SurveyQuestionType {
  RATING // 1-5
  YES_NO
  TEXT
  CHECKBOX // multi-select; `options` holds the choices
  /// RFP Module 1.1 — "Matrix (олон үзүүлэлтийн хүснэгт)".
  ///
  /// One question carrying several indicators scored on a shared scale, which
  /// is how a development questionnaire is actually written: "rate each of
  /// these seven areas 1–5". `options` holds `{ rows, columns }` and the answer
  /// is `{ [rowKey]: number }` — see `survey-scoring.ts`.
  MATRIX
}

/// Where in the school year a survey sits — RFP Module 1.1's "эхний/завсрын/
/// жилийн эцсийн үнэлгээгээр ... ангилан архивлана".
///
/// ★ This is what makes Module 1.2's automatic comparison possible at all.
/// Without it nothing distinguishes September's wave from May's, and "compare
/// the same questionnaire at the start and the end of the year" has no way to
/// tell which is which.
enum SurveyPeriod {
  BASELINE // Эхний үнэлгээ — есдүгээр сар
  MIDLINE // Завсрын үнэлгээ
  ENDLINE // Жилийн эцсийн үнэлгээ — тавдугаар сар
}

model Survey {
  id             String       @id @default(uuid()) @db.Uuid
  kindergartenId String       @db.Uuid
  title          String
  description    String?
  scope          SurveyScope
  status         SurveyStatus @default(DRAFT)
  createdById    String?      @db.Uuid
  publishedAt    DateTime?
  closedAt       DateTime?

  /// "2025-2026". A string, not a year number: a school year spans two.
  schoolYear String?
  /// Which wave — RFP Module 1.1's archival classification, and the field
  /// Module 1.2's begin-to-end comparison pairs on.
  period     SurveyPeriod?

  /// The survey this one was cloned from — RFP Module 1.2's lineage.
  ///
  /// ★ Kept for provenance and for Sheet 5's year-over-year walk, but it is
  /// **not** what the comparison pairs questions on. Questions are matched by
  /// `SurveyQuestion.indicatorKey`, because a cloned survey starts as a DRAFT
  /// whose questions may still be edited — and editing them deletes and
  /// recreates every row, which would destroy any id-based lineage. See the
  /// note on `indicatorKey`.
  clonedFromSurveyId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten     @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("SurveyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  questions    SurveyQuestion[]
  responses    SurveyResponse[]
  clonedFrom   Survey?          @relation("SurveyClone", fields: [clonedFromSurveyId], references: [id], onDelete: SetNull)
  clones       Survey[]         @relation("SurveyClone")

  @@index([kindergartenId, status])
  /// "This year's waves, in order" — what Module 1.2 asks for.
  @@index([kindergartenId, schoolYear, period])
  @@map("surveys")
}

model SurveyQuestion {
  id             String             @id @default(uuid()) @db.Uuid
  kindergartenId String             @db.Uuid
  surveyId       String             @db.Uuid
  order          Int
  type           SurveyQuestionType
  prompt         String
  /// CHECKBOX's choices, as a string array; MATRIX's `{ rows, columns }`.
  /// Unused by RATING, YES_NO and TEXT.
  options        Json?

  /// What this question *measures*, stable across waves and years.
  ///
  /// ★ This, not the row id, is what Module 1.2 pairs September against May on.
  ///
  /// A cloned survey starts as a DRAFT, and editing a DRAFT's questions runs
  /// `replaceQuestions`, which deletes every row and creates new ones. Any
  /// pairing built on `SurveyQuestion.id` — or on a `clonedFromQuestionId`
  /// pointing at one — is destroyed by a teacher reordering two questions
  /// before publishing. Pairing on `order` fails differently and worse: insert
  /// one question in May and every indicator after it silently compares against
  /// the wrong September question, reporting a progress figure that is not
  /// wrong-looking, just wrong.
  ///
  /// The key round-trips through the edit endpoint and is copied by the clone,
  /// so it survives both. Null means "not comparable", which is honest for a
  /// one-off poll.
  indicatorKey String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers      SurveyAnswer[]

  @@index([surveyId, order])
  /// The comparison's lookup: "every wave's version of this indicator".
  @@index([kindergartenId, indicatorKey])
  @@map("survey_questions")
}

/// One guardian's (or, for a KINDERGARTEN-scope survey, one member's) full
/// submission. `childId` is set only for a CHILD-scope survey.
model SurveyResponse {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  surveyId       String   @db.Uuid
  childId        String?  @db.Uuid
  respondentId   String   @db.Uuid
  submittedAt    DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  child        Child?         @relation(fields: [childId], references: [id], onDelete: Cascade)
  respondent   User           @relation("SurveyRespondent", fields: [respondentId], references: [id], onDelete: Cascade)
  answers      SurveyAnswer[]

  @@index([surveyId, childId])
  @@index([surveyId, respondentId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  responseId     String @db.Uuid
  questionId     String @db.Uuid
  /// A number (RATING), a boolean (YES_NO), a string (TEXT) or a string
  /// array (CHECKBOX) — the shape `SurveyQuestion.type` says it should be.
  value          Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  response     SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question     SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@map("survey_answers")
}

model Term {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  schoolYearId   String   @db.Uuid
  /// 1..3
  number         Int      @db.SmallInt
  name           String
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  schoolYear   SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  assessments  Assessment[]
  termReports  TermReport[]

  @@unique([schoolYearId, number])
  @@index([kindergartenId, startsOn])
  @@map("terms")
}

model Assessment {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  childId        String  @db.Uuid
  enrollmentId   String  @db.Uuid
  domainId       String  @db.Uuid
  termId         String  @db.Uuid
  levelId        String  @db.Uuid
  comment        String?

  visibleToParents Boolean @default(false)

  assessedById String?  @db.Uuid
  assessedAt   DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten      @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  domain       DevelopmentDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  term         Term              @relation(fields: [termId], references: [id], onDelete: Restrict)
  level        AssessmentLevel   @relation(fields: [levelId], references: [id], onDelete: Restrict)
  assessedBy   User?             @relation("AssessmentAuthor", fields: [assessedById], references: [id], onDelete: SetNull)

  @@unique([childId, termId, domainId])
  @@index([childId, termId])
  @@index([kindergartenId, termId])
  @@index([enrollmentId, termId])
  @@map("assessments")
}

model TermReport {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  enrollmentId   String @db.Uuid
  termId         String @db.Uuid

  strengths        String?
  needsSupport     String?
  nextGoals        String?
  adviceForParents String?

  status      TermReportStatus @default(DRAFT)
  authorId    String?          @db.Uuid
  finalizedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  author       User?        @relation("TermReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([childId, termId])
  @@index([childId, termId])
  @@index([kindergartenId, termId])
  @@map("term_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────────────────────────────────────

/// File metadata. The bytes live in R2; this table never holds binary.
///
/// `storageKey` is a random UUID path — `children/{uuid}/{uuid}`. It is NEVER
/// derived from the child's name, id or the uploaded filename. The real
/// filename lives only in `originalName`, for display, and is never used to
/// build a URL. docs/SECURITY.md §7.
model MediaFile {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  /// The authorization anchor. NULL only for kindergarten-level outputs.
  childId        String? @db.Uuid
  observationId  String? @db.Uuid
  /// Set for `NOTIFICATION` media. Mutually exclusive with `childId` in
  /// practice: a class announcement is addressed to a group, not a child.
  notificationId String? @db.Uuid
  /// Set for `MILESTONE` media — RFP §4.5's "Зураг". Carries `childId` too, so
  /// the ordinary child-media authorization applies without a special case.
  milestoneId    String? @db.Uuid
  /// Set for `INCIDENT` media — Module 2.1's "фото зураг хавсаргах". Also
  /// carries `childId`, so the ordinary child-media authorization applies.
  incidentId     String? @db.Uuid
  order          Int     @default(0)

  purpose MediaPurpose

  storageKey   String  @unique
  originalName String
  /// Detected from CONTENT, never from the extension.
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  checksum     String?

  status  MediaStatus @default(READY)
  caption String?

  /// ── Album metadata — RFP §4.4 ───────────────────────────────────────────
  ///
  /// All nullable: every one of these arrived after photographs had already
  /// been stored, and a required column would have needed a value invented for
  /// rows nobody can go back and ask about.

  /// When the photograph was TAKEN, as distinct from `uploadedAt`. A parent
  /// uploading last summer's holiday in October is the ordinary case, and
  /// sorting an album by upload time puts it in the wrong year.
  takenAt DateTime? @db.Date

  /// The child's age in the photograph, 2..5 — the album's "нас" facet.
  /// Validated in the service layer, like `ChildAgeProfile.age`.
  age Int? @db.SmallInt

  /// The album's "ангилал" facet.
  ///
  /// ★ A plain string constrained by a zod enum in the DTO, deliberately NOT a
  /// Prisma enum and NOT a configuration table. The RFP does not say an
  /// administrator edits this list, so CLAUDE.md §2.3 does not bind; and of the
  /// three shapes this is the only one that can become either of the others
  /// without rewriting stored rows. If the client asks for it to be editable,
  /// the existing values become seed rows in a new table.
  category String?

  /// Whose photograph this is, for display. See `MediaAttribution`.
  attribution MediaAttribution?

  /// The account that uploaded the bytes.
  ///
  /// Domain data, not audit data — the same distinction `Observation.authorId`
  /// draws. The gallery labels a photograph with who contributed it, which is a
  /// query-time need; `AuditLog` answers the forensic question separately and
  /// outlives the row.
  uploadedById String? @db.Uuid

  uploadedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  kindergarten       Kindergarten        @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child              Child?              @relation("ChildMedia", fields: [childId], references: [id], onDelete: Cascade)
  observation        Observation?        @relation("ObservationMedia", fields: [observationId], references: [id], onDelete: Cascade)
  notification       Notification?       @relation("NotificationMedia", fields: [notificationId], references: [id], onDelete: Cascade)
  milestone          Milestone?          @relation("MilestoneMedia", fields: [milestoneId], references: [id], onDelete: Cascade)
  incident           SafetyIncident?     @relation("IncidentMedia", fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedBy         User?               @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  childPhotoOf       Child?              @relation("ChildPhoto")
  comparisonEarlier  ArtworkComparison[] @relation("ComparisonEarlier")
  documentFileOf     Document?           @relation("DocumentFile")
  documentCoverOf    Document?           @relation("DocumentCover")
  comparisonLater    ArtworkComparison[] @relation("ComparisonLater")
  reportJob          ReportJob?          @relation("ReportOutput")
  kindergartenLogoOf Kindergarten?       @relation("KindergartenLogo")
  userPhotoOf        User?               @relation("UserPhoto")
  groupPhotoOf       Group?              @relation("GroupPhoto")

  @@index([childId, purpose, uploadedAt(sort: Desc)])
  @@index([kindergartenId, uploadedAt(sort: Desc)])
  @@index([observationId, order])
  @@index([notificationId, order])
  @@index([milestoneId, order])
  @@index([incidentId, order])
  @@index([status, deletedAt])
  /// ★ This does NOT serve the gallery's default sort, and the comment that
  /// claimed it did was wrong.
  ///
  /// `GALLERY_ORDER` leads with `order ASC` (the sequence a teacher arranged by
  /// hand), so Postgres sorts in memory whatever indexes exist — a
  /// `(childId, takenAt)` index cannot satisfy a sort whose leading key is
  /// something else. What it does buy is a date-ranged album: "photographs of
  /// this child taken in the spring term", which is the query `takenAt` was
  /// added to make possible. Drop it if that filter never ships.
  @@index([childId, takenAt(sort: Desc)])
  @@map("media_files")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  kindergartenId String             @db.Uuid
  title          String
  body           String
  startsOn       DateTime?          @db.Date
  endsOn         DateTime?          @db.Date
  isImportant    Boolean            @default(false)
  status         NotificationStatus @default(DRAFT)
  publishedAt    DateTime?
  authorId       String?            @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten           @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  author       User?                  @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  targets      NotificationTarget[]
  /// The incidents this notice reported — RFP Module 2.1. Plural because one
  /// notice may cover several children in the same event (a scuffle), and the
  /// record on each child must still point at how the family was told.
  incidents    SafetyIncident[]       @relation("IncidentNotification")
  reads        NotificationRead[]
  reactions    NotificationReaction[]
  media        MediaFile[]            @relation("NotificationMedia")

  @@index([kindergartenId, status, publishedAt(sort: Desc)])
  @@map("notifications")
}

/// Audience. Both `groupId` and `childId` NULL means the whole kindergarten.
model NotificationTarget {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  notificationId String  @db.Uuid
  groupId        String? @db.Uuid
  childId        String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  child        Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([groupId])
  @@index([childId])
  @@map("notification_targets")
}

/// Append-only read receipt. No soft delete — unreading is not a thing.
model NotificationRead {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt(sort: Desc)])
  @@map("notification_reads")
}

/// A "like" on an announcement.
///
/// ★ Reactions only. There is no comment model and there is not going to be
/// one: a class board where parents can reply is a moderation surface, and
/// nobody has been given the job of moderating it. A like says "seen and
/// appreciated" without creating anything a teacher has to police.
///
/// Soft-deleted rather than removed, per §3.2 — un-liking sets `deletedAt` and
/// liking again clears it, so the unique pair survives the round trip and the
/// history of who reacted is not silently rewritten.
model NotificationReaction {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  notificationId String @db.Uuid
  userId         String @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One reaction per person per notice. The toggle updates this row rather
  /// than inserting a second one.
  @@unique([notificationId, userId])
  @@index([notificationId, deletedAt])
  @@map("notification_reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reports and audit
// ─────────────────────────────────────────────────────────────────────────────

model ReportJob {
  id             String       @id @default(uuid()) @db.Uuid
  kindergartenId String       @db.Uuid
  childId        String?      @db.Uuid
  type           ReportType
  params         Json         @default("{}")
  requestedById  String?      @db.Uuid
  status         ReportStatus @default(QUEUED)

  progressPercent   Int     @default(0) @db.SmallInt
  resultMediaFileId String? @unique @db.Uuid
  fileSize          Int     @default(0)
  pageCount         Int     @default(0) @db.SmallInt
  errorMessage      String?

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  resultMedia  MediaFile?   @relation("ReportOutput", fields: [resultMediaFileId], references: [id], onDelete: SetNull)

  @@index([childId, requestedAt(sort: Desc)])
  @@index([kindergartenId, status, requestedAt(sort: Desc)])
  @@map("report_jobs")
}

/// ★ Append-only. The ONLY table with no soft delete, no `updatedAt` and no
/// authorship columns — a record that can be edited is not an audit record.
/// Enforced at the repository layer, which exposes only `append()`.
model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String? @db.Uuid
  actorUserId    String? @db.Uuid
  actorRole      String?
  /// The actor's name as plain text, so a deleted user's actions stay
  /// attributable.
  actorLabel     String?

  action     AuditAction
  objectType String?
  objectId   String?
  /// Set whenever child data was involved, so "who accessed this child's
  /// record" is one indexed query.
  childId    String?     @db.Uuid

  ipAddress String?
  userAgent String?
  metadata  Json    @default("{}")

  createdAt DateTime @default(now())

  kindergarten Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  child        Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([kindergartenId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
