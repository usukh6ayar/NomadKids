// NomadKids — MVP data model.
//
// Designed in docs/DATABASE.md; that document explains the reasoning and this
// file is its implementation. Where they disagree, the document is the intent
// and this file is the bug.
//
// Three conventions run through everything and matter more than they look:
//
//   1. `kindergartenId` is denormalised onto every tenant-scoped table even
//      where a relation could reach it. One WHERE clause then enforces tenant
//      isolation instead of a three-join traversal somebody eventually forgets.
//
//   2. `deletedAt` is a soft delete. Prisma has no equivalent of Django's
//      model manager, so EVERY query must filter it explicitly. That is why
//      `PrismaClient` is importable only from *.repository.ts — CLAUDE.md §2.2.
//
//   3. Authorization NEVER reads `Child.kindergartenId`. It resolves the
//      kindergarten set from Enrollment history, with exactly one documented
//      exception for a child that has no enrollments at all.
//      docs/SECURITY.md §5.2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — system-level values only.
//
// Anything an administrator can edit is a TABLE, not an enum: development
// domains, assessment levels and observation types are configuration and live
// in DevelopmentDomain / AssessmentLevel / ObservationType. Adding a value to
// one of the enums below is a code change by design.
// ─────────────────────────────────────────────────────────────────────────────

/// A person's standing in one kindergarten.
///
/// ★ Two staff roles joined on 2026-08-30 at the client's request, and what
/// they deliberately are *not* is the part worth writing down.
///
/// `TenantAccessService.assertStaff` means TEACHER or ADMIN and gates the
/// teacher's whole surface — writing notices, recording observations, reading a
/// child. Neither new role passes it. A cook needs the kitchen; an accountant
/// needs the ledger; giving either "staff" because both are employed here would
/// hand them every child's development record, which is the failure §1.1 exists
/// to make structurally impossible rather than merely unlikely.
///
/// Each new role gets its own narrow predicate instead — see
/// `assertCanManageMeals` and `assertCanReadFinance`.
enum Role {
  ADMIN
  TEACHER
  PARENT
  /// Тогооч — the kitchen and the weekly menu.
  COOK
  /// Нягтлан — the kindergarten's own funding, invoices and reconciliation.
  ///
  /// ★ Not the platform's. `/platform/revenue` is the operator's income across
  /// every kindergarten and stays behind `isSuperAdmin`; this role reads
  /// `/kindergartens/:id/funding`, which is one kindergarten's own money.
  ACCOUNTANT
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  INVITATION
}

enum EsisEnvironment {
  TEST
  PRODUCTION
}

enum EsisSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum AgeBand {
  NURSERY // Бага бүлэг
  JUNIOR // Дунд бүлэг
  MIDDLE // Ахлах бүлэг
  SENIOR // Бэлтгэл бүлэг
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

/// Which of the two preschool programmes a group runs.
///
/// ★ Order А/261, Annex 2 §1 items 5, 6, 13 and 14 — all four mandatory. The
/// order asks that children in the main programme and children in the
/// alternative one be registered separately, and item 14 settles where the
/// distinction belongs by asking for "хувилбарт сургалтын **бүлэг** бүрийг
/// бүртгэх": it is a property of the group, not of the child. So one column
/// here answers all four items, and a child's programme follows from the group
/// they are enrolled in.
enum ProgramKind {
  /// Үндсэн сургалт
  MAIN
  /// Хувилбарт сургалт — ger, mobile, shift and seasonal groups.
  ALTERNATIVE
}

/// The hours a group runs — Order А/261, Annex 2 §1 item 16, mandatory.
///
/// ★ Not the same thing as `AttendanceStatus.HALF_DAY`, and the difference is
/// worth stating because the words overlap. `HALF_DAY` is what happened on one
/// date; this is the arrangement the child is enrolled under. A kindergarten
/// with an extended-hours group answers "уртасгасан" here every day of the
/// year, including days when a particular child went home at noon.
///
/// On the group for the same reason as `ProgramKind`: Mongolian kindergartens
/// organise extended and shortened hours as groups. If a per-child arrangement
/// is ever needed, a column on `Enrollment` is an additive change; moving the
/// other way would lose data.
enum AttendanceForm {
  /// Энгийн
  STANDARD
  /// Уртасгасан цаг
  EXTENDED
  /// Богиносгосон цаг
  SHORTENED
}

enum TeacherRole {
  LEAD
  ASSISTANT
}

enum Sex {
  MALE
  FEMALE
}

/// A child's standing at the kindergarten.
///
/// ★ Four values because Order А/261 (2024-12-19), Annex 2 §1 item 7 — a
/// mandatory requirement — names four: "үргэлжлүүлэн суралцаж байгаа, түр
/// суралцаж байгаа, эсхүл чөлөөтэй болон идэвхгүй". This enum held two, so a
/// child on leave and a child who had left were recorded identically, and the
/// register could not answer a question the ministry asks of it.
///
/// `ARCHIVED` was renamed to `INACTIVE` rather than joined by it. The two words
/// meant the same thing — no longer attending — and keeping both would have
/// left the director choosing between synonyms on every form.
enum ChildStatus {
  /// Үргэлжлүүлэн суралцаж байгаа
  ACTIVE
  /// Түр суралцаж байгаа — a seasonal or short-term placement.
  TEMPORARY
  /// Чөлөөтэй — away with permission, still enrolled.
  ON_LEAVE
  /// Идэвхгүй — no longer attending. Formerly `ARCHIVED`.
  INACTIVE
}

enum GuardianRelation {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
  TRANSFERRED
  /**
   * A distinct outcome from ENDED/TRANSFERRED — the child completed the
   * programme rather than leaving mid-way or moving elsewhere. Added so a
   * parent-facing "Цэцэрлэгээс төгссөн" date can be real data instead of a
   * misleading reuse of the generic "this enrollment period ended".
   */
  GRADUATED

  /// ★ Order А/261, Annex 2 §1 item 9, mandatory: "Суралцагчийн анги дэвших
  /// болон давтан суралцах үйл ажиллагааг бүртгэх".
  ///
  /// Two values rather than one because the order names two activities and a
  /// director has to be able to tell them apart afterwards. Both mean "the
  /// year ended and the child carried on here", which is what separates them
  /// from TRANSFERRED — a move between groups inside one year — and from
  /// GRADUATED, where the child leaves.
  ///
  /// The outcome sits on the enrollment that *ended*, not on the one that
  /// opened, because it describes how that period finished. Reading the
  /// archive top to bottom then tells the whole story without joining rows.

  /// Анги дэвшсэн — the child moved up an age band.
  PROMOTED
  /// Давтан суралцсан — the child stayed at the same age band another year.
  REPEATED
}

enum ObservationSource {
  TEACHER
  PARENT
}

/// §5.4 — the teacher reviews what a parent submits.
///
/// A teacher's own observation is APPROVED on save: there is nobody above them
/// to approve it. There is deliberately no "not required" state — the parent
/// read filter is `visibleToParents AND APPROVED`, so a teacher observation in
/// any other state would be invisible to the family it was written for.
enum ReviewStatus {
  PENDING // parent-submitted, awaiting a teacher
  APPROVED
  RETURNED // teacher returned it with a note
}

enum MediaPurpose {
  CHILD_PHOTO
  OBSERVATION
  /// A photo on a class-board announcement. Not about one child, so the row
  /// carries no `childId` — the kindergarten scope is what protects it.
  NOTIFICATION
  REPORT_OUTPUT
  /// ★ Tenant-scoped images: a kindergarten's logo, a teacher's portrait, a
  /// group's class photo. Like NOTIFICATION they carry no `childId`, so the
  /// kindergarten scope is the only thing protecting them — and unlike the
  /// others they are not child data at all, which is why `MediaService`
  /// authorises them by membership rather than through `canAccessChild`.
  KINDERGARTEN_LOGO
  USER_PHOTO
  GROUP_PHOTO
  /// A photograph of a served dish, on `MenuDay.dishes` — Хоол үйлдвэрлэл.
  /// Same tenant-image reasoning: a dish photo is on the plain menu every
  /// family reads, not staff-only, so it joins this group rather than
  /// `DOCUMENT`'s. The dish itself is a JSON element with no row of its own,
  /// so nothing here points back at it beyond `kindergartenId` — the menu
  /// stores the `MediaFile.id`, not the other way around.
  MENU_DISH
  /// A PDF in the document library, and its cover image — RFP §9. Tenant
  /// material, not child data, so membership authorises them.
  DOCUMENT
  DOCUMENT_COVER
  /// A PDF or image supplied with a guardian's leave request. It is child data,
  /// not an album photograph, and therefore never appears in the gallery.
  ATTENDANCE_ATTACHMENT
  /// A photograph on a safety incident — RFP Module 2.1. Child data carrying
  /// `childId`, so `canAccessChild` governs it like an album photo.
  INCIDENT
  /// A photograph of a remembered first — RFP §4.5. Child data, so it is
  /// authorised through `canAccessChild` exactly like an album photo, and it
  /// deliberately does NOT join the tenant-image set above.
  MILESTONE
  /// A photograph attached to a chat message.
  ///
  /// ★★ It is **not** a tenant image, and that distinction is the whole
  /// security design of the feature. `TENANT_IMAGE_PURPOSES` is readable by
  /// anyone holding a membership in the file's kindergarten; a chat photograph
  /// belongs to one *room*. A guardian whose child is in group A holds a
  /// perfectly good membership and must not read a photograph posted in group
  /// B's room.
  ///
  /// So `MediaService` authorises it through `ChatAccessService` against the
  /// owning message's `roomKey` — the same authority that decides whether the
  /// message may be read, answering the same 404 (§1.7).
  CHAT_MESSAGE
}

/// Who a photograph came from — RFP §4.4, "багшийн, эцэг эхийн эсвэл хамтын".
///
/// Distinct from `uploadedById`, which records *which account* sent the bytes.
/// A teacher may upload a photograph a family brought in on a memory stick; the
/// attribution is PARENT and the uploader is the teacher.
enum MediaAttribution {
  TEACHER
  PARENT
  JOINT
}

enum MediaStatus {
  READY
  ARCHIVED
}

enum NotificationStatus {
  DRAFT
  PUBLISHED
}

/// What kind of notice this is — the client's own taxonomy, from the drawing
/// their board mock-up carries: Зарлал · Үйл ажиллагаа · Сургалт.
///
/// ★ An enum, not the `DevelopmentDomain` treatment.
///
/// CLAUDE.md §2.3 says anything an administrator can edit is a table. This is
/// not that: it is a fixed vocabulary the client drew, and the filter row on
/// the board is drawn from it — a kindergarten inventing a seventh category
/// would produce a chip row nobody designed. `OTHER` is the escape hatch every
/// enum in this schema keeps, so a notice that is none of the three is filed
/// honestly rather than as the nearest wrong one.
enum TermReportStatus {
  DRAFT
  FINAL
}

enum ReportType {
  /// The onboarding contract PDF — docs/CONTRACT_ONBOARDING.md step 4.
  ///
  /// Like FINANCE_REPORT it carries **no childId**, which is what keeps every
  /// `canAccessChild`-gated download path from ever serving one.
  CONTRACT
  CHILD_PORTFOLIO
  TERM_REPORT
  /// RFP §6.5 — the year's four terms compared, with per-domain progress and
  /// the teacher's closing judgement. §10.2 names seven report types; this is
  /// the third, and the one RFP §21.7 makes an acceptance criterion
  /// ("Улирлын болон нэгдсэн PDF тайлан зөв үүсдэг байх").
  ANNUAL_REPORT

  /// `нэмэлт.md` §16's reports as PDF — the only type with **no child**.
  ///
  /// ★ That absence is load-bearing, not incidental. Every child report path
  /// already opens with `if (!job || !job.childId) throw new NotFoundException()`,
  /// so a financial report is invisible to them by construction: it cannot be
  /// polled, listed or downloaded through an endpoint whose authorization is
  /// `canAccessChild`. Its own routes check `assertCanReadFinance` instead.
  ///
  /// Do not give this type a `childId` to make some listing simpler — that
  /// single change would expose a kindergarten's whole financial position to
  /// any guardian of the child it was pinned to.
  FINANCE_REPORT
}

enum ReportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  VIEW
  CREATE
  UPDATE
  DELETE
  RESTORE
  DOWNLOAD
  PERMISSION_CHANGE
  PASSWORD_RESET
  INVITE
  ACTIVATE
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity and access
// ─────────────────────────────────────────────────────────────────────────────

/// One login. Deliberately carries NO role column — the same person can be a
/// teacher in one kindergarten and a parent in another, so all authority comes
/// from Membership.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  email        String? @unique
  phone        String? @unique
  passwordHash String

  lastName  String
  firstName String

  /// Teacher-facing profile fields. Flattened from the reference system's
  /// near-empty TeacherProfile/GuardianProfile side tables.
  specialization String?
  education      String?
  bio            String?

  /// RFP §3.3 — профайл зураг. A MediaFile reference for the same reason as
  /// `Kindergarten.logoMediaFileId`.
  photoMediaFileId String? @unique @db.Uuid

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Platform-level operator: registers kindergartens.
  ///
  /// ★ Deliberately NOT a Membership role. Every authorization primitive in
  /// this system is tenant-derived, and a system-wide membership row has no
  /// kindergarten to point at — the reference implementation made
  /// `kindergarten` nullable to model it, which would put a null case into
  /// every `kindergartenId: { in: [...] }` filter we have. CLAUDE.md §3.1.
  ///
  /// Grants platform routes and nothing else. It is not consulted by
  /// TenantAccessService or ChildAccessService, and test/platform.test.ts
  /// asserts that a superadmin still gets 404 on child data.
  isSuperAdmin Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photo                 MediaFile?                @relation("UserPhoto", fields: [photoMediaFileId], references: [id], onDelete: SetNull)
  uploadedMedia         MediaFile[]               @relation("MediaUploader")
  memberships           Membership[]
  guardianships         Guardianship[]
  authTokens            AuthToken[]
  sessions              Session[]
  auditLogs             AuditLog[]
  observations          Observation[]             @relation("ObservationAuthor")
  reviewed              Observation[]             @relation("ObservationReviewer")
  assessments           Assessment[]              @relation("AssessmentAuthor")
  termReports           TermReport[]              @relation("TermReportAuthor")
  notifications         Notification[]            @relation("NotificationAuthor")
  reads                 NotificationRead[]
  reactions             NotificationReaction[]
  reportJobs            ReportJob[]
  attendanceRecorded    Attendance[]              @relation("AttendanceRecordedBy")
  attendanceRequested   AttendanceRequest[]       @relation("AttendanceRequestedBy")
  attendanceReviewed    AttendanceRequest[]       @relation("AttendanceReviewedBy")
  attendanceSubmitted   AttendanceSubmission[]    @relation("AttendanceSubmittedBy")
  menuDaysCreated       MenuDay[]                 @relation("MenuDayCreatedBy")
  menuDaysApproved      MenuDay[]                 @relation("MenuDayApprovedBy")
  ingredientsCreated    Ingredient[]              @relation("IngredientCreatedBy")
  recipesCreated        Recipe[]                  @relation("RecipeCreatedBy")
  recipesApproved       Recipe[]                  @relation("RecipeApprovedBy")
  foodOrdersCreated     FoodOrder[]               @relation("FoodOrderCreatedBy")
  stockMovementsCreated StockMovement[]           @relation("StockMovementCreatedBy")
  mealServingsRecorded  MealServing[]             @relation("MealServingRecordedBy")
  surveysCreated        Survey[]                  @relation("SurveyCreatedBy")
  surveyResponses       SurveyResponse[]          @relation("SurveyRespondent")
  growthRecorded        GrowthMeasurement[]       @relation("GrowthRecordedBy")
  milestonesRecorded    Milestone[]               @relation("MilestoneRecordedBy")
  allergiesRecorded     AllergyRecord[]           @relation("AllergyRecordedBy")
  specialNeedsRecorded  SpecialNeedRecord[]       @relation("SpecialNeedRecordedBy")
  staffRecords          StaffRecord[]             @relation("StaffRecordSubject")
  staffRecordsCreated   StaffRecord[]             @relation("StaffRecordCreatedBy")
  medicationsAuthorised MedicationAuthorisation[] @relation("MedicationAuthorisedBy")
  vaccinationsRecorded  VaccinationRecord[]       @relation("VaccinationRecordedBy")
  incidentsRecorded     SafetyIncident[]          @relation("IncidentRecordedBy")
  artworkComparisons    ArtworkComparison[]       @relation("ComparisonAuthor")
  documentsPublished    Document[]                @relation("DocumentPublishedBy")
  documentBookmarks     DocumentBookmark[]        @relation("DocumentBookmarkUser")
  consentsDecided       ConsentRecord[]           @relation("ConsentDecidedBy")
  mealsRecorded         MealRecord[]              @relation("MealRecordedBy")
  paymentsRecorded      Payment[]                 @relation("PaymentRecordedBy")
  qpayInvoicesInitiated QpayInvoice[]             @relation("QpayInvoiceInitiatedBy")
  applicationsReviewed  KindergartenApplication[] @relation("ApplicationReviewer")
  chatMessages          ChatMessage[]             @relation("ChatAuthor")
  chatReads             ChatRead[]                @relation("ChatReader")
  esisSyncRuns          EsisSyncRun[]             @relation("EsisSyncInitiator")

  @@index([deletedAt])
  @@map("users")
}

/// ★ The only source of authority in the system.
///
/// A user's role is not global; it is held per kindergarten. Every
/// authorization decision starts here.
model Membership {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  kindergartenId String  @db.Uuid
  role           Role
  /// Revocation without deletion — the record of the relationship survives.
  isActive       Boolean @default(true)

  startedOn DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  assignments  GroupTeacher[]

  @@unique([userId, kindergartenId, role])
  @@index([userId, isActive])
  @@index([kindergartenId, role, isActive])
  @@map("memberships")
}

/// Opaque refresh-token family. One row per active browser session.
///
/// The token itself is never stored — only its SHA-256. `familyId` groups the
/// rotations of one login so that presenting an already-rotated token (the
/// signature of a stolen cookie) can revoke the whole family at once.
model Session {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  familyId  String @db.Uuid
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens for password reset and invitation. Merged from two
/// reference tables that had identical mechanics (D6).
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  /// SHA-256 of the token. The token itself exists only in the email.
  tokenHash String           @unique

  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Brute-force lockout counter: 5 failures per identifier in 15 minutes.
///
/// `identifier` is free text, not a foreign key — failures against a
/// non-existent username must count too, or the lockout becomes a user
/// enumeration oracle.
///
/// ★ Rows must be written OUTSIDE any interactive transaction. A failed login
/// often runs inside a request that then errors; rolled back with it, the
/// counter silently resets and the lockout never fires. docs/SECURITY.md §2.
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  ipAddress  String?
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, succeeded, createdAt])
  @@index([ipAddress, succeeded, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

model Kindergarten {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  address     String?
  phone       String?
  email       String?
  description String?
  isActive    Boolean @default(true)

  /// The ESIS institution this tenant is allowed to read.
  ///
  /// Set only through the platform-operator route. A kindergarten admin may
  /// start a preview only when this value matches the deployment credential's
  /// institution id, preventing one tenant from reading another tenant's
  /// roster through a shared integration token.
  esisInstitutionId String?          @unique
  esisEnvironment   EsisEnvironment?
  esisMappedAt      DateTime?

  /// ★ RFP §3.2 (лого) and §10.3, which requires the logo on every generated
  /// PDF.
  ///
  /// A MediaFile reference, NOT a URL column. CLAUDE.md §1.4: files are never
  /// directly reachable, so there is no address a `logo String` could hold that
  /// this system is allowed to hand out. The column mirrors
  /// `Child.photoMediaFileId` exactly — one image pattern, not two.
  logoMediaFileId String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  logo                   MediaFile?                @relation("KindergartenLogo", fields: [logoMediaFileId], references: [id], onDelete: SetNull)
  memberships            Membership[]
  schoolYears            SchoolYear[]
  groups                 Group[]
  groupTeachers          GroupTeacher[]
  children               Child[]
  guardianships          Guardianship[]
  enrollments            Enrollment[]
  childProfiles          ChildProfile[]
  childAgeProfiles       ChildAgeProfile[]
  birthdayNotes          BirthdayNote[]
  developmentDomains     DevelopmentDomain[]
  curriculumIndicators   CurriculumIndicator[]
  assessmentLevels       AssessmentLevel[]
  observationTypes       ObservationType[]
  terms                  Term[]
  observations           Observation[]
  observationDomains     ObservationDomain[]
  assessments            Assessment[]
  termReports            TermReport[]
  mediaFiles             MediaFile[]
  notifications          Notification[]
  notificationTargets    NotificationTarget[]
  notificationReactions  NotificationReaction[]
  reportJobs             ReportJob[]
  auditLogs              AuditLog[]
  attendanceRecords      Attendance[]
  attendanceSubmissions  AttendanceSubmission[]
  attendanceRequests     AttendanceRequest[]
  menuDays               MenuDay[]
  surveys                Survey[]
  surveyQuestions        SurveyQuestion[]
  surveyResponses        SurveyResponse[]
  surveyAnswers          SurveyAnswer[]
  growthMeasurements     GrowthMeasurement[]
  milestones             Milestone[]
  allergies              AllergyRecord[]
  specialNeedsCategories SpecialNeedsCategory[]
  specialNeeds           SpecialNeedRecord[]
  staffRecords           StaffRecord[]
  medications            MedicationAuthorisation[]
  vaccinations           VaccinationRecord[]
  safetyIncidents        SafetyIncident[]
  artworkComparisons     ArtworkComparison[]
  documents              Document[]
  documentBookmarks      DocumentBookmark[]
  consents               ConsentRecord[]
  mealRecords            MealRecord[]
  ingredients            Ingredient[]
  recipes                Recipe[]
  suppliers              Supplier[]
  foodOrders             FoodOrder[]
  stockMovements         StockMovement[]
  mealServings           MealServing[]
  fundingRules           FundingRule[]
  fundingCalculations    FundingCalculation[]
  invoices               Invoice[]
  payments               Payment[]
  qpayInvoices           QpayInvoice[]
  accessSubscriptions    AccessSubscription[]
  applications           KindergartenApplication[]
  contracts              Contract[]
  chatMessages           ChatMessage[]
  chatReads              ChatRead[]
  esisSyncRuns           EsisSyncRun[]

  @@index([deletedAt])
  @@map("kindergartens")
}

/// One operator-initiated ESIS read-only preview.
///
/// The result stores counts and safe error categories only. Remote roster
/// rows are returned to the authorised administrator for the current request
/// but are not persisted here; importing them requires a separate approval
/// workflow and external-id mapping.
model EsisSyncRun {
  id             String         @id @default(uuid()) @db.Uuid
  kindergartenId String         @db.Uuid
  initiatedById  String         @db.Uuid
  status         EsisSyncStatus @default(RUNNING)
  resources      Json
  summary        Json?
  errorCode      String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  initiatedBy  User         @relation("EsisSyncInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)

  @@index([kindergartenId, startedAt])
  @@index([status, startedAt])
  @@map("esis_sync_runs")
}

model SchoolYear {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  /// e.g. "2025-2026"
  name           String
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  isCurrent      Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten        Kindergarten         @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  groups              Group[]
  enrollments         Enrollment[]
  terms               Term[]
  childAgeProfiles    ChildAgeProfile[]
  accessSubscriptions AccessSubscription[]

  @@unique([kindergartenId, name])
  @@index([kindergartenId, isCurrent])
  @@map("school_years")
}

model Group {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  schoolYearId   String @db.Uuid
  name           String

  /// How many *children* this group aims to document each month — the client's
  /// "Энэ сарын зорилт", 2026-09-10.
  ///
  /// ★ Children, not notes, and the distinction is the whole point.
  ///
  /// The card reads "20 хүүхдийн хөгжлийн явцыг баримтжуулах" and "14 / 20
  /// хүүхэд". A goal counted in notes is met by writing twenty about one child;
  /// this one is only met by reaching twenty different children.
  ///
  /// ★★ On the group rather than the kindergarten, and that is what lets the
  /// teacher set it (client, 2026-09-10: "багш өөрөө сонгох"). It lived on
  /// `Kindergarten` for one day, which would have meant one teacher's decision
  /// silently changing every other group's target — the same defect as the
  /// `localStorage` version it replaced, one level up.
  ///
  /// NULL is "no goal set", which is the default. The screen draws no goal card
  /// rather than inventing a target nobody agreed to.
  monthlyNoteGoal          Int?
  /// How many notes each targeted child should receive in the month.
  monthlyNotesPerChildGoal Int?
  ageBand                  AgeBand
  status                   GroupStatus @default(ACTIVE)

  /// Order А/261, Annex 2 §1 items 5, 6, 13, 14 and 16. Both default to the
  /// ordinary case, so every group that existed before this migration is a
  /// main-programme, standard-hours group — which is what they were.
  programKind    ProgramKind    @default(MAIN)
  attendanceForm AttendanceForm @default(STANDARD)

  /// RFP §3.2 — ангийн зураг, хичээлийн хуваарь, бүлгийн дүрэм.
  ///
  /// The schedule and the rules are free text rather than structured columns.
  /// The RFP asks that they be *recorded and shown*, not queried or enforced,
  /// and a timetable modelled as rows would be a feature nobody specified.
  photoMediaFileId String? @unique @db.Uuid
  schedule         String?
  rules            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photo                 MediaFile?             @relation("GroupPhoto", fields: [photoMediaFileId], references: [id], onDelete: SetNull)
  kindergarten          Kindergarten           @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  schoolYear            SchoolYear             @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  teachers              GroupTeacher[]
  enrollments           Enrollment[]
  chatMessages          ChatMessage[]
  notificationTargets   NotificationTarget[]
  attendanceSubmissions AttendanceSubmission[]
  surveys               Survey[]               @relation("SurveyGroup")
  documents             Document[]             @relation("DocumentGroup")
  mealServings          MealServing[]

  @@unique([schoolYearId, name])
  @@index([kindergartenId, status])
  @@map("groups")
}

/// ★ The teacher half of the authorization graph.
///
/// Points at Membership, not User, so it is structurally impossible to assign a
/// teacher to a group in a kindergarten where they hold no membership.
///
/// Access is revoked by setting `endedOn`, never by deleting the row — the
/// record of who taught whom has to survive.
model GroupTeacher {
  id             String      @id @default(uuid()) @db.Uuid
  kindergartenId String      @db.Uuid
  groupId        String      @db.Uuid
  membershipId   String      @db.Uuid
  role           TeacherRole @default(LEAD)

  startedOn DateTime? @db.Date
  endedOn   DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([groupId, membershipId])
  @@index([membershipId, endedOn])
  @@map("group_teachers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Children
// ─────────────────────────────────────────────────────────────────────────────

model Child {
  id String @id @default(uuid()) @db.Uuid

  /// ★ "Currently attending" — for listing and filtering ONLY.
  ///
  /// This is NOT an authorization input. Reading it to decide access would
  /// mean a teacher loses the observations they wrote themselves the moment a
  /// child transfers. Authorization resolves the kindergarten set from
  /// Enrollment history. docs/SECURITY.md §5.2.
  kindergartenId String @db.Uuid

  lastName    String
  firstName   String
  nationalId  String?
  sex         Sex
  dateOfBirth DateTime    @db.Date
  status      ChildStatus @default(ACTIVE)

  /// Гадаад иргэн — a child who is not a Mongolian citizen.
  ///
  /// ★ A flag rather than a citizenship/country field, and that is deliberate.
  ///
  /// The question the kindergarten actually answers is "does this child have a
  /// Mongolian регистр": `nationalId` matches `^[А-ЯӨҮ]{2}\d{8}$`, which a
  /// foreign child has no way to satisfy, so registration used to force staff
  /// to leave it blank with nothing on the record saying why. A country column
  /// would be a second, richer fact nobody has asked for and nobody would fill
  /// in consistently — and the state reports this feeds (Order А/261) count
  /// foreign children, they do not break them down by nationality.
  ///
  /// `foreignId` carries whatever identifier they do have — a passport number,
  /// a residence permit — as free text, because its shape is not ours to
  /// validate.
  isForeign Boolean @default(false)
  foreignId String?

  healthNotes String?

  photoMediaFileId String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten        Kindergarten              @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  photo               MediaFile?                @relation("ChildPhoto", fields: [photoMediaFileId], references: [id], onDelete: SetNull)
  guardianships       Guardianship[]
  enrollments         Enrollment[]
  profile             ChildProfile?
  ageProfiles         ChildAgeProfile[]
  birthdayNotes       BirthdayNote[]
  observations        Observation[]
  assessments         Assessment[]
  termReports         TermReport[]
  mediaFiles          MediaFile[]               @relation("ChildMedia")
  notificationTargets NotificationTarget[]
  reportJobs          ReportJob[]
  auditLogs           AuditLog[]
  attendanceRecords   Attendance[]
  attendanceRequests  AttendanceRequest[]
  surveyResponses     SurveyResponse[]
  growthMeasurements  GrowthMeasurement[]
  milestones          Milestone[]
  allergies           AllergyRecord[]
  specialNeeds        SpecialNeedRecord[]
  medications         MedicationAuthorisation[]
  vaccinations        VaccinationRecord[]
  safetyIncidents     SafetyIncident[]
  artworkComparisons  ArtworkComparison[]
  accessSubscriptions AccessSubscription[]
  consents            ConsentRecord[]
  mealRecords         MealRecord[]
  fundingCalculations FundingCalculation[]
  invoices            Invoice[]

  @@unique([kindergartenId, nationalId])
  @@index([kindergartenId, status])
  @@index([kindergartenId, lastName, firstName])
  @@index([kindergartenId, dateOfBirth])
  @@map("children")
}

/// ★ The parent half of the authorization graph.
///
/// `canView = false` revokes a parent's access while preserving the record of
/// the relationship — needed for custody changes. Never delete a guardianship
/// to revoke access.
model Guardianship {
  id             String           @id @default(uuid()) @db.Uuid
  kindergartenId String           @db.Uuid
  childId        String           @db.Uuid
  guardianUserId String           @db.Uuid
  relation       GuardianRelation
  isPrimary      Boolean          @default(false)
  canView        Boolean          @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian     User         @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@unique([childId, guardianUserId])
  @@index([guardianUserId, canView])
  @@index([childId])
  @@map("guardianships")
}

/// ★ The child's history, and the authoritative answer to "which kindergartens
/// may see this child".
///
/// Rows are ended, never deleted.
model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  kindergartenId String           @db.Uuid
  childId        String           @db.Uuid
  groupId        String           @db.Uuid
  schoolYearId   String           @db.Uuid
  startedOn      DateTime         @db.Date
  endedOn        DateTime?        @db.Date
  status         EnrollmentStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten       Kindergarten        @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child              Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  group              Group               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  schoolYear         SchoolYear          @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  observations       Observation[]
  assessments        Assessment[]
  termReports        TermReport[]
  attendanceRecords  Attendance[]
  attendanceRequests AttendanceRequest[]
  mealRecords        MealRecord[]

  @@index([groupId, status])
  @@index([schoolYearId, status])
  @@index([childId, schoolYearId])
  @@index([childId, status])
  @@map("enrollments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Portfolio
// ─────────────────────────────────────────────────────────────────────────────

/// "Миний тухай" — one per child.
model ChildProfile {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @unique @db.Uuid

  introduction         String?
  nameMeaning          String?
  memorableSayings     String?
  dream                String?
  distinguishingTraits String?

  /// Added 2026-08-28, on the client's instruction — not in RFP §4.1's own
  /// field list, which stops at `distinguishingTraits` above.
  clanName   String?
  nickname   String?
  birthplace String?
  bloodType  String?
  eyeColor   String?

  /// A guardian's own pick, overriding `birthFacts()`'s computed answer for
  /// §4.2's "Монгол жилийн амьтан" and "Өрнийн орд" — added the same day, on
  /// the same instruction, after the client asked specifically for the
  /// picker back having first agreed the computed version should stand.
  /// `code`, not the Mongolian name, matching `YEAR_ANIMALS`/`ZODIAC_SIGNS`
  /// in `@kinder/contracts`'s `birth-facts.ts` — validated against that same
  /// list on write, so a stored value can never fail the lookup that resolves
  /// it to a name. Null means "no override" — `birthFacts()` still answers
  /// until a guardian actually picks something.
  yearAnimalCode String?
  zodiacCode     String?

  heightCm   Decimal?  @db.Decimal(5, 1)
  weightKg   Decimal?  @db.Decimal(5, 2)
  recordedOn DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("child_profiles")
}

/// One row per child per age, 2 to 5. `age` is validated in the service layer;
/// Postgres has no cheap way to express "2..5" that Prisma can model portably.
model ChildAgeProfile {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  childId        String  @db.Uuid
  age            Int     @db.SmallInt
  schoolYearId   String? @db.Uuid

  favoriteColor    String?
  favoriteFood     String?
  favoriteToy      String?
  favoriteBook     String?
  favoriteSong     String?
  favoriteStory    String?
  favoriteActivity String?
  favoriteClothes  String?
  favoriteMovie    String?
  favoriteTreat    String?

  personality      String?
  emotionalTraits  String?
  familyMembers    String?
  dream            String?
  learningInterest String?
  newSkills        String?

  /// Structured parent observations added without replacing the legacy text
  /// columns above. Keeping both preserves every existing age-profile row.
  kindergartenSkills     String[] @default([])
  kindergartenSkillNotes Json     @default("{}")
  kindergartenOtherSkill String?
  familyLearningSkills   String[] @default([])
  familyLearningNotes    Json     @default("{}")
  familyLearningOther    String?
  characterTraits        String[] @default([])
  characterObservation   String?
  familyMemberTypes      String[] @default([])
  familyDescription      String?

  parentNote  String?
  teacherNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear?  @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@unique([childId, age])
  @@index([childId, age])
  @@map("child_age_profiles")
}

model BirthdayNote {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  childId        String  @db.Uuid
  age            Int     @db.SmallInt
  note           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, age])
  @@map("birthday_notes")
}

/// A remembered first — RFP §4.5, "Онцгой үйл явдал".
///
/// ★ `kind` is a free string with a suggested vocabulary, not an enum and not a
/// configuration table.
///
/// The RFP names seven (анхны алхам, анхны үг, анх цэцэрлэгт орсон өдөр …) and
/// then explicitly asks for "хэрэглэгчийн өөрөө үүсгэсэн үйл явдал" — a family
/// inventing their own. An enum cannot hold the eighth without a migration; a
/// configuration table would make an administrator curate a list that belongs
/// to one family's memory. CLAUDE.md §2.3 binds on what an *administrator*
/// edits, and this is not that. The suggestions live in `packages/contracts` so
/// the form and the API label them identically, and a custom value stores the
/// family's own words.
///
/// ★★ Deliberately NOT an `Observation` with a special type.
///
/// An observation is a teacher's professional record: it carries a development
/// domain, an assessment level, a review status and a next-steps plan, and it
/// stays invisible to a family until approved. A milestone is a memory, usually
/// written by that family, which needs none of that and must never wait for
/// review to appear in the child's own portfolio.
model Milestone {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  childId        String   @db.Uuid
  /// One of `MILESTONE_KINDS`, or `CUSTOM` when the family named their own.
  kind           String
  /// The family's own words. Required for CUSTOM; elsewhere it overrides the
  /// suggested label.
  title          String?
  occurredOn     DateTime @db.Date
  description    String?

  /// Who recorded it — usually a guardian. `User.id`, matching
  /// `Observation.authorId`, so it reads correctly across a role change.
  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("MilestoneRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  media        MediaFile[]  @relation("MilestoneMedia")

  /// ★ No unique constraint on (childId, kind), deliberately: a child has one
  /// first step, but "анх тайзан дээр гарсан" happens again every year and a
  /// family may want both. The timeline is the ordering that matters.
  @@index([childId, occurredOn(sort: Desc)])
  @@index([kindergartenId, occurredOn(sort: Desc)])
  @@map("milestones")
}

// ─────────────────────────────────────────────────────────────────────────────
// Health — RFP Module 2: allergies, medication, vaccination
//
// ★ Three tables, not one "health record" with a `type` column.
//
// They answer different questions, are written by different people, and have
// different lifetimes. An allergy is standing information a teacher must see
// before every meal; a medication authorisation is a dated instruction that
// expires; a vaccination is a historical fact that never changes. A single
// table with a discriminator would give all three the union of their columns
// and none of their constraints — `dosage` meaningless on a vaccination,
// `severity` meaningless on a dose of antibiotics.
//
// ★★ `Child.healthNotes` stays. It is RFP §3.4's free-text "анхаарах
// шаардлагатай товч мэдээлэл" and remains the right home for anything that is
// not one of these three. What it cannot do is be *queried* — which is what
// the menu cross-check needs, and why AllergyRecord exists.
// ─────────────────────────────────────────────────────────────────────────────

/// How badly a child reacts — RFP Module 2 asks for a "Red Flag / Badge".
///
/// A system-level enum rather than a configuration table: this drives an alert
/// a teacher must read the same way in every kindergarten, and a director
/// renaming SEVERE to something reassuring is not a customisation anybody
/// should be offered. CLAUDE.md §2.3's carve-out for "record states".
enum AllergySeverity {
  MILD
  MODERATE
  /// Anaphylaxis risk. The badge is red and the menu check refuses to be quiet.
  SEVERE
}

enum AllergyKind {
  FOOD
  MEDICATION
  ENVIRONMENTAL
  OTHER
}

/// One allergy — RFP Module 2, "Харшил ба Хоолны онцлог".
model AllergyRecord {
  id             String          @id @default(uuid()) @db.Uuid
  kindergartenId String          @db.Uuid
  childId        String          @db.Uuid
  kind           AllergyKind
  severity       AllergySeverity

  /// What the child reacts to, as staff would say it: "самар", "сүү", "өндөг".
  ///
  /// ★ Free text, and matched case-insensitively against a menu dish's
  /// `allergenTags`. Not a lookup table: the RFP gives no vocabulary, kitchens
  /// name ingredients in their own words, and a closed list would make a
  /// teacher unable to record the one allergy their child actually has.
  allergen String

  /// What happens, and what to do about it. Both free text — this is clinical
  /// information transcribed from a family, not something to model.
  reaction  String?
  treatment String?

  /// Ended rather than deleted: a child who outgrows a milk allergy still has
  /// the record of having had one, and a teacher reading the history needs it.
  notedOn DateTime  @db.Date
  endedOn DateTime? @db.Date

  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("AllergyRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// The badge query: every live allergy for one child.
  @@index([childId, endedOn])
  /// The menu cross-check: every live allergy in one kindergarten, at once.
  @@index([kindergartenId, endedOn])
  @@map("allergy_records")
}

/// The special-needs classification — Order А/261, kindergarten criterion 11.
///
/// ★ A table, not a TypeScript enum, because CLAUDE.md §2.3 says so and this
/// is the case the rule exists for: the ministry's category list is theirs to
/// revise, and a revision must not be a deployment. `kindergartenId = NULL`
/// rows are the system list every kindergarten inherits; a kindergarten may
/// add its own without touching them. Same shape and the same partial unique
/// index as `ObservationType`, which this deliberately mirrors rather than
/// inventing a second pattern for the same job.
///
/// ★★ Not `AllergyRecord`'s free-text `allergen` treatment, and the reason is
/// the opposite of that one's. An allergen is matched against whatever a cook
/// typed on a dish, so a closed list would make a real allergy unrecordable.
/// A special-needs category is *reported to the state*, which counts them —
/// free text would give every kindergarten its own spelling of the same
/// category and make the aggregate meaningless.
model SpecialNeedsCategory {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String? @db.Uuid
  name           String
  code           String
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten?       @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  records      SpecialNeedRecord[]

  @@unique([kindergartenId, code])
  @@index([kindergartenId, isActive, order])
  @@map("special_needs_categories")
}

/// One child's recorded special need.
///
/// ★ `endedOn` rather than a delete, for `AllergyRecord`'s reason: a need that
/// no longer applies is part of the child's history, and the teacher reading
/// back through it needs to know the support was once in place.
///
/// ★★ `documentNo` is free text and nullable. The commission decision that
/// establishes a category has a number, but a kindergarten is often told the
/// category before the paperwork reaches them — requiring it would mean the
/// child's actual need goes unrecorded until an office posts a form.
model SpecialNeedRecord {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  categoryId     String @db.Uuid

  /// What support this child actually needs, in the staff's own words. The
  /// category says which kind; this says what to do on Monday morning.
  note       String?
  documentNo String?

  assessedOn DateTime  @db.Date
  endedOn    DateTime? @db.Date

  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten         @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child                @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// Restrict: a category with children recorded against it cannot be deleted
  /// out from under them — the same guard `RecipeIngredient` puts on
  /// `Ingredient`.
  category     SpecialNeedsCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("SpecialNeedRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// The child's health screen: every live need for one child.
  @@index([childId, endedOn])
  /// The state return: every live need in one kindergarten, counted by category.
  @@index([kindergartenId, endedOn])
  @@index([categoryId])
  @@map("special_need_records")
}

/// What kind of thing a `StaffRecord` records.
///
/// ★ An enum, not a table, and that is §2.3's line rather than an exception to
/// it: "anything an administrator can edit is a table; system-level values may
/// be enums". These three are the *shape* of the record — an experience row has
/// a date range and an employer, a qualification row has an issuer and an
/// expiry — so adding a fourth is a schema change and a form, not a row an
/// administrator types. `SpecialNeedsCategory` beside it is the opposite case
/// and is a table for the opposite reason.
enum StaffRecordKind {
  /// Ажлын туршлага — a post held, here or elsewhere.
  EXPERIENCE
  /// Гэрчилгээ — a certificate, licence or award.
  CERTIFICATE
  /// Боловсрол, зэрэг — a degree or a professional grade (заслагч, тэргүүлэх…).
  QUALIFICATION
}

/// A member of staff's experience, certificates and grades — Order А/261,
/// criterion 51.
///
/// ★ **Rows against `User`, not a new `Staff` model.**
///
/// The compliance note asked for "тусдаа `Staff` модель", and a second model
/// for a person the system already has would be the mistake, not the fix: a
/// teacher is a `User` with a `Membership`, and every screen, every audit row
/// and every authorization path already says so. A parallel `Staff` table would
/// need its own identity, its own link back to the login, and its own answer to
/// "which of these two names is right" — for the sake of three lists that hang
/// off a person.
///
/// ★★ **`kindergartenId` as well as `userId`** (§3.1). A certificate belongs to
/// the person, but the *record* belongs to the kindergarten that collected it
/// and reports it to the ministry: it is their return to file, their
/// administrator who typed it, and their business only. A teacher who moves
/// takes the paper and the new kindergarten records it themselves, which is
/// also what happens off-screen.
///
/// ★★★ One table with a `kind` rather than three. The three share every column
/// that matters — a title, an issuer, a date range, a document number — and the
/// screen is one list a reader scans in one pass. Three tables would be three
/// repositories, three authorization paths and three migrations to add the
/// field all of them turn out to need.
model StaffRecord {
  id             String          @id @default(uuid()) @db.Uuid
  kindergartenId String          @db.Uuid
  userId         String          @db.Uuid
  kind           StaffRecordKind

  /// The post, the certificate's name, the degree. Required — a record with no
  /// title is a row nobody can read back.
  title      String
  /// Where it came from: the employer for EXPERIENCE, the awarding body
  /// otherwise. Free text, because the state keeps no register we can validate
  /// against.
  issuer     String?
  /// Гэрчилгээний дугаар, дипломын дугаар.
  documentNo String?
  note       String?

  /// ★ `startedOn` is required and `endedOn` is not, so "2019 оноос одоог
  /// хүртэл" is expressible. A certificate uses `startedOn` as its issue date
  /// and `endedOn` as its expiry — which is what makes "renewal due" a query
  /// against one column rather than a rule per kind.
  startedOn DateTime  @db.Date
  endedOn   DateTime? @db.Date

  createdById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  /// Cascade: the records describe this person and mean nothing without them.
  user         User         @relation("StaffRecordSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("StaffRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// One person's file, newest first.
  @@index([userId, kindergartenId, startedOn(sort: Desc)])
  /// The kindergarten's own return — every certificate it has on file, and the
  /// expiry sweep that asks which lapse this term.
  @@index([kindergartenId, kind, endedOn])
  @@map("staff_records")
}

/// A guardian's instruction to give medicine — RFP Module 2, "Эм хэрэглээний
/// зөвшөөрөл".
///
/// ★ An authorisation, not an administration log.
///
/// The RFP asks that a parent leaves a form "цаг, тунг тэмдэглэж
/// баталгаажуулан" and that the teacher is reminded at the time. That is a
/// standing instruction with a date range, which is what this models. Recording
/// each individual dose as it is given is a separate feature the RFP does not
/// ask for, and inventing it would put a nurse's medication chart inside a
/// portfolio system.
model MedicationAuthorisation {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid

  medicineName String
  /// "1 шахмал", "5 мл" — the family's own words, transcribed.
  dosage       String
  /// Times of day as `HH:MM` strings, e.g. `["12:00", "16:30"]`.
  ///
  /// ★ Json rather than a `MedicationTime` child table. The RFP wants a
  /// reminder at each time; nothing queries "every child due at 12:00 across
  /// the kindergarten", and a table for an array of two strings is a join for
  /// no reader.
  timesOfDay   Json
  instructions String?

  startsOn DateTime @db.Date
  /// ★ Required, unlike an allergy's `endedOn`.
  ///
  /// An open-ended authorisation to medicate a child is not something a system
  /// should be able to express. A family renews it; it does not run for ever
  /// because somebody forgot to close it.
  endsOn   DateTime @db.Date

  /// The guardian who left the instruction — this is the consent record.
  authorisedById String @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  authorisedBy User         @relation("MedicationAuthorisedBy", fields: [authorisedById], references: [id], onDelete: Restrict)

  /// "What is due today" — a range scan over the active window.
  @@index([kindergartenId, startsOn, endsOn])
  @@index([childId, endsOn(sort: Desc)])
  @@map("medication_authorisations")
}

/// A vaccination or vitamin — RFP Module 2, "Вакцинжуулалт болон Амин дэмийн
/// бүртгэл".
model VaccinationRecord {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  childId        String   @db.Uuid
  /// Free text: the national schedule changes, and a kindergarten also records
  /// vitamins the RFP names in the same breath.
  vaccineName    String
  administeredOn DateTime @db.Date
  /// "2-р тун" — optional, because a single-dose vitamin has none.
  doseLabel      String?
  /// Where it was given: a clinic name, or the kindergarten itself.
  provider       String?
  note           String?

  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("VaccinationRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([childId, administeredOn(sort: Desc)])
  @@map("vaccination_records")
}

/// What happened — RFP Module 2.1's "Тохиолдлын төрөл".
///
/// An enum rather than a configuration table: this is a fixed clinical
/// vocabulary a kindergarten reports against, not a preference. `OTHER` carries
/// what the list does not, with the description doing the work — the same
/// escape hatch `AttendanceStatus` keeps.
enum IncidentKind {
  INJURY // Гэмтэл
  FALL // Уналт
  BRUISE // Хөхрөлт
  SCRATCH // Маажилт
  BITE // Хазуулсан
  ALLERGIC_REACTION // Харшлын шинж
  FEVER // Халууралт
  ILLNESS // Толгой/хэвлий өвдөх
  OTHER
}

/// A safety or health incident — RFP Module 2.1, "Аюулгүй байдлын тэмдэглэл".
///
/// ★ Not an `Observation`, and not a `Notification`.
///
/// An observation is a developmental note a teacher writes to build a picture
/// over a term; this is an event with a time, a body part and a first-aid
/// response, which a family must be told about today. A notification is the
/// delivery mechanism, and one is created *from* an incident when it is
/// reported — but a notification has no `bodyPart`, no follow-up and no
/// priority, and folding the record into the message would lose the record the
/// moment the message was read.
model SafetyIncident {
  id             String       @id @default(uuid()) @db.Uuid
  kindergartenId String       @db.Uuid
  childId        String       @db.Uuid
  kind           IncidentKind

  /// ★ A timestamp, not a date. Module 2.1 asks for "Огноо, цаг" together, and
  /// "which of the two falls this afternoon" is a question a parent asks.
  occurredAt DateTime

  /// Where in the kindergarten — "тоглоомын талбай", "хоолны өрөө".
  location    String?
  /// Which part of the body. Free text: a closed list of anatomy is a medical
  /// system, and staff write what they saw.
  bodyPart    String?
  description String
  /// "Авсан анхан шатны арга хэмжээ" — what was done at the time.
  firstAid    String?
  /// "Дараагийн хяналт" — what still needs watching.
  followUp    String?

  /// ★★ High priority is a flag, not a severity scale.
  ///
  /// Module 2.1 asks for one thing: mark the serious ones **High Priority** and
  /// alert management and the family immediately. A three-level scale would
  /// invite a middle value meaning "somewhat urgent", which nobody acts on.
  isHighPriority Boolean @default(false)

  /// The staff member who recorded it. Nullable so the row survives the account
  /// being deleted, which is the same trade `Observation.authorId` makes.
  recordedById String? @db.Uuid

  /// Set when the family has been told, and by which notice. Null means
  /// recorded and **not yet reported** — the state the review screen exists to
  /// surface.
  reportedAt     DateTime?
  notificationId String?   @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten  @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?         @relation("IncidentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  notification Notification? @relation("IncidentNotification", fields: [notificationId], references: [id], onDelete: SetNull)
  media        MediaFile[]   @relation("IncidentMedia")

  @@index([childId, occurredAt(sort: Desc)])
  /// The kindergarten's incident log.
  @@index([kindergartenId, occurredAt(sort: Desc)])
  /// The unreported queue: high-priority first, still awaiting a family.
  @@index([kindergartenId, isHighPriority, reportedAt])
  @@map("safety_incidents")
}

/// Two works, side by side, with what changed between them — RFP §5.3.
///
/// ★ Only the *conclusion* is new. Everything else §5.3 asks for already
/// exists: several artwork photographs per observation (`MediaFile.
/// observationId`, capped at twelve), a date on each (`takenAt`), a caption on
/// each, and the whole set orderable in time. What the schema could not hold
/// was the sentence a teacher writes about the change — "долоо хоногийн дараа
/// хүн зурахдаа гар, хөлийг тусад нь зурсан" — and that sentence is the
/// feature. So this table is a pair of pointers and a paragraph, not a copy of
/// the images.
///
/// ★★ Two works, not N.
///
/// §5.3 says "өмнөх болон дараагийн бүтээлийг зэрэгцүүлэн харах" — the previous
/// and the next, side by side. A set of arbitrary size would need an ordering
/// table and an answer to "what does a conclusion about five drawings mean",
/// and neither is asked for. A teacher comparing three works makes two
/// comparisons, which is also how they would say it out loud.
model ArtworkComparison {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid

  /// ★★★ Ordered by the service, not by the caller.
  ///
  /// A teacher who picks the two works in the wrong order would otherwise get a
  /// comparison that reads as development running backwards. The service sorts
  /// them by when the work was made before storing, so `earlier` is always
  /// earlier — see `ArtworkService.compare`.
  earlierMediaId String @db.Uuid
  laterMediaId   String @db.Uuid

  /// "Хөгжлийн өөрчлөлтийн дүгнэлт" — the reason the row exists.
  conclusion String

  /// The teacher whose judgement this is. A comparison is a professional
  /// reading of a child's development, so it carries an author the way an
  /// observation does.
  authorId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  earlierMedia MediaFile    @relation("ComparisonEarlier", fields: [earlierMediaId], references: [id], onDelete: Cascade)
  laterMedia   MediaFile    @relation("ComparisonLater", fields: [laterMediaId], references: [id], onDelete: Cascade)
  author       User?        @relation("ComparisonAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt(sort: Desc)])
  @@map("artwork_comparisons")
}

// ─────────────────────────────────────────────────────────────────────────────
// Document library — RFP §9
// ─────────────────────────────────────────────────────────────────────────────

/// A PDF in the kindergarten's library — RFP §9.
///
/// ★ Kindergarten-scoped, not child data. It is staff reference material —
/// curricula, methodology, regulations — so `MediaService` authorises the file
/// by membership, exactly as it does a logo, and `canAccessChild` never runs.
///
/// ★★ `version` replaces rather than accumulates.
///
/// §9 asks for "Баримт шинэ хувилбараар солих" — replace with a new version —
/// and a `version` string on one row is what that means. A separate
/// `DocumentVersion` table would be the right model for "show me last year's
/// curriculum", which §9 does not ask for and which nobody has requested.
model Document {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  title          String
  /// Free text — §9 says "Ангилал" and gives no vocabulary, and a kindergarten
  /// files by its own headings. Filtered on exactly, not fuzzily.
  category       String?
  description    String?
  /// "Хувилбар" — e.g. "2026.1". A label, not an ordering key.
  ///
  /// ★ No longer offered by the publish form as of 2026-09-06 — the client
  /// asked for it to go ("хувилбар гэдэг нь хэрэггүй арилга"). The column
  /// stays: `POST /documents/:id/file` writes it when a PDF is replaced, which
  /// is the one place a version label is a fact rather than something somebody
  /// typed, and existing rows carry values a delete would destroy.
  version        String?

  /// Which group's teachers this document is for — NULL means all staff.
  ///
  /// ★ Added 2026-09-06, at the client's request: "захирал pdf оруулахад
  /// багшийн нэрээр нь биш бүлгээр нь choose хийнэ, тэгээд зөвхөн тэр багш руу
  /// нь л явна".
  ///
  /// By group and not by teacher, which is the client's own distinction and
  /// the right one: a teacher is assigned to a group and assignments change, so
  /// a document addressed to a person would follow them out of the group and
  /// would not follow their replacement in. `GroupTeacher` already answers
  /// "who teaches this group" on every request (§1.3), so this stays correct
  /// without anybody re-filing anything.
  ///
  /// NULL is every group, the same convention `Survey.groupId` uses — a
  /// document for all staff keeps reaching a teacher hired next month.
  /// Administrators see every document regardless: they are the ones filing.
  groupId String? @db.Uuid

  /// The PDF itself. Required: a library entry with no document is a title.
  fileMediaFileId  String  @unique @db.Uuid
  /// "Нүүр зураг" — optional cover image.
  coverMediaFileId String? @unique @db.Uuid

  publishedAt   DateTime @default(now())
  publishedById String?  @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten       @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  file         MediaFile          @relation("DocumentFile", fields: [fileMediaFileId], references: [id], onDelete: Restrict)
  cover        MediaFile?         @relation("DocumentCover", fields: [coverMediaFileId], references: [id], onDelete: SetNull)
  publishedBy  User?              @relation("DocumentPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  group        Group?             @relation("DocumentGroup", fields: [groupId], references: [id], onDelete: Restrict)
  bookmarks    DocumentBookmark[]

  @@index([kindergartenId, category])
  /// A teacher's library: their groups' documents, plus the kindergarten's.
  @@index([kindergartenId, groupId])
  @@index([kindergartenId, publishedAt(sort: Desc)])
  @@map("documents")
}

/// One person's bookmark — RFP §9's "Bookmark хийсэн эсэх".
///
/// ★ A join table rather than a boolean on `Document`, because the flag is
/// per-*reader*: a column would make one teacher's bookmark appear on every
/// colleague's list, which is the opposite of what a bookmark is.
model DocumentBookmark {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  documentId     String @db.Uuid
  userId         String @db.Uuid

  createdAt DateTime @default(now())

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user         User         @relation("DocumentBookmarkUser", fields: [userId], references: [id], onDelete: Cascade)

  /// One bookmark per person per document. No soft delete: un-bookmarking is
  /// not a fact anybody needs to recover.
  @@unique([documentId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("document_bookmarks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Consent — RFP §16
// ─────────────────────────────────────────────────────────────────────────────

/// What a family is being asked to agree to — RFP §16.
///
/// ★ Two kinds, because §16 asks for two separate things: "Эцэг эхээс мэдээлэл
/// ашиглах зөвшөөрөл авах" and, in its own sentence, "Зураг нийтлэх зөвшөөрлийг
/// тусад нь бүртгэх" — photo publishing recorded *separately*. A single
/// "consented: true" would make refusing photographs mean refusing the system.
enum ConsentKind {
  /// Using the child's information in the system at all.
  DATA_PROCESSING
  /// Publishing the child's photographs beyond the family — RFP §16.
  PHOTO_PUBLISHING
}

/// One guardian's decision, with the date it was made.
///
/// ★ Rows are never updated to reverse a decision — a new row supersedes.
///
/// Consent is a legal record: "we had permission on the day we published" is
/// the question it exists to answer, and an `UPDATE` that flipped a boolean
/// would destroy exactly that. `decidedAt` orders them and the latest wins.
model ConsentRecord {
  id             String      @id @default(uuid()) @db.Uuid
  kindergartenId String      @db.Uuid
  childId        String      @db.Uuid
  kind           ConsentKind
  granted        Boolean

  /// The guardian who decided. Not nullable: an unattributed consent record is
  /// not evidence of anything.
  decidedById String   @db.Uuid
  decidedAt   DateTime @default(now())
  /// What they were shown, so a later dispute can establish what was agreed.
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  decidedBy    User         @relation("ConsentDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  /// The current answer: latest row per child per kind.
  @@index([childId, kind, decidedAt(sort: Desc)])
  @@index([kindergartenId, kind])
  @@map("consent_records")
}

/// Which sitting — `нэмэлт.md` §2.
enum MealKind {
  BREAKFAST // Өглөөний цай
  /// Added 2026-08-28, on the client's instruction — нэмэлт.md §2 names four
  /// sittings; a fifth, between breakfast and lunch, is this one.
  MID_MORNING_SNACK // Жүүс
  LUNCH // Өдрийн хоол
  AFTERNOON_SNACK // Их үдийн цай
  EXTRA // Оройн хоол
}

/// Whether the child ate — `нэмэлт.md` §2.
enum MealStatus {
  TAKEN // Авсан
  NOT_TAKEN // Аваагүй
  PARTIAL // Хэсэгчлэн
  SPECIAL // Тусгай хоол
}

/// One child, one day, one sitting — `нэмэлт.md` §2.
///
/// ★ Separate from `Attendance`, and that separation is the point.
///
/// §17 states the governing principle: a fact is recorded once and reused. It
/// would be tempting to infer "ate lunch" from "was present", and §3 shows why
/// that fails — the food cost is computed from **hooллосон өдөр**, days the
/// child actually ate, which is not the same as days they attended. A child
/// present on a half day, or collected before lunch, attended and did not eat.
/// Deriving one from the other would make the cost calculation silently wrong.
///
/// ★★ Anchored to `Enrollment` like `Attendance`, for the same reason: a meal
/// served in January belongs to whichever kindergarten served it, and a
/// transfer must not rewrite that.
model MealRecord {
  id             String     @id @default(uuid()) @db.Uuid
  kindergartenId String     @db.Uuid
  childId        String     @db.Uuid
  enrollmentId   String     @db.Uuid
  date           DateTime   @db.Date
  kind           MealKind
  status         MealStatus
  note           String?

  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("MealRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// One row per enrollment per day per sitting. Replaced by a **partial**
  /// unique index in the migration — same reasoning as `Attendance`: Postgres
  /// treats NULLs as distinct, so the plain form would let a soft-deleted row
  /// block its own sitting for ever.
  @@unique([enrollmentId, date, kind])
  /// The group's day sheet: every child, one date.
  @@index([kindergartenId, date])
  /// A child's month, and the "days eaten" count a cost calculation needs.
  @@index([childId, date])
  @@map("meal_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Funding and food cost — нэмэлт.md §3, §4, §5
// ─────────────────────────────────────────────────────────────────────────────

/// Where the money comes from — нэмэлт.md §3's "эх үүсвэрээр салгаж харуулна".
enum FundingSource {
  STATE // Улсын санхүүжилт
  PARENT // Эцэг эхийн төлбөр
  KINDERGARTEN // Цэцэрлэгийн санхүүжилт
  OTHER // Бусад эх үүсвэр
}

/// A tariff and the conditions it applies under — нэмэлт.md §5.
///
/// ★ §4 is explicit: "Санхүүжилтийн тариф болон дүрмийг source code-д тогтмол
/// бичихгүй. Администратор тохиргоогоор өөрчлөх боломжтой байна." So this is a
/// table, like `DevelopmentDomain` and `AssessmentLevel`, and for a sharper
/// reason than either: a rate hard-coded in TypeScript would need a deployment
/// to follow a government circular, and the wrong rate applied for a month is a
/// reconciliation nobody can undo cleanly.
///
/// ★★ Rules are **superseded, never edited**, once they have been used.
///
/// A month's calculation is evidence — "this is the rate we billed under" — and
/// editing the rate that produced it rewrites the past. `effectiveFrom` and
/// `effectiveTo` bound each one; a new rate is a new row starting the day the
/// old one ends. That is why the calculation stores its own `dailyRate` too.
model FundingRule {
  id             String        @id @default(uuid()) @db.Uuid
  kindergartenId String        @db.Uuid
  name           String
  source         FundingSource

  effectiveFrom DateTime  @db.Date
  /// Null means "still in force". A rule is closed by setting this, not deleted.
  effectiveTo   DateTime? @db.Date

  /// Which children it applies to. Null means every age.
  ageBand AgeBand?

  /// The money, in **tögrög**, as `Decimal` — never a float.
  ///
  /// A binary float cannot hold 0.1 exactly, and a month's funding is a sum of
  /// thousands of these; the error is small per row and visible in a total that
  /// has to reconcile against a bank statement.
  dailyRate   Decimal? @db.Decimal(12, 2)
  monthlyRate Decimal? @db.Decimal(12, 2)

  /// §5's "Ирцээс хамаарах эсэх" and "Хоолны хэрэглээнээс хамаарах эсэх".
  ///
  /// These decide which counter the daily rate multiplies: days attended, days
  /// fed, or neither (a flat monthly charge). Both false with a `monthlyRate`
  /// is the flat case.
  dependsOnAttendance Boolean @default(true)
  dependsOnMeals      Boolean @default(false)

  /// Which invoice line a `PARENT`-source rule produces — `нэмэлт.md` §7.
  ///
  /// ★ One tariff table serves both sides, which is §17's single-entry
  /// principle applied to configuration rather than to data.
  ///
  /// A rule with `source = PARENT` already means "what the family owes"; §6's
  /// monthly calculation totals it as "Эцэг эхээс авах төлбөр". An invoice
  /// needs the same number broken out by what it is *for* — tuition, meals,
  /// the bus — and this column is that one missing fact. A second tariff table
  /// beside this one would be a second place to change a price, and the two
  /// would disagree within a term.
  ///
  /// Null on `STATE`, `KINDERGARTEN` and `OTHER` rules, which never bill a
  /// parent. A `PARENT` rule without it is not used for invoicing.
  ///
  /// ★ Retyped from the merged-away `InvoiceItemKind` to `InvoiceLineType`
  /// (2026-09-01). The two enums carried identical values; only the surviving
  /// invoice implementation's name differs.
  invoiceItemKind InvoiceLineType?

  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten        Kindergarten         @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  fundingCalculations FundingCalculation[]

  /// "Which rules were in force in March" — the calculation's own lookup.
  @@index([kindergartenId, source, effectiveFrom])
  @@map("funding_rules")
}

/// What a child's funding worked out to for one month — нэмэлт.md §6.
///
/// ★ The inputs are stored alongside the result, not just referenced.
///
/// `daysAttended`, `daysFed` and `dailyRate` are copied onto the row at
/// calculation time. Recomputing them later from the live tables would answer a
/// different question the moment an attendance correction lands — and §6's
/// state machine (Draft → Submitted → Approved → Paid → Reconciled) exists
/// precisely because an approved figure must stay the figure that was approved.
model FundingCalculation {
  id             String        @id @default(uuid()) @db.Uuid
  kindergartenId String        @db.Uuid
  childId        String        @db.Uuid
  source         FundingSource
  /// The month this covers, as its first day.
  month          DateTime      @db.Date

  daysAttended  Int
  daysFed       Int
  /// The rate actually applied — see the note above.
  dailyRate     Decimal? @db.Decimal(12, 2)
  /// The rule that produced it, for tracing. Nullable so a deleted rule does
  /// not take the calculation with it.
  fundingRuleId String?  @db.Uuid

  /// Тооцсон дүн — what the rule computes.
  calculatedAmount Decimal  @db.Decimal(12, 2)
  /// Баталгаажсан дүн — what was approved, once it is.
  approvedAmount   Decimal? @db.Decimal(12, 2)
  /// Хүлээн авсан дүн — what actually arrived.
  receivedAmount   Decimal? @db.Decimal(12, 2)

  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  fundingRule  FundingRule? @relation(fields: [fundingRuleId], references: [id], onDelete: SetNull)

  /// One calculation per child per month per source, among live rows.
  @@unique([childId, month, source])
  @@index([kindergartenId, month])
  @@map("funding_calculations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Parent invoices and payments — нэмэлт.md §7, §8
// ─────────────────────────────────────────────────────────────────────────────

/// нэмэлт.md §7's six payment types — one line item per type actually charged
/// on an invoice.
enum InvoiceLineType {
  TUITION // Сургалтын төлбөр
  MEAL // Хоолны мөнгө
  CLUB // Дугуйлан
  BUS // Автобус
  EXTRA // Нэмэлт үйлчилгээ
  OTHER // Бусад
}

/// нэмэлт.md §8's five states — what payment (or its absence) has done to an
/// invoice so far. `PAID`/`PARTIALLY_PAID`/`UNPAID`/`OVERDUE` are derived by
/// `InvoicesRepository.recomputeTotals()` every time a payment is recorded or
/// voided; `REFUNDED` is set explicitly (`InvoicesService.markRefunded`) —
/// "the balance nets to zero" and "money was actually returned to a parent"
/// are different facts, and only a person can tell the two apart.
enum InvoiceStatus {
  UNPAID // Төлөгдөөгүй
  PARTIALLY_PAID // Хэсэгчлэн төлсөн
  PAID // Төлсөн
  OVERDUE // Хугацаа хэтэрсэн
  REFUNDED // Буцаалт
}

/// One child's bill for one month — нэмэлт.md §7.
///
/// ★ The four charge columns are a frozen snapshot, not a live sum.
///
/// Same rule as `FundingCalculation` (`docs/reference/FINANCE_SCOPE.md` §4.3):
/// once issued, an invoice reads the same way it did when the parent received
/// it. A correction replaces `lineItems` and recomputes these columns —
/// `InvoicesService.generate` refuses to do that once any live payment exists
/// (`docs/reference/нэмэлт.md` §14 — money that has moved needs a reversal,
/// not a rewritten bill). `totalDue`, `paidAmount`, `balance` and `status` are
/// the exception: they change as payments come in, by design.
model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  childId        String   @db.Uuid
  /// The month this bills for, as its first day — same convention as
  /// `FundingCalculation.month`.
  month          DateTime @db.Date

  /// Үндсэн төлбөр — this invoice's TUITION lines, summed.
  baseAmount      Decimal  @default(0) @db.Decimal(12, 2)
  /// Хоолны төлбөр — its MEAL lines, summed.
  mealAmount      Decimal  @default(0) @db.Decimal(12, 2)
  /// Нэмэлт төлбөр — everything else (CLUB/BUS/EXTRA/OTHER), summed.
  extraAmount     Decimal  @default(0) @db.Decimal(12, 2)
  /// Хөнгөлөлт — stored positive, subtracted when `totalDue` is computed.
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  /// Өмнөх үлдэгдэл — the previous invoice's unpaid balance, carried forward.
  previousBalance Decimal  @default(0) @db.Decimal(12, 2)
  /// Нийт төлөх дүн — base + meal + extra + previousBalance − discount,
  /// frozen at generation time.
  totalDue        Decimal  @db.Decimal(12, 2)
  /// Төлсөн дүн — the sum of every `Payment.amount` against this invoice,
  /// original and reversal rows alike (a reversal's negative amount is what
  /// makes a voided payment net to zero — see `Payment`). Kept as a real
  /// column, not derived per read, because `status` is derived from it and a
  /// status the UI filters and sorts by has to be a real column too.
  paidAmount      Decimal  @default(0) @db.Decimal(12, 2)
  /// Үлдэгдэл — totalDue − paidAmount, recomputed in the same transaction as
  /// every payment or void (`InvoicesRepository.recomputeTotals`).
  balance         Decimal  @db.Decimal(12, 2)
  /// Төлөх хугацаа.
  dueDate         DateTime @db.Date

  status InvoiceStatus @default(UNPAID)
  note   String?

  /// The human-readable number a parent quotes on a transfer — `нэмэлт.md` §7.
  ///
  /// Format `2026-000042`, generated by `nextInvoiceNumber` inside the same
  /// transaction that writes the invoice. Unique within a kindergarten and
  /// **never reused**: the lookup that finds the last number deliberately does
  /// not filter `deletedAt`, so voiding an invoice retires its number with it.
  ///
  /// Nullable because the rows that existed before this column did not have
  /// one, not because a new invoice may go without.
  number String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten      @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  lineItems    InvoiceLineItem[]
  payments     Payment[]

  /// One invoice per child per month, among live rows — mirrors
  /// `FundingCalculation`'s own `@@unique([childId, month, source])`.
  @@unique([childId, month])
  @@unique([kindergartenId, number])
  @@index([kindergartenId, month])
  @@index([kindergartenId, status])
  @@map("invoices")
}

/// One charge on an invoice — нэмэлт.md §7's six payment types, one row per
/// type actually billed that month.
model InvoiceLineItem {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @db.Uuid
  type        InvoiceLineType
  description String?
  amount      Decimal         @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// How a payment moved — нэмэлт.md §8's four gateways, plus cash.
///
/// ★ `QPAY`/`SOCIALPAY` are valid values now so the ledger's shape never needs
/// a migration to widen it, even though nothing can create one yet — no
/// gateway integration exists in this codebase (confirmed: no inbound webhook
/// anywhere in `apps/api/src`). `InvoicesController`'s manual-recording route
/// only accepts `CASH`/`BANK_TRANSFER`/`OTHER` until that lands.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QPAY
  SOCIALPAY
  OTHER
}

/// One movement of money against an invoice — нэмэлт.md §7/§8.
///
/// ★ Reversed, never deleted, once it is real. `нэмэлт.md` §14, verbatim:
/// "Баталгаажсан санхүүгийн гүйлгээг шууд устгахгүй. Залруулга эсвэл reversal
/// transaction ашиглана." This is stricter than CLAUDE.md §3.2's ordinary soft
/// delete — a `deletedAt` here would make real money vanish from every report
/// while the fact that it moved stays true.
///
/// Voiding inserts a **second row** instead: negative `amount`,
/// `reversalOfId` pointing at the original. `paidAmount` on `Invoice` is
/// always `SUM(amount)` over every live row for it, unconditionally — the
/// reversal's negative amount is what cancels the original in that sum, not a
/// `WHERE voidedAt IS NULL` clause that would have to also touch the original.
/// `voidedAt` on the original is therefore purely a display/guard field ("this
/// was reversed, on this date, do not reverse it twice") — it is never part of
/// the sum. Both rows stay visible forever, which is the whole point.
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  kindergartenId   String        @db.Uuid
  invoiceId        String        @db.Uuid
  /// Negative on a reversal row; positive on every other one.
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  /// The gateway's own transaction id — set for QPAY/SOCIALPAY, null for a
  /// manually recorded CASH/BANK_TRANSFER/OTHER payment.
  gatewayReference String?
  recordedById     String?       @db.Uuid
  note             String?

  /// Set on the original row the moment it is voided. Never set on a
  /// reversal row. Guards against voiding the same payment twice.
  voidedAt     DateTime?
  /// Set only on a reversal row, pointing at the payment it cancels.
  reversalOfId String?   @db.Uuid

  /// The gateway's own confirmation body, as returned by `checkPayment` — kept
  /// for disputes (`нэмэлт.md` §14).
  ///
  /// ★ Never parsed for business logic. The amount credited comes from the
  /// frozen `QpayInvoice.amount`, and the decision to credit at all comes from
  /// `payment_status` in a response this system fetched itself. This column is
  /// evidence, not input — the moment it is read to decide something, a forged
  /// callback becomes a free invoice again.
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  reversalOf   Payment?     @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    Payment[]    @relation("PaymentReversal")

  @@index([invoiceId])
  @@index([kindergartenId, createdAt])
  @@map("payments")
}

/// One attempt to pay an `AccessSubscription` through QPay's v2 "Simple" API.
/// See `docs/reference/QPAY_INTEGRATION.md` for the full flow.
///
/// ★ A pending *attempt*, not a settled fact. A QR code nobody has scanned yet
/// is not money, so it gets a row of its own rather than a subscription that
/// claims to be half-paid. `AccessSubscription.status` moves to `ACTIVE` only
/// once `QpayService.reconcile()` has independently confirmed the payment
/// against QPay's own check API — never from the callback's request body,
/// which this schema does not even carry a field for.
///
/// `amount` is frozen at creation, so a QR already in a parent's hand cannot
/// silently change value if the deployment's fee is changed underneath it.
///
/// ★★ Never deleted — a cancelled or expired attempt is a fact too, so
/// `status` moves to `EXPIRED`/`CANCELLED` in place rather than the row
/// disappearing.
model QpayInvoice {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  /// ★ Points at an `AccessSubscription`, not a kindergarten `Invoice`.
  ///
  /// Repointed 2026-09-01 on the client's instruction: "QPay-ийг зөвхөн эцэг
  /// эхчүүдээс энэхүү website-ийг ашиглах эрхийг нээхийн тулд мөнгө авна. Өөр
  /// зүйлд QPay ашиглахгүй." A family's tuition and meal bills are still
  /// invoiced and still settled — by cash or transfer, recorded by the
  /// accountant — but never through this gateway.
  subscriptionId String  @db.Uuid
  amount         Decimal @db.Decimal(12, 2)

  /// QPay's own id for this invoice — what the callback and the check API
  /// both key on.
  qpayInvoiceId   String  @unique
  /// Our reference, sent as `sender_invoice_no` — see `QpayClient.createInvoice`.
  senderInvoiceNo String  @unique
  qrText          String?
  /// The base64 PNG QPay returns inline — no object-storage round trip for a
  /// code that expires with the invoice it was drawn for.
  qrImage         String? @db.Text

  status QpayInvoiceStatus @default(PENDING)

  /// Who pressed "pay" — audit's "Хэн" for a credit that, once it happens, is
  /// triggered by an unauthenticated webhook rather than a logged-in request.
  createdById String? @db.Uuid

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kindergarten Kindergarten       @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  subscription AccessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("QpayInvoiceInitiatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([kindergartenId, status])
  @@map("qpay_invoices")
}

/// нэмэлт.md §8's five invoice states, narrowed to what a single attempt can
/// actually be — `Invoice.status` (UNPAID/PARTIALLY_PAID/...) already covers
/// the bill as a whole; this is only ever PENDING → PAID, or PENDING →
/// EXPIRED/CANCELLED without ever reaching PAID.
enum QpayInvoiceStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

/// Whether one child's family may use the portal for one school year.
enum AccessSubscriptionStatus {
  /// Raised, not yet paid. The family sees the unlock screen and nothing else.
  UNPAID
  /// Paid and inside its school year.
  ACTIVE
  /// The school year it was bought for has ended.
  EXPIRED
}

/// One child's portal access for one school year — the only thing QPay is used
/// for (client, 2026-09-01).
///
/// ★ **This is a gate on a family's view of their own child.** It is not
/// authorization in the sense the rest of `authz/` means: a guardian who has
/// not paid is the right person asking about the right child, and the answer
/// is "not yet", not "no such child". That is why the refusal is **402**, not
/// the 404 `docs/SECURITY.md` §1.7 requires everywhere else — 404 exists to
/// avoid confirming a record's existence, and a parent already knows their own
/// child exists. Returning 404 here would be a lie that costs the parent the
/// one action that fixes it.
///
/// ★★ Priced per deployment, not per kindergarten (`ACCESS_FEE_AMOUNT`). One
/// QPay merchant serves every kindergarten, so a per-kindergarten price would
/// be money landing in one account against prices set in many places.
///
/// `amount` is frozen at issue: a price change must not rewrite what a family
/// was already asked for.
model AccessSubscription {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  schoolYearId   String @db.Uuid

  amount Decimal                  @db.Decimal(12, 2)
  status AccessSubscriptionStatus @default(UNPAID)

  paidAt    DateTime?
  /// Copied from the school year's own end date at issue, so shortening a
  /// school year later cannot retroactively cut access somebody paid for.
  expiresAt DateTime  @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten  @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child         @relation(fields: [childId], references: [id], onDelete: Restrict)
  schoolYear   SchoolYear    @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  qpayInvoices QpayInvoice[]

  /// One subscription per child per school year.
  @@unique([childId, schoolYearId])
  @@index([kindergartenId, status])
  @@map("access_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Growth — RFP §7
// ─────────────────────────────────────────────────────────────────────────────

/// One height/weight measurement — RFP §7.1.
///
/// ★ A time series, and `ChildProfile.heightCm` stays where it is.
///
/// Those two columns answer RFP §4.1: the height and weight printed in "Миний
/// тухай", one pair, edited in place, part of a portfolio page. This table
/// answers §7.2, which asks for a chart over time and a comparison with the
/// previous measurement — questions a single overwritten pair cannot answer at
/// all. Folding §4.1 into this table would delete the portfolio's own field;
/// folding this into §4.1 would delete every measurement but the last.
///
/// ★★ Anchored to `Child`, not to `Enrollment`.
///
/// Attendance hangs off an enrollment because a day of attendance belongs to
/// whichever kindergarten the child attended that day. A child's height belongs
/// to the child: it is the same body before and after a transfer, and a growth
/// chart that reset on moving kindergarten would be worse than useless. The
/// kindergarten column is the denormalised tenant scope every table carries
/// (CLAUDE.md §3.1), recording who took the measurement, not who owns the fact.
model GrowthMeasurement {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  childId        String   @db.Uuid
  measuredOn     DateTime @db.Date

  /// 30..200 cm, validated in the service. `Decimal(5,1)` matches
  /// `ChildProfile.heightCm` — one shape for one quantity.
  heightCm Decimal? @db.Decimal(5, 1)
  /// 2..100 kg, matching `ChildProfile.weightKg`.
  weightKg Decimal? @db.Decimal(5, 2)

  /// RFP §7.1 — "толгойн тойрог шаардлагатай бол". Optional in the RFP's own
  /// words, and rarely taken after infancy.
  headCircumferenceCm Decimal? @db.Decimal(4, 1)

  note String?

  /// Who took it. `User.id` rather than `Membership.id`, matching
  /// `Observation.authorId` — it reads correctly across a role change.
  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("GrowthRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// ★ One measurement per child per day, enforced by a **partial** unique
  /// index in the migration — the same treatment `Attendance` gets, for the
  /// same reason: Postgres treats NULLs as distinct, so a plain constraint
  /// would let a soft-deleted row block its own date for ever.
  ///
  /// One a day is the right grain: a nurse re-measuring after a bad reading is
  /// correcting the same measurement, not adding a second one, and a chart with
  /// two points on one date has no defined order.
  @@unique([childId, measuredOn])
  /// The chart: always a range scan over one child, newest first.
  @@index([childId, measuredOn(sort: Desc)])
  @@index([kindergartenId, measuredOn(sort: Desc)])
  @@map("growth_measurements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuration — administrator-editable, therefore tables and not enums
//
// `kindergartenId = NULL` means a system default shared by every kindergarten.
// A kindergarten admin may create and edit their own rows; they may NOT edit a
// system row — they create an override instead.
// ─────────────────────────────────────────────────────────────────────────────

model DevelopmentDomain {
  id             String  @id @default(uuid()) @db.Uuid
  /// NULL = system default, visible to all kindergartens.
  kindergartenId String? @db.Uuid
  name           String
  code           String
  order          Int     @default(0)
  color          String  @default("#94a3b8")
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten         Kindergarten?         @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  observationDomains   ObservationDomain[]
  assessments          Assessment[]
  curriculumIndicators CurriculumIndicator[]

  @@unique([kindergartenId, code])
  @@index([kindergartenId, isActive, order])
  @@map("development_domains")
}

model AssessmentLevel {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String? @db.Uuid
  /// 1..4 — "Дэмжлэгтэй" … "Давсан"
  value          Int     @db.SmallInt
  label          String
  color          String  @default("#94a3b8")
  description    String?
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten       Kindergarten?       @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  observationDomains ObservationDomain[]
  assessments        Assessment[]

  @@unique([kindergartenId, value])
  @@index([kindergartenId, isActive, order])
  @@map("assessment_levels")
}

/// A development indicator of the national preschool curriculum — СҮД.
///
/// ★ A table, and system rows rather than per-kindergarten configuration.
///
/// Seven strands, seventy-one indicators, each written out at up to four
/// levels — the client's own spreadsheet, transcribed in `prisma/curriculum.ts`.
/// It is a national standard: a kindergarten may add its own indicator beside
/// these (`kindergartenId`) but may not edit the ones the ministry wrote, which
/// is exactly what `DevelopmentDomain` and `AssessmentLevel` already do.
///
/// ★★ The code is the identity a teacher reads — "НСХ1а" — and it is stable
/// across levels: `НСХ1а` at level II and at level IV are the same indicator
/// described twice, which is why the level text is a row of its own rather
/// than four columns here.
model CurriculumIndicator {
  id             String  @id @default(uuid()) @db.Uuid
  /// NULL is the national standard; a value is one kindergarten's own addition.
  kindergartenId String? @db.Uuid
  domainId       String  @db.Uuid
  /// "НСХ1а" — the prefix names the strand, the digit and letter the indicator.
  code           String
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten?              @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  domain       DevelopmentDomain          @relation(fields: [domainId], references: [id], onDelete: Restrict)
  levels       CurriculumIndicatorLevel[]
  observations Observation[]

  @@unique([kindergartenId, code])
  @@index([domainId, isActive, order])
  @@map("curriculum_indicators")
}

/// One indicator as it is written at one level.
///
/// ★ A row per level, not four columns, and an absent level is meaningful.
///
/// Several indicators begin at level II or III because the behaviour does not
/// exist earlier — the source leaves those cells empty and so does this table.
/// Four nullable columns would store the same fact and invite a screen to draw
/// an empty card where "this indicator starts at III" is the honest answer.
model CurriculumIndicatorLevel {
  id          String @id @default(uuid()) @db.Uuid
  indicatorId String @db.Uuid
  /// 1–4, matching `AssessmentLevel.value`.
  level       Int    @db.SmallInt
  text        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  indicator CurriculumIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, level])
  @@map("curriculum_indicator_levels")
}

model ObservationType {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String? @db.Uuid
  name           String
  code           String
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@unique([kindergartenId, code])
  @@index([kindergartenId, isActive, order])
  @@map("observation_types")
}

// ─────────────────────────────────────────────────────────────────────────────
// Observation and assessment
// ─────────────────────────────────────────────────────────────────────────────

model Observation {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  /// Pins the observation to the group and school year it was written in, so a
  /// later transfer does not rewrite history.
  enrollmentId   String @db.Uuid
  typeId         String @db.Uuid

  source     ObservationSource @default(TEACHER)
  observedOn DateTime          @db.Date

  activityName String?

  /// The curriculum indicator this note evidences — СҮД код, 2026-09-11.
  ///
  /// ★ Optional, because a note is not always an assessment.
  ///
  /// A teacher writing down what happened at the water table has something
  /// worth keeping whether or not it maps onto an indicator, and requiring one
  /// would make the quick note the slowest thing on the screen. When it is
  /// there it is what turns a note into evidence, which is what the term
  /// report reads.
  indicatorId    String? @db.Uuid
  /// Which of the indicator's levels the teacher judged — 1–4, matching
  /// `AssessmentLevel.value`. Meaningless without `indicatorId` and written
  /// with it.
  indicatorLevel Int?    @db.SmallInt

  situation      String?
  childDid       String?
  childSaid      String?
  teacherComment String?
  nextSteps      String?

  /// ★ Defaults to FALSE. A teacher's working note is private until deliberately
  /// shared. Filtering on this is enforced server-side, never in the client.
  visibleToParents Boolean @default(false)
  includeInReport  Boolean @default(true)

  /// Domain authorship, not audit data. Needed at query time: a guardian may
  /// edit their own submission before it is approved, and always sees their own
  /// pending note — otherwise they cannot tell whether it saved.
  authorId String? @db.Uuid

  reviewStatus ReviewStatus @default(APPROVED)
  reviewedById String?      @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten         @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child                @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  type         ObservationType      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  indicator    CurriculumIndicator? @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  author       User?                @relation("ObservationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy   User?                @relation("ObservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  domains      ObservationDomain[]
  media        MediaFile[]          @relation("ObservationMedia")

  @@index([childId, observedOn(sort: Desc)])
  @@index([kindergartenId, observedOn(sort: Desc)])
  @@index([enrollmentId, observedOn(sort: Desc)])
  @@index([source, reviewStatus])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([childId, visibleToParents, observedOn(sort: Desc)])
  @@map("observations")
}

model ObservationDomain {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  observationId  String  @db.Uuid
  domainId       String  @db.Uuid
  levelId        String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten      @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  observation  Observation       @relation(fields: [observationId], references: [id], onDelete: Cascade)
  domain       DevelopmentDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  level        AssessmentLevel?  @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@unique([observationId, domainId])
  @@index([domainId])
  @@map("observation_domains")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────────────────────

/// Ирсэн/Хагас өдөр/Чөлөөтэй are confirmed against the reference system;
/// SICK and ABSENT are this project's own addition to round out an ordinary
/// attendance set and are not yet confirmed against the client's full list —
/// see docs/reference for the open question.
enum AttendanceStatus {
  PRESENT // Ирсэн
  HALF_DAY // Хагас өдөр
  EXCUSED // Чөлөөтэй
  SICK // Өвчтэй
  ABSENT // Тасалсан
  /// ★ Restored 2026-08-25. `нэмэлт.md` §1 lists six statuses and this is the
  /// sixth; it existed in the first attendance migration and was dropped when
  /// that migration was rewritten, which nothing recorded as a decision.
  ///
  /// It is the escape hatch every enum in this schema keeps: a day that is none
  /// of the five is otherwise recorded as the nearest wrong one, and an
  /// attendance figure that feeds a funding calculation cannot afford that.
  OTHER // Бусад
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Who physically handed the child over — at drop-off (`arrivedWith`) and,
/// separately, at pickup (`pickedUpWith`). A category, not a link to a
/// specific `Guardianship` row: staff record "mom" or "dad" at a glance, not
/// which named guardian. `OTHER` is anyone not on the guardian list — a
/// driver, a relative. No `ALONE`: dropped 2026-08-25, client request — a
/// kindergarten this young never receives a child unaccompanied, so the
/// option had no real case to cover.
enum AttendanceCompanion {
  MOTHER // Ээж
  FATHER // Аав
  OTHER // Бусад
}

/// One row per enrollment per day — never per bare `childId`, so a transfer
/// mid-year does not rewrite which kindergarten a day of attendance belongs
/// to (this feeds funding claims later, RFP appendix).
///
/// ★ `@@unique([enrollmentId, date])` below is emitted by Prisma as a plain
/// index; the migration `20260825120000_partial_unique_attendance_day`
/// replaces it with a **partial** one over `deletedAt IS NULL`. Postgres
/// treats NULLs as distinct, so the plain form counts a soft-deleted row as
/// still occupying the day — a day deleted once could never be recorded
/// again, surfacing as a unique violation on a row nobody can see. Prisma has
/// no partial-unique syntax, so this cannot be expressed here; see the
/// migration's SQL and `test/schema.test.ts`'s
/// "allows the day to be recorded again after the first row is soft-deleted".
model Attendance {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  enrollmentId   String @db.Uuid

  date   DateTime         @db.Date
  status AttendanceStatus
  /// Medication instructions when SICK — RFP: "эмийн зааварчилгаа, тун
  /// болон цагийн санамж".
  note   String?

  /// Drop-off. Both null until staff actually record who brought the child
  /// and when — never defaulted, so an unrecorded arrival stays visibly
  /// unrecorded rather than reading as "someone, at midnight".
  arrivedWith     AttendanceCompanion?
  /// Who, when `arrivedWith` is OTHER — a name a category alone cannot
  /// carry ("Бусад" says "not a parent", not who). Null for MOTHER/FATHER:
  /// the category already names them.
  arrivedWithName String?
  arrivedAt       DateTime?

  /// Pickup — recorded later the same day, independently of drop-off, so it
  /// cannot require re-sending `status`/`arrivedWith` to write. Custody
  /// accountability: a kindergarten needs to know *someone* collected the
  /// child, which this pair is the record of.
  pickedUpWith     AttendanceCompanion?
  /// Same reasoning as `arrivedWithName`, for the OTHER case at pickup.
  pickedUpWithName String?
  pickedUpAt       DateTime?

  /// The staff member who recorded it. Matches `Observation.authorId` —
  /// `User.id`, not `Membership.id`, so it reads across a role change.
  recordedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, date])
  @@index([childId, date(sort: Desc)])
  @@index([kindergartenId, date(sort: Desc)])
  @@map("attendance_records")
}

/// A guardian's advance notice ("my child will be excused tomorrow"), not
/// itself an attendance record. Approving one writes the actual `Attendance`
/// rows for the covered range — staff stays the sole author of `Attendance`,
/// matching the decision that parents may request but not record directly.
model AttendanceRequest {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  enrollmentId   String @db.Uuid

  /// User.id of the guardian who asked — a guardian has no Membership.
  requestedById   String                  @db.Uuid
  dateFrom        DateTime                @db.Date
  dateTo          DateTime                @db.Date
  requestedStatus AttendanceStatus
  reason          String?
  reviewStatus    AttendanceRequestStatus @default(PENDING)

  /// Set only when `requestedStatus` is PRESENT — a guardian reporting the
  /// morning's drop-off ("Ирц мэдэгдэх"), not a leave notice. Copied onto the
  /// `Attendance` row `reviewRequest` writes only on APPROVED, same as every
  /// other field here: a rejected or still-pending claim leaves no trace on
  /// the actual record.
  arrivedWith     AttendanceCompanion?
  /// Who, when `arrivedWith` is OTHER — see `Attendance.arrivedWithName`.
  arrivedWithName String?
  arrivedAt       DateTime?

  /// The same guardian's *second* request the same day — "Гарсныг мэдэгдэх"
  /// at pickup, once the child is already checked in. A separate row rather
  /// than fields added to the arrival request: the guardian does not know
  /// who is collecting the child at drop-off time, so the two are always
  /// two submissions, hours apart, each reviewed on its own.
  pickedUpWith     AttendanceCompanion?
  pickedUpWithName String?
  pickedUpAt       DateTime?
  /// The staff member who reviewed it — `User.id`, matching `recordedById`.
  reviewedById     String?              @db.Uuid
  reviewedAt       DateTime?

  /// Optional doctor's note or supporting image supplied with this request.
  /// The bytes stay private and are served through the ordinary media guard.
  attachment MediaFile? @relation("AttendanceRequestAttachment")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("AttendanceRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("AttendanceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([childId, dateFrom(sort: Desc)])
  @@index([kindergartenId, reviewStatus])
  @@map("attendance_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Meals — the weekly menu, RFP §989. Kindergarten-wide, not per-child: a
// per-child "did they eat" record is not in the RFP and is not built here.
// ─────────────────────────────────────────────────────────────────────────────

/// Whether a day's plan has been signed off — "Батлагдсан цэс", the kitchen
/// gap list's own phrase. A cook plans a day and an approval is a deliberate
/// second act, same shape as `RecipeStatus` below.
enum MenuDayStatus {
  DRAFT
  APPROVED
}

/// One row per kindergarten per day. "Weekly" is a query range over these,
/// not its own entity — there is nothing a week needs beyond seven days.
///
/// `dishes` is `Json`, an array of `{ name: string, allergenTags: string[] }`
/// plus an optional `recipeId`. A dish with no `recipeId` keeps the original
/// hand-typed shape (name/allergenTags/ingredients/calories typed by staff);
/// one with a `recipeId` resolves its name, allergens and calories from that
/// **approved** `Recipe` instead — `MealsService` does that resolution, never
/// the client. Both shapes coexist so nothing written before recipes existed
/// breaks.
model MenuDay {
  id             String        @id @default(uuid()) @db.Uuid
  kindergartenId String        @db.Uuid
  date           DateTime      @db.Date
  dishes         Json
  /// Кcal for the whole day, typed in by staff — not summed from `dishes`,
  /// which carries no per-dish figure of its own. Optional: most days will
  /// never get one, and a blank value must read as "not entered" rather than
  /// "zero calories".
  totalCalories  Int?
  status         MenuDayStatus @default(DRAFT)

  createdById  String?   @db.Uuid
  approvedById String?   @db.Uuid
  approvedAt   DateTime?
  /// Set once `POST .../consume` has deducted this day's recipe ingredients
  /// from stock — guards against a second call double-deducting. Never
  /// cleared: a correction is a `StockMovement` ADJUSTMENT row, not a re-run.
  consumedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("MenuDayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("MenuDayApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([kindergartenId, date])
  @@index([kindergartenId, date(sort: Desc)])
  @@map("menu_days")
}

// ─────────────────────────────────────────────────────────────────────────────
// Kitchen production — ingredients, technology cards, suppliers, food orders
// and the stock ledger. The gap list's own words: "Хоол үйлдвэрлэл — хамгийн
// том дутуу хэсэг". Everything above (MenuDay/MealRecord) is what gets served;
// this is what it takes to produce it.
//
// Three conventions specific to this section:
//
//   1. A single base unit per ingredient (grams / millilitres / count), used
//      everywhere — recipe lines, order lines, stock movements. No kg↔g or
//      l↔ml conversion exists anywhere in the domain; a screen may divide by
//      1000 for display, but nothing here stores or compares mixed units.
//
//   2. Nutrition and a recipe's effective allergens are DERIVED, never
//      stored — `KitchenService` sums `RecipeIngredient.quantity ×
//      Ingredient.*Per100 / 100` on every read, same reasoning as
//      `MealsService.childMealSummary`'s `daysFed`: one source of truth
//      beats a cached column that can drift from the rows it summarises.
//
//   3. `StockMovement` is an append-only ledger, like `AuditLog`. A wrong
//      entry is corrected with a new `ADJUSTMENT` row, never edited in place
//      — нэмэлт.md §14's principle applied to stock, not just money. Current
//      stock is `SUM(IN) + SUM(ADJUSTMENT, signed) − SUM(OUT)`, computed per
//      read rather than kept as a running balance column.
// ─────────────────────────────────────────────────────────────────────────────

enum IngredientUnit {
  GRAM
  MILLILITER
  PIECE
}

/// The kitchen's own config table — CLAUDE.md §2.3: an administrator/cook
/// edits this, so it is a table, never a TypeScript enum.
model Ingredient {
  id             String         @id @default(uuid()) @db.Uuid
  kindergartenId String         @db.Uuid
  name           String
  unit           IngredientUnit
  /// A closed vocabulary enforced by the form, not an enum — same pattern as
  /// `Document.category`. See `INGREDIENT_CATEGORIES` in @kinder/contracts.
  category       String?
  /// Nutrition per 100 of the ingredient's own `unit` — 100 g, 100 ml or 100
  /// pieces. Nullable: a cook may not always have a label's figures to hand,
  /// and a blank value must read as "not entered", never as zero.
  caloriesPer100 Decimal?       @db.Decimal(8, 2)
  proteinPer100  Decimal?       @db.Decimal(8, 2)
  fatPer100      Decimal?       @db.Decimal(8, 2)
  carbsPer100    Decimal?       @db.Decimal(8, 2)
  /// Short controlled tags, same vocabulary as `MenuDish.allergenTags` and
  /// matched by the same `allergenMatches` stem logic — сүү, самар, өндөг…
  allergenTags   String[]       @default([])
  note           String?
  /// The cook's own reorder threshold, in this ingredient's own `unit`.
  /// Nullable and opt-in — no default is invented for an ingredient nobody
  /// has set one for, same reasoning `caloriesPer100`'s comment gives: blank
  /// must read as "not set", never as zero (which would warn on everything).
  minStock       Decimal?       @db.Decimal(10, 2)

  createdById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten      Kindergarten       @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  createdBy         User?              @relation("IngredientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipeIngredients RecipeIngredient[]
  foodOrderLines    FoodOrderLine[]
  stockMovements    StockMovement[]

  /// Hand-written as a PARTIAL unique index in the migration — Postgres
  /// treats NULLs as distinct, so the plain form would let a soft-deleted
  /// ingredient block its own name forever. Same pattern as
  /// `development_domains_system_code_key`.
  @@unique([kindergartenId, name])
  @@index([kindergartenId, deletedAt])
  @@index([kindergartenId, category])
  @@map("ingredients")
}

/// Технологийн карт — a recipe with real quantities, not a text field.
model Recipe {
  id             String       @id @default(uuid()) @db.Uuid
  kindergartenId String       @db.Uuid
  name           String
  /// Which sitting it is usually served at — optional, informational only;
  /// a menu dish still carries its own `kind`.
  mealKind       MealKind?
  /// How many portions this card's quantities are written for. Every
  /// nutrition figure and every stock deduction scales off this.
  yieldPortions  Int
  instructions   String?
  status         RecipeStatus @default(DRAFT)

  approvedById String?   @db.Uuid
  approvedAt   DateTime?
  createdById  String?   @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten       @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("RecipeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?              @relation("RecipeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  ingredients  RecipeIngredient[]

  @@index([kindergartenId, status, deletedAt])
  @@map("recipes")
}

enum RecipeStatus {
  DRAFT
  APPROVED
}

/// One ingredient line on a technology card.
model RecipeIngredient {
  id           String  @id @default(uuid()) @db.Uuid
  recipeId     String  @db.Uuid
  ingredientId String  @db.Uuid
  /// In the ingredient's own `unit` — grams, millilitres or a count.
  quantity     Decimal @db.Decimal(10, 2)
  position     Int     @default(0)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: an ingredient in active use on a technology card
  /// cannot vanish out from under it — the same guard `Enrollment` puts on
  /// `Kindergarten` deletion.
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId, position])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

/// A food supplier — нэмэлт.md's "нийлүүлэгчийн гарал үүсэл".
model Supplier {
  id                 String  @id @default(uuid()) @db.Uuid
  kindergartenId     String  @db.Uuid
  name               String
  registrationNumber String?
  contactPerson      String?
  contactPhone       String?
  address            String?
  /// Гарал үүслийн тайлбар — free text: where the food comes from, any
  /// certification the supplier has shown. Not a certification registry.
  originNote         String?
  isActive           Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  foodOrders   FoodOrder[]

  @@index([kindergartenId, deletedAt])
  @@map("suppliers")
}

enum FoodOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

/// Хүнсний захиалга — one order to one supplier.
model FoodOrder {
  id             String          @id @default(uuid()) @db.Uuid
  kindergartenId String          @db.Uuid
  supplierId     String          @db.Uuid
  orderDate      DateTime        @db.Date
  status         FoodOrderStatus @default(DRAFT)
  note           String?

  createdById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten    @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  supplier     Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("FoodOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        FoodOrderLine[]

  @@index([kindergartenId, orderDate(sort: Desc)])
  @@index([kindergartenId, status])
  @@map("food_orders")
}

/// One ingredient line on a food order.
model FoodOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  foodOrderId      String   @db.Uuid
  ingredientId     String   @db.Uuid
  /// In the ingredient's own `unit`.
  quantity         Decimal  @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(12, 2)
  /// `quantity × unitPrice`, frozen at save — same reasoning as
  /// `Invoice`'s frozen amount columns: a later price change on a new order
  /// must not silently reprice an old one.
  totalPrice       Decimal  @db.Decimal(12, 2)
  /// Set on receive. Nullable/blank means "not yet received" — a short or
  /// over-delivery is recorded here rather than by editing `quantity`, which
  /// is what was ordered and stays the ordered figure.
  receivedQuantity Decimal? @db.Decimal(10, 2)

  foodOrder  FoodOrder  @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([foodOrderId])
  @@map("food_order_lines")
}

enum StockDirection {
  IN
  OUT
  ADJUSTMENT
}

enum StockSourceType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
}

/// Зарцуулалт — the stock ledger. Append-only, like `AuditLog`: no
/// `updatedAt`, no `deletedAt`. `sourceId` points at a `FoodOrder` (PURCHASE)
/// or a `MenuDay` (CONSUMPTION), untyped like `AuditLog.objectId` — the two
/// source tables don't share a base to foreign-key against cleanly, and this
/// ledger already has a `sourceType` to disambiguate.
model StockMovement {
  id             String          @id @default(uuid()) @db.Uuid
  kindergartenId String          @db.Uuid
  ingredientId   String          @db.Uuid
  date           DateTime        @db.Date
  direction      StockDirection
  /// Always stored positive; `direction` carries the sign.
  quantity       Decimal         @db.Decimal(10, 2)
  sourceType     StockSourceType
  sourceId       String?         @db.Uuid
  note           String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kindergartenId, ingredientId, date])
  @@index([kindergartenId, date])
  @@map("stock_movements")
}

/// Тараалт — whether a group's food for one sitting has gone out. Client
/// request, 2026-09-05: the cook's "Ирц" screen already shows how many
/// children are in each group, for portioning; this is the other half —
/// checking off that the portioned food actually reached that classroom.
///
/// ★ One row per group, per day, per sitting — not per child. `MealRecord`
/// already answers "did this child eat"; this answers "has the kitchen sent
/// food to this room yet", which a cook marks once per sitting regardless of
/// headcount. Conflating the two would let one late child's missing record
/// keep the whole group's row from ever reading "тарааcан".
model MealServing {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  groupId        String   @db.Uuid
  date           DateTime @db.Date
  kind           MealKind

  servedById String?  @db.Uuid
  servedAt   DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  servedBy     User?        @relation("MealServingRecordedBy", fields: [servedById], references: [id], onDelete: SetNull)

  /// One live mark per group/day/sitting. Hand-written as a **partial** unique
  /// index in the migration — same reason as `MealRecord`: Postgres treats
  /// NULLs as distinct, so the plain form would let an undone mark block that
  /// sitting from ever being marked again.
  @@unique([groupId, date, kind])
  @@index([kindergartenId, date])
  @@map("meal_servings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Surveys — RFP "Модуль 1: Судалгаа, Асуулга". This ships the RFP's core
// mechanism only: create, publish, respond, see aggregate results. The
// September-vs-May term comparison, the 5-sheet Excel export, and folding
// survey data into the development radar are each their own future pass —
// deliberately not built here, not silently dropped.
// ─────────────────────────────────────────────────────────────────────────────

enum SurveyScope {
  /// Answered by a guardian, about their own child.
  CHILD
  /// Answered once by any member of the kindergarten — no child attached.
  KINDERGARTEN
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// Which of the client's two survey shapes this is — their 2026-08-31 request.
///
/// ★ A column rather than a UI preset, and the distinction is not cosmetic.
///
/// The two differ in what they promise a reader. A **POLL** is one question
/// answered in a tap, published to the class board and read as a bar; a **FORM**
/// is a questionnaire somebody sits down with. That changes how the list should
/// group them, what the composer defaults to, and which results view makes
/// sense — none of which can be recovered afterwards from a survey that merely
/// happens to have one question, because a form with one question is not a poll.
enum SurveyKind {
  POLL
  FORM
}

enum SurveyQuestionType {
  RATING // 1-5
  YES_NO
  TEXT
  /// Pick exactly one; `options` holds the choices.
  ///
  /// ★ Added 2026-08-31. `CHECKBOX` was the only option-bearing type, and it is
  /// multi-select — so "Нэг сонголт" on the client's drawing had no
  /// representation at all and every choice question silently allowed several
  /// answers. Scored by `survey-scoring.ts` exactly as `CHECKBOX` is (one
  /// counter per option); what differs is what the answering form renders, and
  /// that a response carrying two values is now invalid rather than merely
  /// unusual.
  SINGLE_CHOICE
  CHECKBOX // multi-select; `options` holds the choices
  /// RFP Module 1.1 — "Matrix (олон үзүүлэлтийн хүснэгт)".
  ///
  /// One question carrying several indicators scored on a shared scale, which
  /// is how a development questionnaire is actually written: "rate each of
  /// these seven areas 1–5". `options` holds `{ rows, columns }` and the answer
  /// is `{ [rowKey]: number }` — see `survey-scoring.ts`.
  MATRIX
}

/// Where in the school year a survey sits — RFP Module 1.1's "эхний/завсрын/
/// жилийн эцсийн үнэлгээгээр ... ангилан архивлана".
///
/// ★ This is what makes Module 1.2's automatic comparison possible at all.
/// Without it nothing distinguishes September's wave from May's, and "compare
/// the same questionnaire at the start and the end of the year" has no way to
/// tell which is which.
enum SurveyPeriod {
  BASELINE // Эхний үнэлгээ — есдүгээр сар
  MIDLINE // Завсрын үнэлгээ
  ENDLINE // Жилийн эцсийн үнэлгээ — тавдугаар сар
}

enum SurveyCategory {
  PARENT_ENGAGEMENT
  SATISFACTION
  SOCIAL_DEVELOPMENT
  PHYSICAL_DEVELOPMENT
  COGNITIVE_DEVELOPMENT
  HABITS_INDEPENDENCE
  /// Added 2026-09-10 at the client's request. The six above are all
  /// developmental or attitudinal; a kindergarten also asks about the group
  /// itself — an outing, a parents' evening — and had nowhere to file it.
  CLASS_GROUP
  /// The escape hatch every vocabulary needs, so a survey that fits none of
  /// the others is filed rather than mislabelled as one of them.
  OTHER
}

model Survey {
  id             String         @id @default(uuid()) @db.Uuid
  kindergartenId String         @db.Uuid
  title          String
  description    String?
  category       SurveyCategory @default(PARENT_ENGAGEMENT)
  scope          SurveyScope
  kind           SurveyKind     @default(FORM)
  status         SurveyStatus   @default(DRAFT)
  createdById    String?        @db.Uuid
  publishedAt    DateTime?
  closedAt       DateTime?

  /// When answering stops — the client's optional "Хаагдах огноо".
  ///
  /// ★ Not the same field as `closedAt`, and the pair is easy to misread.
  ///
  /// `closedAt` is a fact: somebody pressed Хаах, and it records when. This is
  /// an *intention* set in advance, and it is nullable because the client asked
  /// for "an option to create a survey without specifying a closing date" —
  /// null means it stays open until closed by hand.
  ///
  /// A survey past this instant refuses new responses without its `status`
  /// changing, so a deadline needs no scheduled job to enforce it. The status
  /// still moves to CLOSED only when a person closes it, which keeps "why did
  /// this stop accepting answers" answerable from the row itself.
  closesAt DateTime?

  /// When it starts accepting answers — the client's "Эхлэх огноо", 2026-09-10.
  ///
  /// ★ The mirror of `closesAt`, and enforced in the same one place.
  ///
  /// A survey published on Monday for a meeting on Friday should not collect
  /// answers all week; a teacher sets both dates when they build it. NULL is
  /// "from the moment it is published", which is what every survey written
  /// before this field did and what most still mean.
  ///
  /// Like `closesAt` this is an *intention*, not a state: nothing sweeps it,
  /// `status` stays PUBLISHED, and `submitResponse` is the single place that
  /// asks. A scheduled job flipping a status at midnight would still leave the
  /// window between the instant and the sweep wrong.
  opensAt DateTime?

  /// Why it is being run — the client's "Зорилго", 2026-09-10.
  ///
  /// ★ Separate from `description`, which is what a *parent* reads under the
  /// title. This is what the kindergarten is trying to learn, and it belongs
  /// on the results sheet and in the archive rather than on the answering
  /// form: "did we get an answer to the question we ran this for" is what a
  /// director asks of a survey a year later.
  purpose String?

  /// Which term of the school year — the client's "Улирал", 2026-09-10.
  ///
  /// ★ A row, not a number, because `Term` is administrator-editable (§2.3):
  /// its dates and names are configured per kindergarten, and a `SmallInt`
  /// here would be a second copy of `Term.number` that nothing keeps in step.
  ///
  /// Nullable and `onDelete: Restrict`: a survey may sit outside any term (the
  /// summer), and a term with surveys filed against it must not be deletable
  /// out from under them.
  termId String? @db.Uuid

  /// Whether answers are recorded without naming who gave them — the client's
  /// "Хариулт нуух" / "Нэрээ харах", 2026-09-10.
  ///
  /// ★ It hides the respondent from *readers*, not from the database.
  ///
  /// `SurveyResponse.respondentId` is still written, and must be: it is what
  /// stops one family answering twice, and `AuditLog` answers for the row. What
  /// this changes is what the product will show — `participation` reports
  /// counts instead of names and the workbook omits the respondent column.
  /// Promising true anonymity while storing the id would be the worse of the
  /// two failures, so the flag is named for what it does.
  isAnonymous Boolean @default(false)

  /// Whether one respondent may answer more than once — the client's "Олон
  /// удаа хариулахыг хязгаарлах" toggle, inverted.
  ///
  /// ★ Default false, which is the behaviour every survey has had.
  ///
  /// `submitResponse` refuses a second response outright today. That is right
  /// for a questionnaire — a family's considered answers, submitted once — and
  /// wrong for the standing polls the client wants ("Маргаашийн аялалд хэн
  /// ирэх вэ" asked every week). The rule moves from the code to the row.
  allowMultipleResponses Boolean @default(false)

  /// Whether the answering form shuffles its questions — "Асуултын дарааллыг
  /// санамсаргүй болгох".
  ///
  /// ★ Order effects are real: the first question of a satisfaction survey is
  /// answered more generously than the fifth. It is off by default because a
  /// questionnaire that builds an argument across its questions is ruined by
  /// shuffling, and the person writing it knows which kind theirs is.
  shuffleQuestions Boolean @default(false)

  /// What a family reads after submitting — "Нэмэлт тэмдэглэл".
  ///
  /// NULL falls back to the product's own thank-you. A kindergarten that wants
  /// to say what happens next ("Хариултыг 9-р сарын 20-нд хэлэлцэнэ") writes it
  /// here rather than in the description, where it would be read before
  /// answering instead of after.
  closingNote String?

  /// "2025-2026". A string, not a year number: a school year spans two.
  schoolYear String?
  /// Which wave — RFP Module 1.1's archival classification, and the field
  /// Module 1.2's begin-to-end comparison pairs on.
  period     SurveyPeriod?

  /// The survey this one was cloned from — RFP Module 1.2's lineage.
  ///
  /// ★ Kept for provenance and for Sheet 5's year-over-year walk, but it is
  /// **not** what the comparison pairs questions on. Questions are matched by
  /// `SurveyQuestion.indicatorKey`, because a cloned survey starts as a DRAFT
  /// whose questions may still be edited — and editing them deletes and
  /// recreates every row, which would destroy any id-based lineage. See the
  /// note on `indicatorKey`.
  clonedFromSurveyId String? @db.Uuid

  /// Which group this survey is for — NULL means every group.
  ///
  /// ★ Added 2026-09-06, at the client's request: the "Хэнд зориулагдсан"
  /// control should offer "бүх бүлэг" or a chosen one.
  ///
  /// **NULL is the whole kindergarten, and it is not the same as every group
  /// listed.** A survey aimed that way keeps reaching families who enrol after
  /// it was published; naming groups freezes the audience at the moment of
  /// writing. The notification module draws exactly this distinction and states
  /// it in `notifications.dto.ts` — one convention for both, so "everyone"
  /// means one thing in this product.
  ///
  /// ★★ A column rather than a `SurveyTarget` join table, unlike notifications.
  ///
  /// A notice can be aimed at several groups *and* named children at once, so
  /// its targets are rows. The client asked for one group or all of them here,
  /// and a join table for a cardinality of one is a second query on every read
  /// of the parent's survey list. It widens to a table the day the requirement
  /// widens; a column that has to become one is a migration, not a redesign.
  ///
  /// `onDelete: Restrict` for the reason every tenant relation here uses it:
  /// groups are soft-deleted (§3.2), so a real delete cascading through a
  /// published survey is not a case that should be reachable at all.
  groupId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten     @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("SurveyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  group        Group?           @relation("SurveyGroup", fields: [groupId], references: [id], onDelete: Restrict)
  term         Term?            @relation(fields: [termId], references: [id], onDelete: Restrict)
  questions    SurveyQuestion[]
  responses    SurveyResponse[]
  clonedFrom   Survey?          @relation("SurveyClone", fields: [clonedFromSurveyId], references: [id], onDelete: SetNull)
  clones       Survey[]         @relation("SurveyClone")

  @@index([kindergartenId, status])
  @@index([kindergartenId, category])
  /// The parent's list: published surveys for their child's group, or for all.
  @@index([kindergartenId, groupId])
  /// "This year's waves, in order" — what Module 1.2 asks for.
  @@index([kindergartenId, schoolYear, period])
  /// The staff list grouped by term, and the FK's own lookups.
  @@index([kindergartenId, termId])
  @@map("surveys")
}

model SurveyQuestion {
  id             String             @id @default(uuid()) @db.Uuid
  kindergartenId String             @db.Uuid
  surveyId       String             @db.Uuid
  order          Int
  type           SurveyQuestionType
  prompt         String
  /// CHECKBOX's choices, as a string array; MATRIX's `{ rows, columns }`.
  /// Unused by RATING, YES_NO and TEXT.
  options        Json?

  /// What this question *measures*, stable across waves and years.
  ///
  /// ★ This, not the row id, is what Module 1.2 pairs September against May on.
  ///
  /// A cloned survey starts as a DRAFT, and editing a DRAFT's questions runs
  /// `replaceQuestions`, which deletes every row and creates new ones. Any
  /// pairing built on `SurveyQuestion.id` — or on a `clonedFromQuestionId`
  /// pointing at one — is destroyed by a teacher reordering two questions
  /// before publishing. Pairing on `order` fails differently and worse: insert
  /// one question in May and every indicator after it silently compares against
  /// the wrong September question, reporting a progress figure that is not
  /// wrong-looking, just wrong.
  ///
  /// The key round-trips through the edit endpoint and is copied by the clone,
  /// so it survives both. Null means "not comparable", which is honest for a
  /// one-off poll.
  indicatorKey String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers      SurveyAnswer[]

  @@index([surveyId, order])
  /// The comparison's lookup: "every wave's version of this indicator".
  @@index([kindergartenId, indicatorKey])
  @@map("survey_questions")
}

/// One guardian's (or, for a KINDERGARTEN-scope survey, one member's) full
/// submission. `childId` is set only for a CHILD-scope survey.
model SurveyResponse {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  surveyId       String   @db.Uuid
  childId        String?  @db.Uuid
  respondentId   String   @db.Uuid
  submittedAt    DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  child        Child?         @relation(fields: [childId], references: [id], onDelete: Cascade)
  respondent   User           @relation("SurveyRespondent", fields: [respondentId], references: [id], onDelete: Cascade)
  answers      SurveyAnswer[]

  @@index([surveyId, childId])
  @@index([surveyId, respondentId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  responseId     String @db.Uuid
  questionId     String @db.Uuid
  /// A number (RATING), a boolean (YES_NO), a string (TEXT) or a string
  /// array (CHECKBOX) — the shape `SurveyQuestion.type` says it should be.
  value          Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kindergarten Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  response     SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question     SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@map("survey_answers")
}

model Term {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  schoolYearId   String   @db.Uuid
  /// 1..3
  number         Int      @db.SmallInt
  name           String
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  schoolYear   SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  assessments  Assessment[]
  termReports  TermReport[]
  surveys      Survey[]

  @@unique([schoolYearId, number])
  @@index([kindergartenId, startsOn])
  @@map("terms")
}

model Assessment {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  childId        String  @db.Uuid
  enrollmentId   String  @db.Uuid
  domainId       String  @db.Uuid
  termId         String  @db.Uuid
  levelId        String  @db.Uuid
  comment        String?

  visibleToParents Boolean @default(false)

  assessedById String?  @db.Uuid
  assessedAt   DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten      @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  domain       DevelopmentDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  term         Term              @relation(fields: [termId], references: [id], onDelete: Restrict)
  level        AssessmentLevel   @relation(fields: [levelId], references: [id], onDelete: Restrict)
  assessedBy   User?             @relation("AssessmentAuthor", fields: [assessedById], references: [id], onDelete: SetNull)

  @@unique([childId, termId, domainId])
  @@index([childId, termId])
  @@index([kindergartenId, termId])
  @@index([enrollmentId, termId])
  @@map("assessments")
}

model TermReport {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  childId        String @db.Uuid
  enrollmentId   String @db.Uuid
  termId         String @db.Uuid

  strengths        String?
  needsSupport     String?
  nextGoals        String?
  adviceForParents String?

  status      TermReportStatus @default(DRAFT)
  authorId    String?          @db.Uuid
  finalizedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  author       User?        @relation("TermReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([childId, termId])
  @@index([childId, termId])
  @@index([kindergartenId, termId])
  @@map("term_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────────────────────────────────────

/// File metadata. The bytes live in R2; this table never holds binary.
///
/// `storageKey` is a random UUID path — `children/{uuid}/{uuid}`. It is NEVER
/// derived from the child's name, id or the uploaded filename. The real
/// filename lives only in `originalName`, for display, and is never used to
/// build a URL. docs/SECURITY.md §7.
model MediaFile {
  id                  String  @id @default(uuid()) @db.Uuid
  kindergartenId      String  @db.Uuid
  /// The authorization anchor. NULL only for kindergarten-level outputs.
  childId             String? @db.Uuid
  observationId       String? @db.Uuid
  /// Set for `NOTIFICATION` media. Mutually exclusive with `childId` in
  /// practice: a class announcement is addressed to a group, not a child.
  notificationId      String? @db.Uuid
  /// Set for `MILESTONE` media — RFP §4.5's "Зураг". Carries `childId` too, so
  /// the ordinary child-media authorization applies without a special case.
  milestoneId         String? @db.Uuid
  /// Set for `INCIDENT` media — Module 2.1's "фото зураг хавсаргах". Also
  /// carries `childId`, so the ordinary child-media authorization applies.
  incidentId          String? @db.Uuid
  /// Set only for `ATTENDANCE_ATTACHMENT`; unique because one leave request
  /// accepts one supporting document.
  attendanceRequestId String? @unique @db.Uuid
  /// Set for `CHAT_MESSAGE` — up to four per message. Not unique, unlike the
  /// line above: a message may carry several photographs, ordered by `order`.
  chatMessageId       String? @db.Uuid
  order               Int     @default(0)

  purpose MediaPurpose

  storageKey   String  @unique
  originalName String
  /// Detected from CONTENT, never from the extension.
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  checksum     String?

  status  MediaStatus @default(READY)
  caption String?

  /// ── Album metadata — RFP §4.4 ───────────────────────────────────────────
  ///
  /// All nullable: every one of these arrived after photographs had already
  /// been stored, and a required column would have needed a value invented for
  /// rows nobody can go back and ask about.

  /// When the photograph was TAKEN, as distinct from `uploadedAt`. A parent
  /// uploading last summer's holiday in October is the ordinary case, and
  /// sorting an album by upload time puts it in the wrong year.
  takenAt DateTime? @db.Date

  /// The child's age in the photograph, 2..5 — the album's "нас" facet.
  /// Validated in the service layer, like `ChildAgeProfile.age`.
  age Int? @db.SmallInt

  /// The album's "ангилал" facet.
  ///
  /// ★ A plain string constrained by a zod enum in the DTO, deliberately NOT a
  /// Prisma enum and NOT a configuration table. The RFP does not say an
  /// administrator edits this list, so CLAUDE.md §2.3 does not bind; and of the
  /// three shapes this is the only one that can become either of the others
  /// without rewriting stored rows. If the client asks for it to be editable,
  /// the existing values become seed rows in a new table.
  category String?

  /// This photograph is the cover of this age's album. Null for ordinary
  /// photographs. The compound unique constraint allows many NULL rows while
  /// guaranteeing only one selected cover for a child and age.
  albumCoverAge Int? @db.SmallInt

  /// Whose photograph this is, for display. See `MediaAttribution`.
  attribution MediaAttribution?

  /// The account that uploaded the bytes.
  ///
  /// Domain data, not audit data — the same distinction `Observation.authorId`
  /// draws. The gallery labels a photograph with who contributed it, which is a
  /// query-time need; `AuditLog` answers the forensic question separately and
  /// outlives the row.
  uploadedById String? @db.Uuid

  uploadedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  kindergarten       Kindergarten        @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child              Child?              @relation("ChildMedia", fields: [childId], references: [id], onDelete: Cascade)
  observation        Observation?        @relation("ObservationMedia", fields: [observationId], references: [id], onDelete: Cascade)
  notification       Notification?       @relation("NotificationMedia", fields: [notificationId], references: [id], onDelete: Cascade)
  milestone          Milestone?          @relation("MilestoneMedia", fields: [milestoneId], references: [id], onDelete: Cascade)
  incident           SafetyIncident?     @relation("IncidentMedia", fields: [incidentId], references: [id], onDelete: Cascade)
  attendanceRequest  AttendanceRequest?  @relation("AttendanceRequestAttachment", fields: [attendanceRequestId], references: [id], onDelete: Cascade)
  chatMessage        ChatMessage?        @relation("ChatMessageMedia", fields: [chatMessageId], references: [id], onDelete: Cascade)
  uploadedBy         User?               @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  childPhotoOf       Child?              @relation("ChildPhoto")
  comparisonEarlier  ArtworkComparison[] @relation("ComparisonEarlier")
  documentFileOf     Document?           @relation("DocumentFile")
  documentCoverOf    Document?           @relation("DocumentCover")
  comparisonLater    ArtworkComparison[] @relation("ComparisonLater")
  reportJob          ReportJob?          @relation("ReportOutput")
  kindergartenLogoOf Kindergarten?       @relation("KindergartenLogo")
  userPhotoOf        User?               @relation("UserPhoto")
  groupPhotoOf       Group?              @relation("GroupPhoto")
  contractPdf        Contract?           @relation("ContractPdf")

  @@unique([childId, albumCoverAge])
  /// A message's photographs, in the order they were attached.
  @@index([chatMessageId, order])
  @@index([childId, purpose, uploadedAt(sort: Desc)])
  @@index([kindergartenId, uploadedAt(sort: Desc)])
  @@index([observationId, order])
  @@index([notificationId, order])
  @@index([milestoneId, order])
  @@index([incidentId, order])
  @@index([status, deletedAt])
  /// ★ This does NOT serve the gallery's default sort, and the comment that
  /// claimed it did was wrong.
  ///
  /// `GALLERY_ORDER` leads with `order ASC` (the sequence a teacher arranged by
  /// hand), so Postgres sorts in memory whatever indexes exist — a
  /// `(childId, takenAt)` index cannot satisfy a sort whose leading key is
  /// something else. What it does buy is a date-ranged album: "photographs of
  /// this child taken in the spring term", which is the query `takenAt` was
  /// added to make possible. Drop it if that filter never ships.
  @@index([childId, takenAt(sort: Desc)])
  @@map("media_files")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

/// What kind of notice this is — the client's own list, 2026-08-30.
///
/// ★ An enum rather than a `NotificationCategory` table, which is the opposite
/// of what CLAUDE.md §2.3 asks for and needs its reason written down.
///
/// §2.3's rule is that anything **an administrator can edit** is a table. These
/// are not administrator-editable: the client specified the nine values in
/// writing, parents filter by them, and a kindergarten inventing a tenth would
/// produce a chip no other kindergarten's parents can search. The rule's own
/// examples — `DevelopmentDomain`, `AssessmentLevel`, `ObservationType` — are
/// all things a kindergarten genuinely tailors. This is closer to
/// `NotificationStatus`: a fixed vocabulary the product defines.
///
/// If the client later asks for per-kindergarten categories, this becomes a
/// table and the enum becomes its seed — the same migration `DevelopmentDomain`
/// went through.
enum NotificationCategory {
  /// Зарлал — something is happening, act on it.
  ANNOUNCEMENT
  /// Мэдээлэл — for information.
  INFORMATION
  /// Зөвлөмж — advice for the family.
  ADVICE
  /// Сургалт, үйл ажиллагаа
  ACTIVITY
  /// Өдрийн дэглэм — the daily routine.
  ROUTINE
  /// Зугаалга — an outing.
  OUTING
  /// Өдөрлөг — an event day.
  EVENT
  /// Төрсөн өдөр
  BIRTHDAY
  /// Бусад
  OTHER
}

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  kindergartenId String               @db.Uuid
  /// ★ Nullable since 2026-08-30, at the client's request.
  ///
  /// A notice used to require one. The client asked for posts that are a
  /// photograph and a sentence — "Өнөөдөр цэцэрлэгт хүрээлэнд явлаа" needs no
  /// heading, and forcing one produced titles that restated the first line of
  /// the body. Existing rows all have one; the column simply stops demanding it.
  title          String?
  body           String
  /// Defaults to OTHER so every row written before this column existed has a
  /// value the filter can match, rather than being invisible to every chip.
  category       NotificationCategory @default(OTHER)
  startsOn       DateTime?            @db.Date
  endsOn         DateTime?            @db.Date
  isImportant    Boolean              @default(false)
  status         NotificationStatus   @default(DRAFT)
  publishedAt    DateTime?
  authorId       String?              @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten           @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  author       User?                  @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  targets      NotificationTarget[]
  /// The incidents this notice reported — RFP Module 2.1. Plural because one
  /// notice may cover several children in the same event (a scuffle), and the
  /// record on each child must still point at how the family was told.
  incidents    SafetyIncident[]       @relation("IncidentNotification")
  reads        NotificationRead[]
  reactions    NotificationReaction[]
  media        MediaFile[]            @relation("NotificationMedia")

  @@index([kindergartenId, status, publishedAt(sort: Desc)])
  @@index([kindergartenId, category])
  @@map("notifications")
}

/// Audience. Both `groupId` and `childId` NULL means the whole kindergarten.
model NotificationTarget {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String  @db.Uuid
  notificationId String  @db.Uuid
  groupId        String? @db.Uuid
  childId        String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  child        Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([groupId])
  @@index([childId])
  @@map("notification_targets")
}

/// Append-only read receipt. No soft delete — unreading is not a thing.
model NotificationRead {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt(sort: Desc)])
  @@map("notification_reads")
}

/// A "like" on an announcement.
///
/// ★ Reactions only. There is no comment model and there is not going to be
/// one: a class board where parents can reply is a moderation surface, and
/// nobody has been given the job of moderating it. A like says "seen and
/// appreciated" without creating anything a teacher has to police.
///
/// Soft-deleted rather than removed, per §3.2 — un-liking sets `deletedAt` and
/// liking again clears it, so the unique pair survives the round trip and the
/// history of who reacted is not silently rewritten.
model NotificationReaction {
  id             String @id @default(uuid()) @db.Uuid
  kindergartenId String @db.Uuid
  notificationId String @db.Uuid
  userId         String @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One reaction per person per notice. The toggle updates this row rather
  /// than inserting a second one.
  @@unique([notificationId, userId])
  @@index([notificationId, deletedAt])
  @@map("notification_reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reports and audit
// ─────────────────────────────────────────────────────────────────────────────

model ReportJob {
  id             String       @id @default(uuid()) @db.Uuid
  kindergartenId String       @db.Uuid
  childId        String?      @db.Uuid
  type           ReportType
  params         Json         @default("{}")
  requestedById  String?      @db.Uuid
  status         ReportStatus @default(QUEUED)

  progressPercent   Int     @default(0) @db.SmallInt
  resultMediaFileId String? @unique @db.Uuid
  fileSize          Int     @default(0)
  pageCount         Int     @default(0) @db.SmallInt
  errorMessage      String?

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  child        Child?       @relation(fields: [childId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  resultMedia  MediaFile?   @relation("ReportOutput", fields: [resultMediaFileId], references: [id], onDelete: SetNull)

  @@index([childId, requestedAt(sort: Desc)])
  @@index([kindergartenId, status, requestedAt(sort: Desc)])
  @@map("report_jobs")
}

/// ★ Append-only. The ONLY table with no soft delete, no `updatedAt` and no
/// authorship columns — a record that can be edited is not an audit record.
/// Enforced at the repository layer, which exposes only `append()`.
model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  kindergartenId String? @db.Uuid
  actorUserId    String? @db.Uuid
  actorRole      String?
  /// The actor's name as plain text, so a deleted user's actions stay
  /// attributable.
  actorLabel     String?

  action     AuditAction
  objectType String?
  objectId   String?
  /// Set whenever child data was involved, so "who accessed this child's
  /// record" is one indexed query.
  childId    String?     @db.Uuid

  ipAddress String?
  userAgent String?
  metadata  Json    @default("{}")

  createdAt DateTime @default(now())

  kindergarten Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  child        Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([kindergartenId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ── Chat ─────────────────────────────────────────────────────────────────────

/// A group message board — RFP Phase IV, pulled into scope 2026-08-29 (see
/// CLAUDE.md §7). **There is no AI anywhere in this feature.**
///
/// ★ There is no `ChatRoom` table, and no `ChatMember` table, and both
/// absences are the design rather than a shortcut.
///
/// A room is not a thing somebody creates — it is a group that already exists,
/// or the kindergarten's own staff room. Giving it a row would mean creating
/// one for every group ever made (including the ones made before this shipped),
/// keeping its name in step with the group's, and deciding what happens to it
/// when the group is archived. `roomKey` identifies a room by what it already
/// is instead: `group:<uuid>` or `staff:<kindergartenId>`.
///
/// Membership follows from the same facts authorization already reads —
/// `Membership`, `GroupTeacher`, `Enrollment`, `Guardianship`. A `ChatMember`
/// row would be a fourth copy of "who belongs where", and the day a teacher is
/// unassigned from a group it would be the copy that still said yes. CLAUDE.md
/// §1.3 makes the same argument about roles in a token.
enum ChatRoomKind {
  /// One kindergarten group: its assigned teachers and its families.
  GROUP
  /// Every teacher and admin of one kindergarten. No guardians.
  STAFF
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  kindergartenId String       @db.Uuid
  kind           ChatRoomKind
  /// The group whose room this is. NULL for a STAFF room.
  groupId        String?      @db.Uuid
  /// `group:<uuid>` or `staff:<kindergartenId>` — the room, canonically.
  /// Denormalised so a room's history is one indexed lookup rather than a
  /// three-way OR over nullable columns.
  roomKey        String
  authorId       String       @db.Uuid
  body           String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author       User         @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  /// Up to four photographs, `MediaPurpose.CHAT_MESSAGE`. Read through
  /// `/media/:id`, never by URL — §1.4.
  media        MediaFile[]  @relation("ChatMessageMedia")

  /// The only access pattern: one room, newest first, paginated (§3.4).
  @@index([roomKey, createdAt(sort: Desc)])
  @@index([kindergartenId])
  @@map("chat_messages")
}

/// How far one person has read in one room.
///
/// ★ A timestamp, not a join table of message ids. Unread is
/// `count(messages where createdAt > lastReadAt)`, which is one indexed count
/// per room rather than a row per person per message — the difference between
/// a table that grows with members and one that grows with members × messages.
model ChatRead {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  userId         String   @db.Uuid
  roomKey        String
  lastReadAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  user         User         @relation("ChatReader", fields: [userId], references: [id], onDelete: Cascade)

  /// `roomKey` is never null, which is what lets this be a real constraint —
  /// a `(userId, groupId)` pair could not be, because Postgres treats NULLs as
  /// distinct and every staff room row would slip past it.
  @@unique([userId, roomKey])
  @@map("chat_reads")
}

// ── Revenue sharing ──────────────────────────────────────────────────────────

/// A person who takes an agreed percentage of the platform's income.
///
/// ★ **The one table in this schema with no `kindergartenId`**, and the
/// exception is deliberate rather than an oversight.
///
/// CLAUDE.md §3.1 requires every *tenant-scoped* table to carry one, because
/// one filter is what enforces isolation between kindergartens. This is not
/// tenant-scoped: a partner's share is an agreement between the platform's
/// owners about the platform's own income, in the same register as
/// `User.isSuperAdmin`. Giving it a kindergarten id would invite a query that
/// filtered by one and quietly returned a fraction of the answer.
///
/// Nothing outside `PlatformAccessService` may read it — see
/// `platform-revenue.controller.ts`.
///
/// ★★ Percentages are effective-dated and never edited in place, which is
/// `FundingRule`'s discipline and for the same reason: a month's distribution
/// is evidence of the split it was calculated under, and editing the percentage
/// rewrites what was already paid out. A new agreement is a new row starting
/// the day the old one ends.
model RevenuePartner {
  id   String @id @default(uuid()) @db.Uuid
  /// The person, as they should be named in a payout list.
  name String

  /// Their share, 0–100. `DECIMAL(5,2)` so 12.5% is exactly 12.5 rather than a
  /// float that renders as 12.499999999999998 in a figure about money.
  sharePercent Decimal @db.Decimal(5, 2)

  effectiveFrom DateTime  @db.Date
  /// Null while the agreement is current. Setting it closes the share.
  effectiveTo   DateTime? @db.Date

  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([effectiveFrom])
  @@map("revenue_partners")
}

// ─── Onboarding — цэцэрлэгтэй гэрээ байгуулах (docs/CONTRACT_ONBOARDING.md) ───

enum KindergartenApplicationStatus {
  /// Submitted, waiting for the platform operator to look at it.
  PENDING
  /// Accepted. A `Kindergarten` and a `Contract` exist from this moment.
  APPROVED
  /// Turned down. `reviewNote` says why; the applicant may submit again.
  REJECTED
}

enum ContractStatus {
  /// Generated, waiting for the kindergarten's signature and seal (steps 5–7).
  PENDING_SIGNATURE
  /// The signed scan is uploaded, waiting for the operator's check (step 7).
  SIGNED
  /// Countersigned and in force (step 8). The kindergarten may use the system.
  ACTIVE
  /// Ended or withdrawn. Never deleted — §3.2.
  CANCELLED
}

/// A kindergarten asking to join, before it is one.
///
/// ★★★ **This is the product's first unauthenticated write, and the separation
/// from `Kindergarten` is what makes it safe.**
///
/// `POST /v1/applications` is `@Public()`. If it created a `Kindergarten` row
/// directly, an anonymous request would be writing into the table every tenant
/// boundary in the system is keyed on. It writes here instead, and nothing
/// reads this table except a superadmin. A `Kindergarten` comes into existence
/// only in step 3, when a person has looked at the application and approved it.
///
/// ★ It asks for **nothing about a child**. An onboarding form is filled in by
/// a stranger over a public connection; the least it can carry, the better.
/// `childCount` is a number for pricing the contract, not a roster.
model KindergartenApplication {
  id String @id @default(uuid()) @db.Uuid

  /// The "Байгууллагын мэдээлэл" form, field for field.
  kindergartenName   String
  registrationNumber String
  address            String
  directorName       String
  phone              String
  email              String
  /// Children the kindergarten reports having — the contract's pricing base.
  childCount         Int

  note String?

  status KindergartenApplicationStatus @default(PENDING)

  /// Step 3's trail. `AuditLog` carries the same event; these are here so the
  /// review screen can show it without a second query.
  reviewedById String?   @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?

  /// Set when the application is approved and the tenant is created.
  kindergartenId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reviewedBy   User?         @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  kindergarten Kindergarten? @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  contract     Contract?

  @@index([status, createdAt(sort: Desc)])
  @@map("kindergarten_applications")
}

/// The agreement itself.
///
/// ★★★ **Every figure here is frozen at generation time and never read from a
/// tariff table again.**
///
/// A contract is a document two parties sign. If its amounts were resolved
/// from live settings, the day a price changed would silently rewrite the
/// content of every contract already printed, signed and sealed — the database
/// and the paper in the kindergarten's file would disagree, and the paper is
/// the one that is legally binding. This is exactly `FundingRule`'s rule that a
/// rate is never edited in place, for exactly the same reason.
///
/// ★ `version` is the "PDF version: v1.0" on the operator's own diagram. A
/// re-issued contract increments it rather than overwriting the previous PDF.
model Contract {
  id String @id @default(uuid()) @db.Uuid

  applicationId  String  @unique @db.Uuid
  /// Null only in the instant between the tenant being created and this row
  /// being written — in practice always set, inside the same transaction.
  kindergartenId String? @db.Uuid

  /// `NK-2026-000123`. Unique across the platform, not per tenant: it is the
  /// platform's own numbering and a kindergarten quotes it back to us.
  number  String @unique
  version Int    @default(1)

  status ContractStatus @default(PENDING_SIGNATURE)

  /// Frozen terms — see the note above.
  childCount         Int
  annualFee          Decimal @db.Decimal(12, 2)
  perChildMonthlyFee Decimal @db.Decimal(12, 2)

  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date

  /// The generated PDF (step 4) and, later, the signed scan (step 7).
  pdfMediaFileId    String? @unique @db.Uuid
  signedMediaFileId String? @unique @db.Uuid

  signedAt    DateTime?
  activatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application  KindergartenApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  pdf          MediaFile?              @relation("ContractPdf", fields: [pdfMediaFileId], references: [id], onDelete: SetNull)
  kindergarten Kindergarten?           @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@index([kindergartenId])
  @@map("contracts")
}

/// One group's register for one day, submitted — "Ирц илгээх".
///
/// ★ What "sent" means today, and what it will mean later.
///
/// The client asked for an Илгээх button and an Илгээсэн column, and the
/// eventual destination is ESIS. That transport does not exist yet:
/// `docs/ESIS_API_READINESS.md` §1 records that access is a contract
/// with the ministry rather than a signup, and §3 that even the login request's
/// field names are unconfirmed.
///
/// What *is* ours today is the act: a director declaring "this group's Tuesday
/// is final and has been submitted". That declaration is worth recording on its
/// own — it is who signed off a register and when, which is the first thing
/// asked when a figure is disputed — and it is exactly the row an ESIS call
/// will later hang off. So the submission is stored now and the transport is
/// added to it, rather than the button waiting for a contract.
///
/// ★★ A row per group per day, not a flag on `Attendance`.
///
/// The unit submitted is the day sheet, not a child: submitting "Дэлбээ, 3rd
/// March" is one act over twenty rows, and a flag on each would let nineteen of
/// them be sent and one not. It also gives the unsubmitted state a shape —
/// no row means not sent, which needs no backfill over every attendance record
/// ever written.
///
/// ★★★ `@@unique` is partial on `deletedAt`, matching `Attendance` itself: a
/// day whose submission was withdrawn and made again must not collide with the
/// soft-deleted row only the database still remembers.
model AttendanceSubmission {
  id             String   @id @default(uuid()) @db.Uuid
  kindergartenId String   @db.Uuid
  groupId        String   @db.Uuid
  date           DateTime @db.Date

  submittedById String   @db.Uuid
  submittedAt   DateTime @default(now())

  /// How many children the register covered when it was submitted.
  ///
  /// ★ Stored, not recomputed. A roster changes — a child transfers in next
  /// week — and "what was submitted" must not silently become a different
  /// number afterwards. The live figures stay on the screen; this is the
  /// snapshot the submission was made from.
  childCount Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kindergarten Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Restrict)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submittedBy  User         @relation("AttendanceSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([kindergartenId, date])
  @@index([groupId, date])
  @@map("attendance_submissions")
}
